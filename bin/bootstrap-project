class BootstrapError(RuntimeError):
    pass


@dataclass(frozen=True)
class WiringArtifact:
    source: Path
    destination: Path
    kind: str
    surface: str


@dataclass(frozen=True)
class BootstrapProfiles:
    project: str
    surfaces: str
    codex_policy: str

    @property
    def include_claude(self) -> bool:
        return self.surfaces == "all-surfaces"

    @property
    def surface_policy(self) -> dict[str, str]:
        if self.surfaces == "codex-only":
            return {
                "codex": "required",
                "claude": "optional",
                "legacy_mcp": "optional",
                "legacy_artifacts": "forbidden",
            }
        return {
            "codex": "required",
            "claude": "required",
            "legacy_mcp": "required",
            "legacy_artifacts": "forbidden",
        }

    @property
    def codex_settings(self) -> tuple[str, str]:
        if self.codex_policy == "trusted-automation":
            return "never", "danger-full-access"
        return "on-request", "workspace-write"


@dataclass(frozen=True)
class AdoptionDecision:
    action: str
    artifact: WiringArtifact
    reason: str


@dataclass(frozen=True)
class LocklessAdoptionPlan:
    platform: str
    backend: str
    path_mode: str
    profiles: BootstrapProfiles
    enforcement: str
    artifacts: list[WiringArtifact]
    decisions: list[AdoptionDecision]
    lock_payload: dict[str, object]
    fallback_proof: dict[str, object] | None = None

    @property
    def blocked(self) -> bool:
        return any(decision.action == "reject" for decision in self.decisions)


def normalize_profiles(args: argparse.Namespace) -> BootstrapProfiles:
    if args.profile and args.kind and args.profile != args.kind:
        raise BootstrapError(
            f"conflicting project profiles: --profile {args.profile} and legacy --kind {args.kind}"
        )
    return BootstrapProfiles(
        project=args.profile or args.kind or "generic",
        surfaces=args.surfaces,
        codex_policy=args.codex_policy,
    )


def run_git(root: Path, *args: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(root), *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "git command failed"
        raise BootstrapError(detail)
    return result.stdout.strip()


def canonical_public_source(changerail_root: Path) -> str:
    raw = run_git(changerail_root, "config", "--get", "remote.origin.url")
    if not raw:
        raise BootstrapError("locked bootstrap requires a public remote.origin.url")
    scp_match = re.fullmatch(r"(?:git@)?([A-Za-z0-9.-]+):([A-Za-z0-9._~/-]+)", raw)
    if scp_match:
        host, path = scp_match.groups()
        return f"https://{host}/{path.lstrip('/')}"
    parsed = urlsplit(raw)
    if parsed.scheme not in {"https", "ssh", "git"} or not parsed.hostname:
        raise BootstrapError("locked bootstrap requires an HTTPS, SSH or Git public source remote")
    if parsed.password or (parsed.username and parsed.username != "git"):
        raise BootstrapError("locked bootstrap source remote must not contain credentials")
    if parsed.query or parsed.fragment:
        raise BootstrapError("locked bootstrap source remote must not contain query or fragment data")
    path = parsed.path.lstrip("/")
    if not path or ".." in Path(path).parts:
        raise BootstrapError("locked bootstrap source remote has an invalid repository path")
    port = f":{parsed.port}" if parsed.port else ""
    return f"https://{parsed.hostname}{port}/{path}"


def locked_source_metadata(changerail_root: Path) -> dict[str, str]:
    top_level = Path(run_git(changerail_root, "rev-parse", "--show-toplevel")).resolve()
    if top_level != changerail_root.resolve():
        raise BootstrapError("locked ChangeRail root must be the Git repository root")
    dirty = run_git(changerail_root, "status", "--porcelain", "--untracked-files=no")
    if dirty:
        raise BootstrapError("locked bootstrap requires a clean tracked ChangeRail source")
    revision = run_git(changerail_root, "rev-parse", "HEAD")
    if not REVISION_RE.fullmatch(revision):
        raise BootstrapError("locked bootstrap requires an exact Git revision")
    try:
        version = (changerail_root / "VERSION").read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise BootstrapError(f"locked bootstrap cannot read ChangeRail VERSION: {exc}") from exc
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?", version):
        raise BootstrapError("locked bootstrap requires a semantic ChangeRail VERSION")
    return {
        "version": version,
        "revision": revision,
        "source": canonical_public_source(changerail_root),
    }


def repo_root_from_bin() -> Path:
    return Path(__file__).resolve().parents[1]


def skill_names(changerail_root: Path) -> list[str]:
    skills_root = changerail_root / "skills"
    return sorted(
        path.name
        for path in skills_root.iterdir()
        if path.is_dir() and (path / "SKILL.md").is_file()
    )


def detected_wiring_platform() -> str:
    return "windows" if os.name == "nt" else "posix"


def resolve_wiring_platform(value: str) -> str:
    return detected_wiring_platform() if value == "auto" else value


def resolve_wiring_backend(platform: str, value: str) -> str:
    if value == "auto":
        return "generated-copy" if platform == "windows" else "symlink"
    return value


def resolve_wiring_path_mode(platform: str, backend: str, requested: str | None) -> str:
    if requested is not None and (platform != "posix" or backend != "symlink"):
        raise BootstrapError(
            "--wiring-path-mode is supported only for the POSIX symlink backend"
        )
    if platform == "posix" and backend == "symlink":
        return requested or "absolute"
    return "not-applicable"


def helper_names(*, include_windows_helpers: bool, include_maintenance_helpers: bool) -> tuple[str, ...]:
    helpers = list(SUPPORTED_HELPERS)
    if include_maintenance_helpers:
        helpers.extend(MAINTENANCE_HELPERS)
    if include_windows_helpers:
        helpers.extend(WINDOWS_EXTRA_HELPERS)
    return tuple(dict.fromkeys(helpers))


def wiring_artifacts(
    changerail_root: Path,
    target: Path,
    *,
    include_windows_helpers: bool,
    include_maintenance_helpers: bool,
    include_claude_surface: bool = True,
) -> list[WiringArtifact]:
    artifacts: list[WiringArtifact] = []
    if include_claude_surface:
        artifacts.extend(
            [
                WiringArtifact(
                    changerail_root / "skills",
                    target / ".claude" / "skills",
                    "directory",
                    "claude-skills",
                ),
                WiringArtifact(
                    changerail_root / "claude" / "commands" / "changerail",
                    target / ".claude" / "commands" / "changerail",
                    "directory",
                    "claude-commands",
                ),
                WiringArtifact(
                    changerail_root / "claude" / "commands" / "chrl",
                    target / ".claude" / "commands" / "chrl",
                    "directory",
                    "claude-commands",
                ),
            ]
        )
    helpers = helper_names(
        include_windows_helpers=include_windows_helpers,
        include_maintenance_helpers=include_maintenance_helpers,
    )
    for helper in helpers:
        source = changerail_root / "bin" / helper
        artifacts.append(WiringArtifact(source, target / "bin" / helper, "file", "helper"))
        windows_source = source.with_name(f"{source.name}.cmd")
        if include_windows_helpers and windows_source.is_file():
            artifacts.append(WiringArtifact(windows_source, target / "bin" / windows_source.name, "file", "helper"))
    artifacts.extend(
        WiringArtifact(
            changerail_root / "skills" / skill,
            target / ".codex" / "skills" / skill,
            "directory",
            "codex-skill",
        )
        for skill in skill_names(changerail_root)
    )
    return artifacts


def consumer_lock_payload(
    *,
    changerail_root: Path,
    target: Path,
    platform: str,
    backend: str,
    path_mode: str,
    profiles: BootstrapProfiles,
    enforcement: str,
    include_maintenance_helpers: bool,
) -> dict[str, object] | None:
    if enforcement == "none":
        return None
    metadata = locked_source_metadata(changerail_root)
    artifacts = wiring_artifacts(
        changerail_root,
        target,
        include_windows_helpers=platform == "windows",
        include_maintenance_helpers=include_maintenance_helpers,
        include_claude_surface=profiles.include_claude,
    )
    artifact_kind = backend if backend in {"generated-copy", "junction"} else "symlink"
    return {
        "schema": CONSUMER_LOCK_SCHEMA,
        "changerail": metadata,
        "wiring": {
            "platform": platform,
            "backend": backend,
            "path_mode": path_mode,
            "artifacts": [
                {
                    "path": rel_to_root(artifact.destination, target),
                    "source": rel_to_root(artifact.source, changerail_root),
                    "kind": artifact_kind,
                    "surface": artifact.surface,
                }
                for artifact in artifacts
            ],
        },
        "profiles": {
            "project": profiles.project,
            "surfaces": profiles.surfaces,
            "codex_policy": profiles.codex_policy,
        },
        "enforcement": enforcement,
    }


def write_consumer_lock(target: Path, payload: dict[str, object] | None) -> None:
    if payload is None:
        return
    path = target / CONSUMER_LOCK_REL
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(payload, ensure_ascii=True, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )


def consumer_lock_missing_message() -> str:
    return (
        f"consumer lock missing at {CONSUMER_LOCK_REL}; plain --refresh-wiring "
        "is lock-owned only. Preview explicit migration with: "
        "bin/bootstrap-project <project> --configure-existing "
        "--adopt-lockless-wiring --dry-run"
    )


def require_consumer_lock(target: Path, changerail_root: Path) -> dict[str, object]:
    if not (target / CONSUMER_LOCK_REL).is_file():
        raise BootstrapError(consumer_lock_missing_message())
    return load_consumer_lock(target, changerail_root)


def render_text(
    text: str,
    *,
    project: Path,
    project_name: str,
    profiles: BootstrapProfiles,
    changerail_root: Path,
    config_mode: str,
) -> str:
    local_mode = config_mode == "local"
    project_config_scope = str(project) if local_mode else "."
    project_root_label = str(project) if local_mode else "this repository"
    changerail_root_label = str(changerail_root) if local_mode else "the linked ChangeRail source of truth"
    shared_source = str(changerail_root / "AGENTS.shared.md") if local_mode else "ChangeRail AGENTS.shared.md"
    surface_policy = profiles.surface_policy
    approval_policy, sandbox_mode = profiles.codex_settings
    topology_guidance = {
        "generic": "This repository uses neutral project ownership without domain-specific source generation.",
        "workspace-root": (
            "This repository has aggregator ownership; independent child repositories retain their own "
            "source, Git history and delivery boundaries."
        ),
        "service": (
            "This repository has single-repository delivery ownership; no application framework or "
            "deployment configuration is implied."
        ),
    }[profiles.project]
    authority_guidance = (
        "trusted-automation is an explicit operator choice with unattended full-access authority."
        if profiles.codex_policy == "trusted-automation"
        else "safe-interactive requires approval for commands and limits writes to the workspace."
    )
    replacements = {
        "{{PROJECT_PATH}}": str(project),
        "{{PROJECT_CONFIG_SCOPE}}": project_config_scope,
        "{{CODEX_PROJECT_KEY}}": project_config_scope,
        "{{PROJECT_ROOT_LABEL}}": project_root_label,
        "{{PROJECT_NAME}}": project_name,
        "{{PROJECT_KIND}}": profiles.project,
        "{{PROJECT_PROFILE}}": profiles.project,
        "{{SURFACES_PROFILE}}": profiles.surfaces,
        "{{CODEX_POLICY}}": profiles.codex_policy,
        "{{CODEX_APPROVAL_POLICY}}": approval_policy,
        "{{CODEX_SANDBOX_MODE}}": sandbox_mode,
        "{{CODEX_SURFACE_STATE}}": surface_policy["codex"],
        "{{CLAUDE_SURFACE_STATE}}": surface_policy["claude"],
        "{{LEGACY_MCP_SURFACE_STATE}}": surface_policy["legacy_mcp"],
        "{{LEGACY_ARTIFACTS_SURFACE_STATE}}": surface_policy["legacy_artifacts"],
        "{{TOPOLOGY_GUIDANCE}}": topology_guidance,
        "{{CODEX_AUTHORITY_GUIDANCE}}": authority_guidance,
        "{{CHANGERAIL_ROOT}}": str(changerail_root),
        "{{CHANGERAIL_ROOT_LABEL}}": changerail_root_label,
        "{{CHANGERAIL_SHARED_SOURCE}}": shared_source,
        "{{CHANGERAIL_SHARED_AGENTS}}": (changerail_root / "AGENTS.shared.md").read_text(encoding="utf-8"),
    }
    for token, value in replacements.items():
        text = text.replace(token, value)
    return text


def preflight_generated_instruction_budget(
    template_root: Path,
    target: Path,
    project_name: str,
    profiles: BootstrapProfiles,
    changerail_root: Path,
    config_mode: str,
) -> int:
    try:
        source = (template_root / "AGENTS.md.tpl").read_text(encoding="utf-8")
        rendered = render_text(
            source,
            project=target,
            project_name=project_name,
            profiles=profiles,
            changerail_root=changerail_root,
            config_mode=config_mode,
        )
    except OSError as exc:
        raise BootstrapError(f"cannot render AGENTS.md instruction preflight: {exc}") from exc
    measured = len(rendered.encode("utf-8"))
    if measured * 100 >= PROJECT_DOC_MAX_BYTES * PROJECT_DOC_GENERATED_TARGET_PERCENT:
        raise BootstrapError(
            f"generated AGENTS.md uses {measured}/{PROJECT_DOC_MAX_BYTES} UTF-8 bytes and reaches "
            f"the {PROJECT_DOC_GENERATED_TARGET_PERCENT}% generated-instruction target; "
            "reduce project/shared rules or "
            "review an explicit tracked budget change"
        )
    return measured


def output_path_for(rel: Path) -> Path | None:
    if rel == Path("README.md"):
        return None
    if rel in SPECIAL_OUTPUTS:
        return SPECIAL_OUTPUTS[rel]
    if rel.name.endswith(".tpl"):
        return rel.with_name(rel.name[: -len(".tpl")])
    return rel


def collect_plan(
    template_root: Path,
    target: Path,
    *,
    include_maintenance: bool,
    profiles: BootstrapProfiles,
    include_ci: bool = False,
    include_readme: bool = False,
) -> list[tuple[str, Path, Path | None]]:
    plan: list[tuple[str, Path, Path | None]] = []
    for source in sorted(template_root.rglob("*")):
        if source.is_dir():
            continue
        rel = source.relative_to(template_root)
        if rel.parts and rel.parts[0] == ".changerail" and not include_maintenance:
            continue
        if rel.parts[:2] == (".github", "workflows") and not include_ci:
            continue
        if rel == Path("consumer-README.md.tpl") and not include_readme:
            continue
        if rel == Path("CLAUDE.md.tpl") and not profiles.include_claude:
            continue
        out_rel = output_path_for(rel)
        if out_rel is None:
            continue
        plan.append(("render" if source.name.endswith(".tpl") else "copy", target / out_rel, source))
    return plan


def symlink_plan(
    changerail_root: Path,
    target: Path,
    *,
    include_maintenance_helpers: bool,
    include_claude_surface: bool = True,
) -> list[tuple[Path, Path]]:
    return [
        (artifact.source, artifact.destination)
        for artifact in wiring_artifacts(
            changerail_root,
            target,
            include_windows_helpers=False,
            include_maintenance_helpers=include_maintenance_helpers,
            include_claude_surface=include_claude_surface,
        )
    ]


def ensure_target(target: Path, *, backup_existing: bool, dry_run: bool) -> Path | None:
    if not target.exists():
        if not dry_run:
            target.mkdir(parents=True)
        return None
    if not target.is_dir():
        raise BootstrapError(f"target exists and is not a directory: {target}")
    if not any(target.iterdir()):
        return None
    if not backup_existing:
        raise BootstrapError(f"target exists and is not empty: {target}")

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup = target.with_name(f"{target.name}.backup-{stamp}-{secrets.token_hex(3)}")
    if backup.exists():
        raise BootstrapError(f"backup target already exists: {backup}")
    if not dry_run:
        shutil.move(str(target), str(backup))
        target.mkdir(parents=True)
    return backup


def write_templates(
    *,
    template_root: Path,
    target: Path,
    project_name: str,
    profiles: BootstrapProfiles,
    changerail_root: Path,
    config_mode: str,
    include_maintenance: bool,
    include_ci: bool = False,
    include_readme: bool = False,
) -> None:
    for action, destination, source in collect_plan(
        template_root,
        target,
        include_maintenance=include_maintenance,
        profiles=profiles,
        include_ci=include_ci,
        include_readme=include_readme,
    ):
        assert source is not None
        destination.parent.mkdir(parents=True, exist_ok=True)
        if action == "render":
            destination.write_text(
                render_text(
                    source.read_text(encoding="utf-8"),
                    project=target,
                    project_name=project_name,
                    profiles=profiles,
                    changerail_root=changerail_root,
                    config_mode=config_mode,
                ),
                encoding="utf-8",
            )
        else:
            shutil.copy2(source, destination)


def write_maintenance_index(target: Path) -> None:
    result = validate_catalog_and_policy(
        root=target,
        catalog_path=DEFAULT_CATALOG_PATH,
        policy_path=DEFAULT_POLICY_PATH,
    )
    require_valid_result(result)
    if result.catalog is None:
        raise BootstrapError("maintenance catalog did not load after template rendering")
    index_path = configured_index_path(target, result)
    rel_index = rel_to_root(index_path, target)
    content = render_index_content(
        result.catalog,
        catalog_path=result.catalog_path,
        policy_path=result.policy_path,
        index_path=rel_index,
    )
    atomic_write_text(index_path, content)


def create_symlink(target: Path, link_path: Path, *, path_mode: str = "relative") -> None:
    link_path.parent.mkdir(parents=True, exist_ok=True)
    if link_path.is_symlink() or link_path.exists():
        if link_path.is_dir() and not link_path.is_symlink():
            shutil.rmtree(link_path)
        else:
            link_path.unlink()
    link_target = str(target.resolve()) if path_mode == "absolute" else os.path.relpath(target, start=link_path.parent)
    os.symlink(link_target, link_path)


def create_symlinks(
    changerail_root: Path,
    target: Path,
    *,
    include_maintenance_helpers: bool,
    include_claude_surface: bool = True,
    path_mode: str = "relative",
) -> None:
    for source, link_path in symlink_plan(
        changerail_root,
        target,
        include_maintenance_helpers=include_maintenance_helpers,
        include_claude_surface=include_claude_surface,
    ):
        create_symlink(source, link_path, path_mode=path_mode)


def create_symlinks_with_rollback(
    changerail_root: Path,
    target: Path,
    created: list[Path],
    *,
    include_maintenance_helpers: bool,
    include_claude_surface: bool = True,
    path_mode: str = "relative",
) -> None:
    count = 0
    for source, link_path in symlink_plan(
        changerail_root,
        target,
        include_maintenance_helpers=include_maintenance_helpers,
        include_claude_surface=include_claude_surface,
    ):
        destination_existed = link_path.exists() or link_path.is_symlink()
        create_symlink(source, link_path, path_mode=path_mode)
        if not destination_existed:
            created.append(link_path)
        count += 1
        maybe_fail_after_artifact(count)


def remove_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def remove_created_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink(missing_ok=True)
    elif path.is_dir():
        shutil.rmtree(path)


def digest_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return f"sha256:{digest.hexdigest()}"


def digest_path(path: Path) -> str:
    if path.is_file() or path.is_symlink():
        return digest_file(path)
    if not path.is_dir():
        raise BootstrapError(f"cannot digest unsupported wiring source: {path}")
    digest = hashlib.sha256()
    for candidate in sorted(path.rglob("*")):
        if not (candidate.is_file() or candidate.is_symlink()):
            continue
        rel = candidate.relative_to(path).as_posix()
        digest.update(b"file\0")
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        digest.update(digest_file(candidate).encode("ascii"))
        digest.update(b"\0")
    return f"sha256:{digest.hexdigest()}"


def rel_to_root(path: Path, root: Path) -> str:
    return Path(os.path.abspath(path)).relative_to(Path(os.path.abspath(root))).as_posix()


def generated_artifact_entry(
    artifact: WiringArtifact,
    *,
    target: Path,
    changerail_root: Path,
    owner: str = "generated",
) -> dict[str, str]:
    return {
        "path": rel_to_root(artifact.destination, target),
        "kind": artifact.kind,
        "surface": artifact.surface,
        "source": rel_to_root(artifact.source, changerail_root),
        "digest": digest_path(artifact.source),
        "owner": owner,
    }


def fallback_artifact_entry(
    artifact: WiringArtifact,
    *,
    target: Path,
    changerail_root: Path,
    owner: str,
) -> dict[str, str]:
    entry = generated_artifact_entry(
        artifact,
        target=target,
        changerail_root=changerail_root,
        owner=owner,
    )
    if owner != "generated":
        entry.pop("digest", None)
    return entry


def write_wiring_manifest(
    *,
    target: Path,
    changerail_root: Path,
    platform: str,
    backend: str,
    artifacts: list[WiringArtifact],
    fallback_reasons: list[str],
    fallback_proof: dict[str, object] | None = None,
    artifact_owner: str = "generated",
) -> None:
    manifest = {
        "schema": WIRING_MANIFEST_SCHEMA,
        "backend": backend,
        "platform": platform,
        "source_root": "the linked ChangeRail source of truth",
        "artifacts": [
            fallback_artifact_entry(
                artifact,
                target=target,
                changerail_root=changerail_root,
                owner=artifact_owner,
            )
            for artifact in artifacts
        ],
        "fallback_reasons": fallback_reasons,
    }
    if fallback_proof:
        manifest["fallback_proof"] = fallback_proof
    path = target / WIRING_MANIFEST_REL
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(manifest, ensure_ascii=True, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def copy_generated_artifact(artifact: WiringArtifact, created: list[Path]) -> None:
    if not artifact.source.exists():
        raise BootstrapError(f"wiring source missing: {artifact.source}")
    destination_existed = artifact.destination.exists() or artifact.destination.is_symlink()
    if destination_existed:
        remove_path(artifact.destination)
    artifact.destination.parent.mkdir(parents=True, exist_ok=True)
    if artifact.kind == "directory":
        shutil.copytree(artifact.source, artifact.destination, symlinks=True)
    else:
        shutil.copy2(artifact.source, artifact.destination)
    if not destination_existed:
        created.append(artifact.destination)


def cleanup_created_artifacts(created: list[Path]) -> None:
    for path in reversed(created):
        remove_created_path(path)


def generated_fallback_reasons(platform: str, backend: str) -> list[str]:
    if platform != "windows" or backend != "generated-copy":
        return []
    return [
        "symlink fallback skipped: explicit operator opt-in and positive Developer Mode or privilege proof were not supplied",
        "junction fallback skipped: explicit operator opt-in, link-aware cleanup proof and Git-safety proof were not supplied",
    ]


def maybe_fail_after_artifact(count: int) -> None:
    raw_limit = os.environ.get("CHANGERAIL_BOOTSTRAP_FAIL_AFTER_ARTIFACTS")
    if not raw_limit:
        return
    try:
        limit = int(raw_limit)
    except ValueError as exc:
        raise BootstrapError("CHANGERAIL_BOOTSTRAP_FAIL_AFTER_ARTIFACTS must be an integer") from exc
    if limit > 0 and count >= limit:
        raise BootstrapError("simulated wiring failure after generated artifact creation")


def create_generated_wiring(
    changerail_root: Path,
    target: Path,
    *,
    platform: str,
    backend: str,
    include_maintenance_helpers: bool,
    include_claude_surface: bool = True,
) -> None:
    artifacts = wiring_artifacts(
        changerail_root,
        target,
        include_windows_helpers=platform == "windows",
        include_maintenance_helpers=include_maintenance_helpers,
        include_claude_surface=include_claude_surface,
    )
    created: list[Path] = []
    count = 0
    try:
        for artifact in artifacts:
            copy_generated_artifact(artifact, created)
            count += 1
            maybe_fail_after_artifact(count)
        write_wiring_manifest(
            target=target,
            changerail_root=changerail_root,
            platform=platform,
            backend=backend,
            artifacts=artifacts,
            fallback_reasons=generated_fallback_reasons(platform, backend),
        )
    except Exception:
        cleanup_created_artifacts(created)
        raise


def load_wiring_manifest(target: Path) -> dict[str, object]:
    path = target / WIRING_MANIFEST_REL
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise BootstrapError(f"wiring manifest cannot be read: {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise BootstrapError(f"wiring manifest is invalid JSON: {path}: {exc}") from exc
    if not isinstance(data, dict) or data.get("schema") != WIRING_MANIFEST_SCHEMA:
        raise BootstrapError(f"wiring manifest has unsupported schema: {path}")
    return data


def load_consumer_lock(target: Path, changerail_root: Path) -> dict[str, object]:
    path = target / CONSUMER_LOCK_REL
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        schema = json.loads(
            (changerail_root / "schemas" / "changerail-consumer-lock.schema.json").read_text(
                encoding="utf-8"
            )
        )
        errors = list(jsonschema.Draft202012Validator(schema).iter_errors(data))
    except (OSError, json.JSONDecodeError, jsonschema.SchemaError) as exc:
        raise BootstrapError(f"cannot load consumer lock: {exc}") from exc
    if errors:
        raise BootstrapError("consumer lock failed schema validation")
    if not isinstance(data, dict) or data.get("schema") != CONSUMER_LOCK_SCHEMA:
        raise BootstrapError("unsupported consumer lock schema")
    return data


def project_dirty_paths(target: Path) -> list[str]:
    probe = subprocess.run(
        ["git", "-C", str(target), "rev-parse", "--show-toplevel"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if probe.returncode != 0 or Path(probe.stdout.strip()).resolve() != target.resolve():
        return []
    result = subprocess.run(
        ["git", "-C", str(target), "status", "--porcelain", "--untracked-files=all"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        raise BootstrapError("cannot inspect consumer Git status before wiring refresh")
    paths: list[str] = []
    for line in result.stdout.splitlines():
        if len(line) < 4:
            continue
        path = line[3:]
        if " -> " in path:
            paths.extend(path.split(" -> ", 1))
        else:
            paths.append(path)
    return paths


def parent_chain_has_symlink(target: Path, rel_path: Path) -> bool:
    current = target
    for part in rel_path.parts[:-1]:
        current = current / part
        if current.is_symlink():
            return True
    return False


def plan_consumer_wiring_refresh(
    changerail_root: Path,
    target: Path,
    lock: dict[str, object],
) -> tuple[list[tuple[Path, Path]], str]:
    wiring = lock.get("wiring")
    metadata = lock.get("changerail")
    if not isinstance(wiring, dict) or not isinstance(metadata, dict):
        raise BootstrapError("consumer lock is incomplete")
    if wiring.get("backend") != "symlink":
        raise BootstrapError("consumer lock refresh supports symlink backend only")
    path_mode = wiring.get("path_mode")
    if path_mode not in {"absolute", "relative"}:
        raise BootstrapError("consumer lock has unsupported symlink path mode")
    revision = run_git(changerail_root, "rev-parse", "HEAD")
    if revision != metadata.get("revision"):
        raise BootstrapError("ChangeRail source revision does not match consumer lock")
    version = (changerail_root / "VERSION").read_text(encoding="utf-8").strip()
    if version != metadata.get("version"):
        raise BootstrapError("ChangeRail version does not match consumer lock")
    artifacts = wiring.get("artifacts")
    if not isinstance(artifacts, list):
        raise BootstrapError("consumer lock artifacts must be an array")

    planned: list[tuple[Path, Path]] = []
    owned_paths: set[str] = set()
    target_root = target.resolve()
    source_root = changerail_root.resolve()
    for entry in artifacts:
        if not isinstance(entry, dict):
            raise BootstrapError("consumer lock artifact entry must be an object")
        rel_value = entry.get("path")
        source_value = entry.get("source")
        if not isinstance(rel_value, str) or not isinstance(source_value, str):
            raise BootstrapError("consumer lock artifact entry is incomplete")
        rel_path = Path(rel_value)
        source_rel = Path(source_value)
        destination = target / rel_path
        source = changerail_root / source_rel
        try:
            destination.parent.resolve(strict=False).relative_to(target_root)
            source.resolve(strict=False).relative_to(source_root)
        except ValueError as exc:
            raise BootstrapError("consumer lock wiring scope escape") from exc
        if parent_chain_has_symlink(target, rel_path):
            raise BootstrapError(f"refusing wiring refresh through symlink parent: {rel_value}")
        if (destination.exists() or destination.is_symlink()) and not destination.is_symlink():
            raise BootstrapError(f"refusing to replace project-owned wiring path: {rel_value}")
        if not source.exists():
            raise BootstrapError(f"consumer lock source is missing for: {rel_value}")
        owned_paths.add(rel_path.as_posix())
        planned.append((source, destination))

    unrelated = [path for path in project_dirty_paths(target) if path not in owned_paths]
    if unrelated:
        raise BootstrapError(
            "refusing wiring refresh with unrelated dirty state: "
            + ", ".join(sorted(unrelated)[:8])
        )
    return planned, str(path_mode)


def apply_consumer_wiring_refresh(
    planned: list[tuple[Path, Path]],
    path_mode: str,
) -> None:
    for source, destination in planned:
        create_symlink(source, destination, path_mode=path_mode)


def refresh_consumer_wiring(
    changerail_root: Path,
    target: Path,
    lock: dict[str, object],
) -> None:
    planned, path_mode = plan_consumer_wiring_refresh(changerail_root, target, lock)
    apply_consumer_wiring_refresh(planned, path_mode)


def manifest_artifact(manifest: dict[str, object] | None, rel_path: str) -> dict[str, object] | None:
    artifacts = manifest.get("artifacts") if manifest else None
    if not isinstance(artifacts, list):
        return None
    return next((entry for entry in artifacts if isinstance(entry, dict) and entry.get("path") == rel_path), None)


def source_root_from_resolved(resolved: Path, source_rel: Path) -> Path | None:
    rel_parts = source_rel.parts
    if not rel_parts or len(resolved.parts) < len(rel_parts) or resolved.parts[-len(rel_parts) :] != rel_parts:
        return None
    root_parts = resolved.parts[: -len(rel_parts)]
    return Path(*root_parts) if root_parts else Path(resolved.anchor or ".")


def generated_copy_decision(artifact: WiringArtifact, changerail_root: Path, target: Path, manifest: dict[str, object] | None) -> AdoptionDecision:
    rel_path = rel_to_root(artifact.destination, target)
    if not artifact.destination.exists() and not artifact.destination.is_symlink():
        return AdoptionDecision("add", artifact, "missing generated-owned wiring will be added")
    if artifact.destination.is_symlink():
        return AdoptionDecision("reject", artifact, "symlink cannot prove generated-copy ownership")
    if (artifact.kind == "directory" and not artifact.destination.is_dir()) or (artifact.kind == "file" and not artifact.destination.is_file()):
        return AdoptionDecision("reject", artifact, "generated destination has incompatible type")
    entry = manifest_artifact(manifest, rel_path)
    source_rel = rel_to_root(artifact.source, changerail_root)
    if not entry or entry.get("owner") != "generated" or entry.get("source") != source_rel or not isinstance(entry.get("digest"), str):
        return AdoptionDecision("reject", artifact, "missing or invalid generated ownership metadata")
    try:
        destination_digest = digest_path(artifact.destination)
        source_digest = digest_path(artifact.source)
    except OSError:
        return AdoptionDecision("reject", artifact, "generated digest cannot be computed")
    if destination_digest != entry["digest"] and destination_digest != source_digest:
        return AdoptionDecision("reject", artifact, "project-owned generated divergence")
    return AdoptionDecision("keep", artifact, "generated ownership metadata proves the artifact")


def plan_lockless_wiring_adoption(*, changerail_root: Path, target: Path, platform: str, backend: str, profiles: BootstrapProfiles, enforcement: str, fallback_proof: dict[str, object] | None) -> LocklessAdoptionPlan:
    if enforcement == "none":
        raise BootstrapError("--adopt-lockless-wiring requires advisory or strict --lock-enforcement")
    if (target / CONSUMER_LOCK_REL).is_file():
        raise BootstrapError("consumer lock already exists; use --refresh-wiring for lock-owned repair")

    artifacts = wiring_artifacts(changerail_root, target, include_windows_helpers=platform == "windows", include_maintenance_helpers=False, include_claude_surface=profiles.include_claude)
    if backend == "generated-copy":
        if platform != "windows":
            raise BootstrapError("generated-copy lockless adoption is a Windows platform policy")
        if not (target / WIRING_MANIFEST_REL).is_file():
            raise BootstrapError("Windows generated-copy adoption requires openspec/changerail-wiring.json metadata")
    manifest = load_wiring_manifest(target) if (target / WIRING_MANIFEST_REL).is_file() else None
    decisions: list[AdoptionDecision] = []
    path_modes: set[str] = set()
    source_roots: set[Path] = set()
    source_root = changerail_root.resolve(strict=False)

    if backend == "junction":
        raise BootstrapError("lockless adoption cannot infer Windows junction ownership; regenerate or use generated-copy metadata")
    if backend == "symlink" and platform == "windows" and fallback_proof is None:
        raise BootstrapError("Windows symlink adoption requires explicit --windows-fallback-proof")
    if backend == "generated-copy" and (not manifest or manifest.get("backend") != "generated-copy"):
        raise BootstrapError("generated-copy adoption requires a generated-copy wiring manifest")

    for artifact in artifacts:
        rel_path = Path(rel_to_root(artifact.destination, target))
        if parent_chain_has_symlink(target, rel_path):
            decisions.append(AdoptionDecision("reject", artifact, "symlink parent escapes owned wiring path"))
        elif not artifact.source.exists():
            decisions.append(AdoptionDecision("reject", artifact, "ChangeRail source artifact is missing"))
        elif backend == "generated-copy":
            decisions.append(generated_copy_decision(artifact, changerail_root, target, manifest))
        elif not artifact.destination.exists() and not artifact.destination.is_symlink():
            decisions.append(AdoptionDecision("add", artifact, "missing allowlisted wiring will be added"))
        elif not artifact.destination.is_symlink():
            decisions.append(AdoptionDecision("reject", artifact, "project-owned non-symlink content"))
        else:
            path_modes.add("absolute" if Path(os.readlink(artifact.destination)).is_absolute() else "relative")
            try:
                resolved = artifact.destination.resolve(strict=True)
            except OSError:
                decisions.append(AdoptionDecision("reject", artifact, "dangling symlink"))
                continue
            root = source_root_from_resolved(resolved, Path(rel_to_root(artifact.source, changerail_root)))
            normalized = root.resolve(strict=False) if root else None
            if normalized is None:
                decisions.append(AdoptionDecision("reject", artifact, "undeclared symlink target"))
            elif normalized != source_root:
                source_roots.add(normalized)
                decisions.append(AdoptionDecision("reject", artifact, "mixed ChangeRail source root"))
            else:
                source_roots.add(normalized)
                decisions.append(AdoptionDecision("keep", artifact, "existing symlink matches the selected ChangeRail root"))

    if backend == "symlink":
        if len(source_roots) > 1:
            decisions.append(AdoptionDecision("reject", artifacts[0], "mixed ChangeRail source roots"))
        if len(path_modes) > 1:
            decisions.append(AdoptionDecision("reject", artifacts[0], "mixed POSIX symlink path modes"))
        path_mode = next(iter(path_modes)) if len(path_modes) == 1 else "absolute"
    else:
        path_mode = "not-applicable"
    if not any(decision.action == "keep" for decision in decisions):
        decisions.append(AdoptionDecision("reject", artifacts[0], f"no existing allowlisted {backend} wiring to adopt"))

    owned_paths = {
        rel_to_root(decision.artifact.destination, target)
        for decision in decisions
        if decision.action in {"keep", "add"}
    }
    owned_paths.add(CONSUMER_LOCK_REL.as_posix())
    if backend == "generated-copy" or (platform == "windows" and fallback_proof is not None):
        owned_paths.add(WIRING_MANIFEST_REL.as_posix())
    unrelated = [path for path in project_dirty_paths(target) if path not in owned_paths]
    if unrelated:
        decisions.append(AdoptionDecision("reject", artifacts[0], "unrelated dirty state: " + ", ".join(sorted(unrelated)[:8])))

    lock_payload = consumer_lock_payload(changerail_root=changerail_root, target=target, platform=platform, backend=backend, path_mode=path_mode, profiles=profiles, enforcement=enforcement, include_maintenance_helpers=False)
    if lock_payload is None:
        raise BootstrapError("lockless adoption could not build a consumer lock")
    return LocklessAdoptionPlan(platform=platform, backend=backend, path_mode=path_mode, profiles=profiles, enforcement=enforcement, artifacts=artifacts, decisions=decisions, lock_payload=lock_payload, fallback_proof=fallback_proof)


def print_lockless_adoption_plan(plan: LocklessAdoptionPlan, *, target: Path, changerail_root: Path) -> None:
    print("PLAN configure-existing")
    print("PLAN adopt-lockless-wiring")
    print(f"PLAN wiring-platform {plan.platform}")
    print(f"PLAN wiring-backend {plan.backend}")
    print(f"PLAN wiring-path-mode {plan.path_mode}")
    print(f"PLAN lock-enforcement {plan.enforcement}")
    metadata = plan.lock_payload.get("changerail", {})
    if isinstance(metadata, dict):
        print(f"PLAN source {metadata.get('source', 'unknown')}")
        print(f"PLAN source-revision {metadata.get('revision', 'unknown')}")
    print(f"PLAN consumer-lock {CONSUMER_LOCK_REL}")
    if plan.backend == "generated-copy" or (plan.platform == "windows" and plan.fallback_proof is not None):
        print(f"PLAN generated-manifest {WIRING_MANIFEST_REL}")
    for line in adoption_plan_lines(plan, target, changerail_root):
        print(line)


def adoption_plan_lines(plan: LocklessAdoptionPlan, target: Path, changerail_root: Path) -> list[str]:
    lines: list[str] = []
    for decision in plan.decisions:
        destination = rel_to_root(decision.artifact.destination, target)
        source = rel_to_root(decision.artifact.source, changerail_root)
        lines.append(f"PLAN {decision.action} {plan.backend} {destination} <- {source}: {decision.reason}")
    return lines


def apply_lockless_adoption(plan: LocklessAdoptionPlan, *, changerail_root: Path, target: Path) -> None:
    if plan.blocked:
        blockers = [f"{rel_to_root(decision.artifact.destination, target)}: {decision.reason}" for decision in plan.decisions if decision.action == "reject"]
        raise BootstrapError("lockless adoption blocked: " + "; ".join(blockers[:8]))

    created: list[Path] = []
    snapshots: dict[Path, bytes | None] = {}

    try:
        count = 0
        for decision in plan.decisions:
            if decision.action != "add":
                continue
            if plan.backend == "symlink":
                create_symlink(decision.artifact.source, decision.artifact.destination, path_mode=plan.path_mode)
                created.append(decision.artifact.destination)
            elif plan.backend == "generated-copy":
                copy_generated_artifact(decision.artifact, created)
            else:
                raise BootstrapError(f"unsupported adoption backend: {plan.backend}")
            count += 1
            maybe_fail_after_artifact(count)

        manifest_path = target / WIRING_MANIFEST_REL
        if plan.backend == "generated-copy":
            snapshots.setdefault(manifest_path, manifest_path.read_bytes() if manifest_path.is_file() else None)
            write_wiring_manifest(target=target, changerail_root=changerail_root, platform=plan.platform, backend=plan.backend, artifacts=plan.artifacts, fallback_reasons=generated_fallback_reasons(plan.platform, plan.backend))
        elif plan.platform == "windows" and plan.fallback_proof is not None:
            snapshots.setdefault(manifest_path, manifest_path.read_bytes() if manifest_path.is_file() else None)
            write_wiring_manifest(target=target, changerail_root=changerail_root, platform=plan.platform, backend=plan.backend, artifacts=plan.artifacts, fallback_reasons=[], fallback_proof=plan.fallback_proof, artifact_owner=plan.backend)

        lock_path = target / CONSUMER_LOCK_REL
        snapshots.setdefault(lock_path, lock_path.read_bytes() if lock_path.is_file() else None)
        write_consumer_lock(target, plan.lock_payload)
    except Exception:
        cleanup_created_artifacts(created)
        for path, content in snapshots.items():
            if content is None:
                path.unlink(missing_ok=True)
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(content)
        raise


def load_fallback_proof(path: Path) -> dict[str, object]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise BootstrapError(f"Windows fallback proof cannot be read: {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise BootstrapError(f"Windows fallback proof is invalid JSON: {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise BootstrapError("Windows fallback proof must be a JSON object")
    return data


def proof_checks(proof: dict[str, object]) -> dict[str, dict[str, object]]:
    result: dict[str, dict[str, object]] = {}
    checks = proof.get("checks")
    if not isinstance(checks, list):
        return result
    for check in checks:
        if not isinstance(check, dict):
            continue
        name = check.get("name")
        if isinstance(name, str) and name:
            result[name] = check
    return result


def proof_value_is_non_empty_string(value: object) -> bool:
    return isinstance(value, str) and bool(value.strip())


def proof_evidence_is_concrete(evidence: object) -> bool:
    if not isinstance(evidence, dict):
        return False
    if any(
        proof_value_is_non_empty_string(evidence.get(field))
        for field in ("command", "operation", "raw_output_path")
    ):
        return True
    argv = evidence.get("command_argv")
    return isinstance(argv, list) and any(proof_value_is_non_empty_string(item) for item in argv)


def proof_check_has_concrete_evidence(check: dict[str, object]) -> bool:
    if check.get("status") not in PROOF_STATUS_PASS:
        return False
    if not proof_value_is_non_empty_string(check.get("category")):
        return False
    if not proof_value_is_non_empty_string(check.get("message")):
        return False
    details = check.get("details")
    if not isinstance(details, dict) or not details:
        return False
    return proof_evidence_is_concrete(check.get("evidence"))


def git_safety_proof_error(name: str, check: dict[str, object]) -> str | None:
    if name not in GIT_SAFETY_PROOF_NAMES:
        return None
    details = check.get("details")
    if not isinstance(details, dict):
        return f"{name} missing Git safety details"
    if details.get("safe") is not True:
        if details.get("safe") is False:
            return f"{name} reports unsafe Git staging evidence"
        return f"{name} missing positive Git safety classification"
    if "unsafe_paths" not in details:
        return f"{name} missing unsafe_paths Git safety classification"
    unsafe_paths = details.get("unsafe_paths")
    if not isinstance(unsafe_paths, list):
        return f"{name} unsafe_paths must be an array"
    unsafe = [path for path in unsafe_paths if isinstance(path, str) and path.strip()]
    if unsafe:
        return f"{name} reports unsafe Git staging paths: {unsafe_git_path_summary(unsafe)}"
    return None


def unsafe_git_path_summary(paths: list[str]) -> str:
    counts: dict[str, int] = {}
    for path in paths:
        label = unsafe_git_path_label(path)
        counts[label] = counts.get(label, 0) + 1
    categories = ", ".join(f"{label}={count}" for label, count in sorted(counts.items()))
    return f"{len(paths)} path(s) ({categories})"


def unsafe_git_path_label(path: str) -> str:
    normalized = path.replace("\\", "/").lower()
    for label, markers in UNSAFE_GIT_PATH_MARKERS:
        if any(marker in normalized for marker in markers):
            return label
    if len(normalized) >= 3 and normalized[1] == ":" and normalized[2] == "/":
        return "absolute-windows-path"
    if normalized.startswith("/"):
        return "absolute-path"
    return "project-path"


def validate_proof_source(proof: dict[str, object], label: str) -> None:
    source = proof.get("source")
    if not isinstance(source, dict):
        raise BootstrapError(f"{label} proof missing source metadata")
    kind = source.get("kind")
    tool = source.get("tool")
    if not proof_value_is_non_empty_string(kind) or not proof_value_is_non_empty_string(tool):
        raise BootstrapError(f"{label} proof source must include kind and tool")
    if str(kind) in {"sample", "dry-run", "status-only"}:
        raise BootstrapError(f"{label} proof source {kind!r} is not concrete evidence")


def validate_proof_groups(proof: dict[str, object], groups: tuple[tuple[str, ...], ...], label: str) -> None:
    checks = proof_checks(proof)
    missing = [
        aliases[0]
        for aliases in groups
        if not any(
            alias in checks and proof_check_has_concrete_evidence(checks[alias])
            for alias in aliases
        )
    ]
    if missing:
        raise BootstrapError(f"{label} proof missing concrete passed evidence: {', '.join(missing)}")
    git_errors = [
        error
        for name, check in checks.items()
        for error in [git_safety_proof_error(name, check)]
        if error
    ]
    if git_errors:
        raise BootstrapError(f"{label} proof unsafe Git evidence: {'; '.join(git_errors)}")


def normalize_runtime_wiring_report(report: dict[str, object], backend: str) -> dict[str, object]:
    if report.get("mode") != "live":
        raise BootstrapError("Windows fallback proof runtime report must be a live probe report")
    hosts = report.get("hosts")
    if not isinstance(hosts, list) or not hosts:
        raise BootstrapError("Windows fallback proof runtime report has no host results")
    errors: list[str] = []
    groups = SYMLINK_PROOF_GROUPS if backend == "symlink" else JUNCTION_PROOF_GROUPS
    for host in hosts:
        if not isinstance(host, dict):
            continue
        host_id = host.get("id")
        host_evidence = host.get("evidence")
        if host.get("status") != "passed":
            errors.append(f"{host_id or 'unknown host'} did not pass")
            continue
        if not isinstance(host_evidence, dict) or not proof_value_is_non_empty_string(host_evidence.get("raw_output_path")):
            errors.append(f"{host_id or 'unknown host'} missing raw output evidence")
            continue
        normalized_checks: list[dict[str, object]] = []
        for check in host.get("checks", []):
            if not isinstance(check, dict):
                continue
            name = check.get("name")
            if not proof_value_is_non_empty_string(name):
                continue
            details = check.get("details")
            normalized_checks.append(
                {
                    "name": name,
                    "category": check.get("category") if proof_value_is_non_empty_string(check.get("category")) else "runtime-probe",
                    "status": check.get("status"),
                    "message": check.get("message") if proof_value_is_non_empty_string(check.get("message")) else "runtime probe check",
                    "details": details if isinstance(details, dict) and details else {"host_id": host_id or "unknown"},
                    "evidence": {
                        "raw_output_path": host_evidence["raw_output_path"],
                        "started_at": host_evidence.get("started_at", ""),
                        "duration_seconds": host_evidence.get("duration_seconds", ""),
                        "source_schema": WINDOWS_RUNTIME_WIRING_REPORT_SCHEMA,
                    },
                }
            )
        if backend == "junction" and host.get("cleanup") in PROOF_STATUS_PASS:
            normalized_checks.append(
                {
                    "name": "link_aware_cleanup",
                    "category": "cleanup",
                    "status": "passed",
                    "message": "runtime probe cleanup removed link paths without traversing targets",
                    "details": {"cleanup": host.get("cleanup"), "host_id": host_id or "unknown"},
                    "evidence": {
                        "raw_output_path": host_evidence["raw_output_path"],
                        "source_schema": WINDOWS_RUNTIME_WIRING_REPORT_SCHEMA,
                    },
                }
            )
        normalized = {
            "schema": FALLBACK_PROOF_SCHEMA,
            "mode": backend,
            "source": {
                "kind": "windows-runtime-wiring-report",
                "tool": "scripts/windows-runtime-wiring-probe.py",
                "host_id": host_id or "unknown",
            },
            "checks": normalized_checks,
        }
        try:
            validate_proof_groups(normalized, groups, f"Windows {backend} fallback")
        except BootstrapError as exc:
            errors.append(f"{host_id or 'unknown host'}: {exc}")
            continue
        return normalized
    raise BootstrapError("Windows fallback proof runtime report lacks a passing host: " + "; ".join(errors))


def normalize_fallback_proof(proof: dict[str, object], backend: str) -> dict[str, object]:
    schema = proof.get("schema")
    if schema == WINDOWS_RUNTIME_WIRING_REPORT_SCHEMA:
        return normalize_runtime_wiring_report(proof, backend)
    if schema != FALLBACK_PROOF_SCHEMA:
        raise BootstrapError(f"Windows fallback proof has unsupported schema: {schema!r}")
    if proof.get("mode") != backend:
        raise BootstrapError(f"Windows fallback proof mode {proof.get('mode')!r} does not match backend {backend!r}")
    validate_proof_source(proof, f"Windows {backend} fallback")
    if backend == "symlink":
        validate_proof_groups(proof, SYMLINK_PROOF_GROUPS, "Windows symlink fallback")
    elif backend == "junction":
        validate_proof_groups(proof, JUNCTION_PROOF_GROUPS, "Windows junction fallback")
    else:
        raise BootstrapError(f"unsupported fallback proof backend: {backend}")
    return proof


def native_symlink_probe(target: Path) -> dict[str, object]:
    del target
    checks: list[dict[str, object]] = []
    try:
        with tempfile.TemporaryDirectory(prefix="changerail-windows-symlink-proof-") as temp:
            probe_root = Path(temp)
            source_dir = probe_root / "source-dir"
            source_file = probe_root / "source-file.txt"
            directory_link = probe_root / "directory-link"
            file_link = probe_root / "file-link.txt"
            source_dir.mkdir()
            source_file.write_text("probe\n", encoding="utf-8")
            os.symlink(source_dir, directory_link, target_is_directory=True)
            checks.append(
                {
                    "name": "direct_os_symlink_directory",
                    "category": "filesystem",
                    "status": "passed",
                    "message": "native os.symlink created a directory link",
                    "details": {"link_type": "directory", "os_name": os.name},
                    "evidence": {
                        "operation": "os.symlink",
                        "target_is_directory": True,
                        "result": "created-and-removed",
                    },
                }
            )
            os.symlink(source_file, file_link, target_is_directory=False)
            checks.append(
                {
                    "name": "direct_os_symlink_file",
                    "category": "filesystem",
                    "status": "passed",
                    "message": "native os.symlink created a file link",
                    "details": {"link_type": "file", "os_name": os.name},
                    "evidence": {
                        "operation": "os.symlink",
                        "target_is_directory": False,
                        "result": "created-and-removed",
                    },
                }
            )
            checks.append(
                {
                    "name": "symlink_privilege_or_developer_mode",
                    "category": "filesystem",
                    "status": "passed",
                    "message": "native host proved symlink creation capability",
                    "details": {"directory_link": "passed", "file_link": "passed", "os_name": os.name},
                    "evidence": {
                        "operation": "os.symlink",
                        "result": "directory-and-file-symlink-capability-proved",
                    },
                }
            )
    except OSError as exc:
        raise BootstrapError(f"Windows symlink fallback proof failed: {exc}") from exc
    return {
        "schema": FALLBACK_PROOF_SCHEMA,
        "mode": "symlink",
        "source": {"kind": "native-probe", "tool": "bin/bootstrap-project"},
        "checks": checks,
    }


def validate_fallback_proof_file(path: Path, backend: str) -> dict[str, object]:
    proof = load_fallback_proof(path)
    return normalize_fallback_proof(proof, backend)


def refresh_generated_wiring(changerail_root: Path, target: Path) -> None:
    manifest = load_wiring_manifest(target)
    backend = manifest.get("backend")
    if backend != "generated-copy":
        raise BootstrapError(f"refresh supports generated-copy backend only, got {backend!r}")
    platform = str(manifest.get("platform") or "windows")
    entries = manifest.get("artifacts")
    if not isinstance(entries, list):
        raise BootstrapError("wiring manifest artifacts must be an array")
    refreshed: list[dict[str, str]] = []
    for entry in entries:
        if not isinstance(entry, dict):
            raise BootstrapError("wiring manifest artifact entries must be objects")
        if entry.get("owner") != "generated":
            raise BootstrapError(f"refusing to refresh project-owned wiring path: {entry.get('path')}")
        rel_path = entry.get("path")
        source_rel = entry.get("source")
        kind = entry.get("kind")
        recorded_digest = entry.get("digest")
        if not all(isinstance(value, str) and value for value in (rel_path, source_rel, kind, recorded_digest)):
            raise BootstrapError("wiring manifest artifact entry is incomplete")
        artifact = WiringArtifact(
            changerail_root / str(source_rel),
            target / str(rel_path),
            str(kind),
            str(entry.get("surface") or "unknown"),
        )
        if not artifact.source.exists():
            raise BootstrapError(f"wiring source missing: {source_rel}")
        source_digest = digest_path(artifact.source)
        if artifact.destination.exists() or artifact.destination.is_symlink():
            destination_digest = digest_path(artifact.destination)
            if destination_digest != recorded_digest and destination_digest != source_digest:
                raise BootstrapError(f"project-owned divergence at {rel_path}; refusing to overwrite")
        copy_generated_artifact(artifact, [])
        refreshed.append(
            generated_artifact_entry(artifact, target=target, changerail_root=changerail_root)
        )
    manifest["artifacts"] = refreshed
    manifest["platform"] = platform
    manifest["backend"] = "generated-copy"
    (target / WIRING_MANIFEST_REL).write_text(
        json.dumps(manifest, ensure_ascii=True, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )


def validate_windows_fallback(
    *,
    target: Path,
    platform: str,
    backend: str,
    proof_path: Path | None,
) -> dict[str, object] | None:
    if platform != "windows":
        return None
    if backend == "symlink":
        if proof_path is not None:
            return validate_fallback_proof_file(proof_path, backend)
        if os.name == "nt":
            return native_symlink_probe(target)
        raise BootstrapError("Windows symlink fallback requires --windows-fallback-proof with passed symlink checks")
    if backend == "junction":
        if proof_path is None:
            raise BootstrapError("Windows junction fallback requires --windows-fallback-proof with passed junction checks")
        return validate_fallback_proof_file(proof_path, backend)
    return None


def create_junction(target: Path, link_path: Path) -> None:
    if os.name != "nt":
        raise BootstrapError("junction fallback can only create junctions on native Windows")
    link_path.parent.mkdir(parents=True, exist_ok=True)
    if link_path.exists() or link_path.is_symlink():
        remove_path(link_path)
    result = subprocess.run(
        ["cmd", "/c", "mklink", "/J", str(link_path), str(target)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if result.returncode != 0:
        raise BootstrapError(result.stdout.strip() or f"mklink /J failed for {link_path}")


def create_junction_wiring(
    changerail_root: Path,
    target: Path,
    *,
    platform: str,
    proof: dict[str, object],
    include_maintenance_helpers: bool,
    include_claude_surface: bool = True,
) -> None:
    artifacts = wiring_artifacts(
        changerail_root,
        target,
        include_windows_helpers=platform == "windows",
        include_maintenance_helpers=include_maintenance_helpers,
        include_claude_surface=include_claude_surface,
    )
    created: list[Path] = []
    manifest_artifacts: list[WiringArtifact] = []
    count = 0
    try:
        for artifact in artifacts:
            if artifact.kind == "directory":
                destination_existed = artifact.destination.exists() or artifact.destination.is_symlink()
                create_junction(artifact.source, artifact.destination)
                if not destination_existed:
                    created.append(artifact.destination)
                manifest_artifacts.append(artifact)
            else:
                copy_generated_artifact(artifact, created)
                manifest_artifacts.append(artifact)
            count += 1
            maybe_fail_after_artifact(count)
        manifest_entries: list[dict[str, str]] = []
        for artifact in manifest_artifacts:
            owner = "junction" if artifact.kind == "directory" else "generated"
            manifest_entries.append(
                fallback_artifact_entry(
                    artifact,
                    target=target,
                    changerail_root=changerail_root,
                    owner=owner,
                )
            )
        path = target / WIRING_MANIFEST_REL
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps(
                {
                    "schema": WIRING_MANIFEST_SCHEMA,
                    "backend": "junction",
                    "platform": platform,
                    "source_root": "the linked ChangeRail source of truth",
                    "artifacts": manifest_entries,
                    "fallback_reasons": [],
                    "fallback_proof": proof,
                },
                ensure_ascii=True,
                indent=2,
                sort_keys=True,
            )
            + "\n",
            encoding="utf-8",
        )
    except Exception:
        cleanup_created_artifacts(created)
        raise


def create_wiring(
    *,
    changerail_root: Path,
    target: Path,
    platform: str,
    backend: str,
    fallback_proof: dict[str, object] | None,
    include_maintenance_helpers: bool,
    include_claude_surface: bool = True,
    path_mode: str = "relative",
) -> None:
    if backend == "generated-copy":
        create_generated_wiring(
            changerail_root,
            target,
            platform=platform,
            backend=backend,
            include_maintenance_helpers=include_maintenance_helpers,
            include_claude_surface=include_claude_surface,
        )
        return
    if backend == "symlink":
        created: list[Path] = []
        try:
            create_symlinks_with_rollback(
                changerail_root,
                target,
                created,
                include_maintenance_helpers=include_maintenance_helpers,
                include_claude_surface=include_claude_surface,
                path_mode=path_mode,
            )
        except Exception:
            cleanup_created_artifacts(created)
            raise
        if platform == "windows" and fallback_proof is not None:
            write_wiring_manifest(
                target=target,
                changerail_root=changerail_root,
                platform=platform,
                backend=backend,
                artifacts=wiring_artifacts(
                    changerail_root,
                    target,
                    include_windows_helpers=platform == "windows",
                    include_maintenance_helpers=include_maintenance_helpers,
                    include_claude_surface=include_claude_surface,
                ),
                fallback_reasons=[],
                fallback_proof=fallback_proof,
                artifact_owner="symlink",
            )
        return
    if backend == "junction":
        if fallback_proof is None:
            raise BootstrapError("junction fallback proof missing")
        create_junction_wiring(
            changerail_root,
            target,
            platform=platform,
            proof=fallback_proof,
            include_maintenance_helpers=include_maintenance_helpers,
            include_claude_surface=include_claude_surface,
        )
        return
    raise BootstrapError(f"unsupported wiring backend: {backend}")


def validate_codex_auth_source(source: Path, *, redact: bool = False) -> Path:
    expanded = source.expanduser().resolve(strict=False)
    if not expanded.is_file():
        if redact:
            raise BootstrapError("Codex auth source must be an existing file")
        raise BootstrapError(f"Codex auth source must be an existing file: {expanded}")
    return expanded


def link_codex_auth(source: Path, target: Path) -> None:
    create_symlink(source, target / ".codex" / "auth.json")


def supplied_option_names(argv: list[str]) -> set[str]:
    return {item.split("=", 1)[0] for item in argv if item.startswith("--")}


def unsupported_configure_options(args: argparse.Namespace, argv: list[str]) -> list[str]:
    unsupported = supplied_option_names(argv) & CONFIGURE_BOOTSTRAP_ONLY_OPTIONS
    if args.adopt_lockless_wiring:
        unsupported -= {"--lock-enforcement", "--wiring-platform", "--wiring-backend", "--windows-fallback-proof"}
    return sorted(unsupported)


def preflight_configure_auth(source: Path, target: Path, *, check_dirty: bool) -> str:
    rel_path = Path(".codex/auth.json")
    destination = target / rel_path
    if parent_chain_has_symlink(target, rel_path):
        raise BootstrapError("refusing auth configuration through a symlink parent")
    try:
        destination.parent.resolve(strict=False).relative_to(target.resolve())
    except ValueError as exc:
        raise BootstrapError("auth destination escapes the consumer project") from exc
    if destination.is_symlink():
        if destination.resolve(strict=False) == source.resolve(strict=False):
            state = "already-configured"
        else:
            raise BootstrapError("refusing to replace an undeclared auth symlink")
    elif destination.exists():
        raise BootstrapError("refusing to replace project-owned auth content")
    else:
        state = "create"
    if check_dirty and project_dirty_paths(target):
        raise BootstrapError("refusing auth configuration with unrelated dirty state")
    return state


def configure_existing_project(
    args: argparse.Namespace,
    argv: list[str],
    changerail_root: Path,
    target: Path,
) -> int:
    unsupported = unsupported_configure_options(args, argv)
    if unsupported:
        raise BootstrapError(
            "--configure-existing accepts only auth/wiring actions; unsupported options: "
            + ", ".join(unsupported)
        )
    if not args.link_codex_auth and not args.refresh_wiring and not args.adopt_lockless_wiring:
        raise BootstrapError(
            "--configure-existing requires --link-codex-auth, --refresh-wiring or --adopt-lockless-wiring"
        )
    if args.refresh_wiring and args.adopt_lockless_wiring:
        raise BootstrapError("--refresh-wiring and --adopt-lockless-wiring are separate flows")
    if args.adopt_lockless_wiring and args.link_codex_auth:
        raise BootstrapError("--adopt-lockless-wiring does not modify auth; run auth linking separately")
    if not target.is_dir():
        raise BootstrapError("configure target must be an existing directory")

    refresh_plan: tuple[list[tuple[Path, Path]], str] | None = None
    adoption_plan: LocklessAdoptionPlan | None = None
    if args.refresh_wiring:
        lock = require_consumer_lock(target, changerail_root)
        refresh_plan = plan_consumer_wiring_refresh(changerail_root, target, lock)
    if args.adopt_lockless_wiring:
        if (target / CONSUMER_LOCK_REL).is_file():
            lock = load_consumer_lock(target, changerail_root)
            refresh_plan = plan_consumer_wiring_refresh(changerail_root, target, lock)
        else:
            platform = resolve_wiring_platform(args.wiring_platform)
            backend = resolve_wiring_backend(platform, args.wiring_backend)
            if args.wiring_path_mode is not None:
                raise BootstrapError("--adopt-lockless-wiring infers path mode from existing wiring")
            fallback_proof = validate_windows_fallback(target=target, platform=platform, backend=backend, proof_path=args.windows_fallback_proof)
            adoption_plan = plan_lockless_wiring_adoption(changerail_root=changerail_root, target=target, platform=platform, backend=backend, profiles=normalize_profiles(args), enforcement=args.lock_enforcement, fallback_proof=fallback_proof)

    auth_source: Path | None = None
    auth_state: str | None = None
    if args.link_codex_auth:
        auth_source = validate_codex_auth_source(args.link_codex_auth, redact=True)
        auth_state = preflight_configure_auth(auth_source, target, check_dirty=refresh_plan is None)

    if args.dry_run:
        if adoption_plan is not None:
            print_lockless_adoption_plan(adoption_plan, target=target, changerail_root=changerail_root)
            if not args.skip_verify:
                print(f"PLAN verify {changerail_root / 'bin' / 'verify-project'} {target}")
            print("dry-run: no files were written")
            return 1 if adoption_plan.blocked else 0

        print("PLAN configure-existing")
        if refresh_plan is not None:
            print(f"PLAN refresh-wiring {CONSUMER_LOCK_REL}")
        if auth_source is not None:
            print("PLAN auth-link .codex/auth.json (source redacted)")
        if not args.skip_verify:
            print(f"PLAN verify {changerail_root / 'bin' / 'verify-project'} {target}")
        print("dry-run: no files were written")
        return 0

    if refresh_plan is not None:
        apply_consumer_wiring_refresh(*refresh_plan)
    if adoption_plan is not None:
        apply_lockless_adoption(adoption_plan, changerail_root=changerail_root, target=target)
    if auth_source is not None and auth_state == "create":
        link_codex_auth(auth_source, target)
    if not args.skip_verify:
        run_verify(changerail_root, target)
    print(f"configured existing project: {target}")
    if refresh_plan is not None:
        print("wiring refreshed from consumer lock")
    if adoption_plan is not None:
        print("lockless wiring adopted into consumer lock")
        print(f"wiring backend: {adoption_plan.backend}")
        print(f"wiring path mode: {adoption_plan.path_mode}")
    if auth_state == "create":
        print("auth linked: .codex/auth.json")
    elif auth_state == "already-configured":
        print("auth already configured: .codex/auth.json")
    return 0


def validate_git_options(args: argparse.Namespace) -> str | None:
    if not args.init_git:
        if args.default_branch is not None or args.remote is not None:
            raise BootstrapError("--default-branch and --remote require --init-git")
        return None
    branch = args.default_branch or "main"
    if any(ord(char) < 32 or ord(char) == 127 for char in branch):
        raise BootstrapError("invalid Git default branch")
    branch_check = subprocess.run(
        ["git", "check-ref-format", "--branch", branch],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if branch_check.returncode != 0:
        raise BootstrapError("invalid Git default branch")
    if args.remote is not None:
        remote = args.remote
        if not remote or remote.startswith("-") or any(
            ord(char) < 32 or ord(char) == 127 for char in remote
        ):
            raise BootstrapError("invalid Git remote URL")
        try:
            parsed = urlsplit(remote)
            has_credentials = bool(parsed.password or (parsed.username and parsed.username != "git"))
        except ValueError as exc:
            raise BootstrapError("invalid Git remote URL") from exc
        scp_user = re.match(r"^([^/@:]+)@[^/:]+:", remote)
        if has_credentials or (scp_user and scp_user.group(1) != "git"):
            raise BootstrapError("Git remote URL must not contain credentials")
        if parsed.query or parsed.fragment:
            raise BootstrapError("Git remote URL must not contain query or fragment data")
    return branch


def initialize_git(target: Path, branch: str, remote: str | None) -> None:
    git_dir = target / ".git"
    if git_dir.is_symlink():
        raise BootstrapError("refusing Git initialization through a symlinked .git path")
    created_repository = not git_dir.exists()
    try:
        if created_repository:
            result = subprocess.run(
                ["git", "-C", str(target), "init", "--initial-branch", branch],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            if result.returncode != 0:
                raise BootstrapError("Git initialization failed")
        else:
            current = run_git(target, "symbolic-ref", "--short", "HEAD")
            if current != branch:
                raise BootstrapError("existing Git default branch conflicts with requested state")
        if remote is not None:
            existing = subprocess.run(
                ["git", "-C", str(target), "remote", "get-url", "origin"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            if existing.returncode == 0:
                if existing.stdout.strip() != remote:
                    raise BootstrapError("existing Git origin conflicts with requested state")
            else:
                added = subprocess.run(
                    ["git", "-C", str(target), "remote", "add", "origin", remote],
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    check=False,
                )
                if added.returncode != 0:
                    raise BootstrapError("Git origin configuration failed")
    except BootstrapError:
        if created_repository and git_dir.is_dir():
            shutil.rmtree(git_dir)
        raise


def run_verify(changerail_root: Path, target: Path) -> None:
    verify_name = "verify-project.cmd" if os.name == "nt" else "verify-project"
    verify = changerail_root / "bin" / verify_name
    result = subprocess.run(
        [str(verify), str(target)],
        cwd=changerail_root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        env={**os.environ, "OPENSPEC_TELEMETRY": "0"},
        timeout=180,
    )
    print(result.stdout, end="")
    if result.returncode != 0:
        raise BootstrapError(f"verify-project failed for {target}")


def print_plan(
    template_root: Path,
    changerail_root: Path,
    target: Path,
    *,
    backup: Path | None,
    skip_verify: bool,
    codex_auth_source: Path | None,
    platform: str,
    backend: str,
    fallback_proof: dict[str, object] | None,
    refresh_wiring: bool,
    include_maintenance: bool,
    profiles: BootstrapProfiles,
    path_mode: str,
    lock_enforcement: str,
    include_ci: bool,
    include_readme: bool,
    git_branch: str | None,
    configure_remote: bool,
) -> None:
    print(f"PLAN project-profile {profiles.project}")
    print(f"PLAN surfaces-profile {profiles.surfaces}")
    print(f"PLAN codex-policy {profiles.codex_policy}")
    print(f"PLAN wiring-platform {platform}")
    print(f"PLAN wiring-backend {backend}")
    print(f"PLAN wiring-path-mode {path_mode}")
    print(f"PLAN lock-enforcement {lock_enforcement}")
    for reason in generated_fallback_reasons(platform, backend):
        print(f"PLAN fallback {reason}")
    if fallback_proof:
        print("PLAN fallback-proof " + json.dumps(fallback_proof, ensure_ascii=True, sort_keys=True))
    if refresh_wiring:
        refresh_contract = CONSUMER_LOCK_REL if (target / CONSUMER_LOCK_REL).is_file() else WIRING_MANIFEST_REL
        print(f"PLAN refresh-wiring {target / refresh_contract}")
        return
    if backup is not None:
        print(f"PLAN backup {target} -> {backup}")
    for action, destination, source in collect_plan(
        template_root,
        target,
        include_maintenance=include_maintenance,
        profiles=profiles,
        include_ci=include_ci,
        include_readme=include_readme,
    ):
        print(f"PLAN {action} {source} -> {destination}")
    if include_maintenance:
        print(f"PLAN render-maintenance-index {target / '.changerail' / 'KNOWLEDGE.md'}")
    if lock_enforcement != "none":
        print(f"PLAN consumer-lock {target / CONSUMER_LOCK_REL}")
    if backend == "generated-copy":
        for artifact in wiring_artifacts(
            changerail_root,
            target,
            include_windows_helpers=platform == "windows",
            include_maintenance_helpers=include_maintenance,
            include_claude_surface=profiles.include_claude,
        ):
            rel = rel_to_root(artifact.destination, target)
            print(f"PLAN generated {artifact.kind} {rel} <- {rel_to_root(artifact.source, changerail_root)}")
        print(f"PLAN generated-manifest {target / WIRING_MANIFEST_REL}")
    elif backend == "junction":
        for artifact in wiring_artifacts(
            changerail_root,
            target,
            include_windows_helpers=platform == "windows",
            include_maintenance_helpers=include_maintenance,
            include_claude_surface=profiles.include_claude,
        ):
            rel = rel_to_root(artifact.destination, target)
            action = "junction" if artifact.kind == "directory" else "generated"
            print(f"PLAN {action} {artifact.kind} {rel} <- {rel_to_root(artifact.source, changerail_root)}")
    else:
        for source, link_path in symlink_plan(
            changerail_root,
            target,
            include_maintenance_helpers=include_maintenance,
            include_claude_surface=profiles.include_claude,
        ):
            print(f"PLAN symlink {link_path} -> {source}")
    if codex_auth_source is not None:
        print(f"PLAN auth-link {target / '.codex' / 'auth.json'} (source redacted)")
    if git_branch is not None:
        print(f"PLAN git-init branch={git_branch}")
        if configure_remote:
            print("PLAN git-remote origin (URL redacted)")
    if not skip_verify:
        print(f"PLAN verify {changerail_root / 'bin' / 'verify-project'} {target}")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Bootstrap a new ChangeRail consumer project.")
    parser.add_argument("path", type=Path, help="Target project path.")
    parser.add_argument(
        "--configure-existing",
        action="store_true",
        help="Apply only allowlisted auth/wiring configuration to an existing project.",
    )
    parser.add_argument("--name", default=None, help="Project name. Defaults to target directory name.")
    parser.add_argument(
        "--profile",
        choices=PROJECT_PROFILES,
        default=None,
        help="Project topology profile. Defaults to generic.",
    )
    parser.add_argument(
        "--kind",
        choices=PROJECT_PROFILES,
        default=None,
        help="Deprecated compatibility alias for --profile.",
    )
    parser.add_argument(
        "--surfaces",
        choices=SURFACES_PROFILES,
        default="all-surfaces",
        help="Agent surface profile. Defaults to all-surfaces.",
    )
    parser.add_argument(
        "--codex-policy",
        choices=CODEX_POLICIES,
        default="safe-interactive",
        help="Codex authority profile. Defaults to safe-interactive.",
    )
    parser.add_argument("--changerail-root", type=Path, default=repo_root_from_bin())
    parser.add_argument(
        "--config-mode",
        choices=("portable", "local"),
        default="portable",
        help="Render portable tracked config by default; local mode embeds absolute machine-local paths.",
    )
    parser.add_argument("--dry-run", action="store_true", help="Print planned actions without writing files.")
    parser.add_argument("--backup-existing", action="store_true", help="Move an existing non-empty target aside first.")
    parser.add_argument("--skip-verify", action="store_true", help="Generate files without running verify-project.")
    parser.add_argument(
        "--wiring-platform",
        choices=("auto", "posix", "windows"),
        default="auto",
        help="Platform policy for wiring backend selection. Defaults to the current platform.",
    )
    parser.add_argument(
        "--wiring-backend",
        choices=("auto", "symlink", "generated-copy", "junction"),
        default="auto",
        help="Wiring backend. auto selects generated-copy on native Windows and symlink elsewhere.",
    )
    parser.add_argument(
        "--wiring-path-mode",
        choices=("absolute", "relative"),
        default=None,
        help="POSIX symlink target mode. Defaults to absolute; relative requires explicit opt-in.",
    )
    parser.add_argument(
        "--lock-enforcement",
        choices=LOCK_ENFORCEMENTS,
        default="advisory",
        help="Consumer source lock mode. Defaults to advisory; none is for explicit development use.",
    )
    parser.add_argument(
        "--with-ci",
        action="store_true",
        help="Generate read-only consumer verification CI; requires a strict consumer lock.",
    )
    parser.add_argument(
        "--with-readme",
        action="store_true",
        help="Render a minimal project README for a new target.",
    )
    parser.add_argument(
        "--init-git",
        action="store_true",
        help="Initialize the local Git repository without staging or committing files.",
    )
    parser.add_argument(
        "--default-branch",
        default=None,
        metavar="BRANCH",
        help="Initial branch for --init-git. Defaults to main.",
    )
    parser.add_argument(
        "--remote",
        default=None,
        metavar="URL",
        help="Configure origin during --init-git without contacting the remote.",
    )
    parser.add_argument(
        "--refresh-wiring",
        action="store_true",
        help="Refresh generated-owned wiring artifacts from the ChangeRail source of truth.",
    )
    parser.add_argument("--adopt-lockless-wiring", action="store_true", help="Opt in to adopting existing lockless ChangeRail wiring into a consumer lock.")
    parser.add_argument(
        "--with-maintenance",
        action="store_true",
        help="Opt in to tracked maintenance policy/catalog skeletons and maintenance helper wiring.",
    )
    parser.add_argument(
        "--windows-fallback-proof",
        type=Path,
        default=None,
        help=(
            "JSON proof report with passed checks required for explicit "
            "Windows fallback modes when a native probe cannot prove them."
        ),
    )
    parser.add_argument(
        "--link-codex-auth",
        type=Path,
        default=None,
        metavar="AUTH_JSON",
        help="Opt in to creating ignored .codex/auth.json as a symlink to an existing local Codex auth file.",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    changerail_root = args.changerail_root.resolve()
    template_root = changerail_root / "templates" / "project"
    target = args.path.resolve()
    project_name = args.name or target.name
    platform = resolve_wiring_platform(args.wiring_platform)
    backend = resolve_wiring_backend(platform, args.wiring_backend)

    try:
        if args.configure_existing:
            return configure_existing_project(args, argv, changerail_root, target)
        git_branch = validate_git_options(args)
        profiles = normalize_profiles(args)
        if args.with_ci and args.lock_enforcement != "strict":
            raise BootstrapError("--with-ci requires --lock-enforcement strict")
        if args.with_ci and args.refresh_wiring:
            raise BootstrapError("--with-ci cannot be used with --refresh-wiring")
        if args.refresh_wiring and (args.with_readme or args.init_git):
            raise BootstrapError("README/Git initialization cannot be used with --refresh-wiring")
        if not template_root.is_dir():
            raise BootstrapError(f"template root missing: {template_root}")
        instruction_bytes = None
        if not args.refresh_wiring:
            instruction_bytes = preflight_generated_instruction_budget(
                template_root,
                target,
                project_name,
                profiles,
                changerail_root,
                args.config_mode,
            )
        refresh_lock: dict[str, object] | None = None
        if args.refresh_wiring and target.is_dir():
            if (target / CONSUMER_LOCK_REL).is_file():
                refresh_lock = load_consumer_lock(target, changerail_root)
                locked_wiring = refresh_lock.get("wiring")
                if not isinstance(locked_wiring, dict):
                    raise BootstrapError("consumer lock wiring section is invalid")
                platform = str(locked_wiring.get("platform") or platform)
                backend = str(locked_wiring.get("backend") or backend)
                path_mode = str(locked_wiring.get("path_mode") or "not-applicable")
                if args.wiring_path_mode is not None:
                    raise BootstrapError("--wiring-path-mode cannot override a consumer lock during refresh")
            else:
                raise BootstrapError(consumer_lock_missing_message())
        else:
            path_mode = resolve_wiring_path_mode(platform, backend, args.wiring_path_mode)
        fallback_proof = validate_windows_fallback(
            target=target,
            platform=platform,
            backend=backend,
            proof_path=args.windows_fallback_proof,
        )
        codex_auth_source = (
            validate_codex_auth_source(args.link_codex_auth, redact=True)
            if args.link_codex_auth
            else None
        )
        lock_payload = None
        if not args.refresh_wiring:
            lock_payload = consumer_lock_payload(
                changerail_root=changerail_root,
                target=target,
                platform=platform,
                backend=backend,
                path_mode=path_mode,
                profiles=profiles,
                enforcement=args.lock_enforcement,
                include_maintenance_helpers=args.with_maintenance,
            )
        if args.refresh_wiring:
            if args.backup_existing:
                raise BootstrapError("--backup-existing cannot be used with --refresh-wiring")
            if args.link_codex_auth:
                raise BootstrapError("--link-codex-auth cannot be used with --refresh-wiring")
            if args.with_maintenance:
                raise BootstrapError("--with-maintenance cannot be used with --refresh-wiring")
            if not target.is_dir():
                raise BootstrapError(f"target must exist for refresh: {target}")
            backup = None
        else:
            backup = ensure_target(target, backup_existing=args.backup_existing, dry_run=args.dry_run)
        if args.dry_run:
            print_plan(
                template_root,
                changerail_root,
                target,
                backup=backup,
                skip_verify=args.skip_verify,
                codex_auth_source=codex_auth_source,
                platform=platform,
                backend=backend,
                fallback_proof=fallback_proof,
                refresh_wiring=args.refresh_wiring,
                include_maintenance=args.with_maintenance,
                profiles=profiles,
                path_mode=path_mode,
                lock_enforcement=args.lock_enforcement,
                include_ci=args.with_ci,
                include_readme=args.with_readme,
                git_branch=git_branch,
                configure_remote=args.remote is not None,
            )
            print("dry-run: no files were written")
            return 0

        if args.refresh_wiring:
            if refresh_lock is None:
                raise BootstrapError(consumer_lock_missing_message())
            if backend == "symlink":
                refresh_consumer_wiring(changerail_root, target, refresh_lock)
            else:
                refresh_generated_wiring(changerail_root, target)
            if not args.skip_verify:
                run_verify(changerail_root, target)
            print(f"wiring refreshed: {target}")
            print(f"wiring backend: {backend}")
            return 0

        write_templates(
            template_root=template_root,
            target=target,
            project_name=project_name,
            profiles=profiles,
            changerail_root=changerail_root,
            config_mode=args.config_mode,
            include_maintenance=args.with_maintenance,
            include_ci=args.with_ci,
            include_readme=args.with_readme,
        )
        if args.with_maintenance:
            write_maintenance_index(target)
        write_consumer_lock(target, lock_payload)
        create_wiring(
            changerail_root=changerail_root,
            target=target,
            platform=platform,
            backend=backend,
            fallback_proof=fallback_proof,
            include_maintenance_helpers=args.with_maintenance,
            include_claude_surface=profiles.include_claude,
            path_mode=path_mode,
        )
        if codex_auth_source is not None:
            link_codex_auth(codex_auth_source, target)
        if git_branch is not None:
            initialize_git(target, git_branch, args.remote)
        if not args.skip_verify:
            run_verify(changerail_root, target)
        print(f"bootstrapped: {target}")
        print(f"wiring backend: {backend}")
        print(f"wiring platform: {platform}")
        print(f"wiring path mode: {path_mode}")
        print(f"lock enforcement: {args.lock_enforcement}")
        print(f"project profile: {profiles.project}")
        print(f"surfaces profile: {profiles.surfaces}")
        print(f"Codex policy: {profiles.codex_policy}")
        assert instruction_bytes is not None
        print(f"instruction budget: {instruction_bytes}/{PROJECT_DOC_MAX_BYTES} UTF-8 bytes")
        if backup is not None:
            print(f"backup: {backup}")
        if codex_auth_source is not None:
            print("auth linked: .codex/auth.json")
        if git_branch is not None:
            print(f"Git initialized: branch {git_branch}")
            if args.remote is not None:
                print("Git remote configured: origin")
            print("no files were staged, committed or pushed")
        else:
            print("next: git init")
        if args.with_maintenance:
            print("maintenance: opted in (.changerail/maintenance.yaml)")
        if args.config_mode == "local":
            print("warning: --config-mode local rendered machine-local absolute paths; review before git add")
        add_paths = "AGENTS.md .gitignore .mcp.json .codex/config.toml .codex/skills bin openspec"
        if args.with_readme:
            add_paths += " README.md"
        if profiles.include_claude:
            add_paths += " CLAUDE.md .claude"
        if args.with_maintenance:
            add_paths += " .changerail"
        print(f"next: git add {add_paths}")
        print("next: git commit -m 'Bootstrap ChangeRail project'")
        if args.remote is None:
            print("next: add a remote when the project is ready to publish")
        return 0
    except BootstrapError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
