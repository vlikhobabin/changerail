    "ssh_config",
    "dns",
    "auth",
    "missing_branch",
    "timeout",
    "unknown_remote_failure",
)
TRANSIENT_REMOTE_FAILURE_CLASSES = {"dns", "timeout", "unknown_remote_failure"}
