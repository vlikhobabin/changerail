TOKEN_VALUE_RE = re.compile(r"(?i)(token|password|passwd|secret|access_key|api_key|authorization)=([^\s&]+)")
DEFAULT_COMMAND_OUTPUT_THRESHOLD_BYTES = 64 * 1024


def positive_int_from_env(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        value = int(raw)
    except ValueError:
        return default
    return value if value > 0 else default


COMMAND_OUTPUT_THRESHOLD_BYTES = positive_int_from_env(
    "CHANGERAIL_COMMAND_OUTPUT_THRESHOLD_BYTES",
    DEFAULT_COMMAND_OUTPUT_THRESHOLD_BYTES,
)


@dataclass
class Check:
    name: str
    status: str
    message: str
    data: dict[str, Any] | None = None


@dataclass
class TerminalSignal:
    outcome: str | None = None
    reason: str | None = None


@dataclass
class RemoteProof:
    status: str
    message: str
    remote: str | None = None
    branch: str | None = None
    remote_url_class: str | None = None
    failure_class: str | None = None
    detail: str | None = None
    retryable: bool = False
    attempts: int = 1


def check_payload(check: Check) -> dict[str, Any]:
    payload = {
        "name": check.name,
        "status": check.status,
        "message": check.message,
    }
    if check.data:
        payload.update(check.data)
    return payload


def repo_root_from_script() -> Path:
    return Path(__file__).resolve().parents[1]


def schema_errors(payload: Any, schema_filename: str) -> list[str]:
    scripts = repo_root_from_script() / "scripts"
    if str(scripts) not in sys.path:
        sys.path.insert(0, str(scripts))
    try:
        from changerail_contract_schema import validate_with_schema
    except Exception as exc:
        return [f"schema validation unavailable: {type(exc).__name__}: {exc}"]
    return validate_with_schema(payload, schema_filename)


def invocation_workspace() -> Path:
    cwd = Path.cwd()
    result = subprocess.run(
        ["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip()).resolve(strict=False)
    return cwd.resolve(strict=False)


def resolve_path(path: Path, base: Path | None = None) -> Path:
    path = path.expanduser()
    if path.is_absolute():
        return path.resolve(strict=False)
    anchor = base or Path.cwd()
    return (anchor / path).resolve(strict=False)


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def utc_run_id() -> str:
    return f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{secrets.token_hex(4)}"


def ensure_private_directory(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.chmod(0o700)


def atomic_write_json(path: Path, data: dict[str, Any], *, private: bool = True) -> None:
    if private:
        ensure_private_directory(path.parent)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as handle:
        tmp_path = Path(handle.name)
        if private:
            os.fchmod(handle.fileno(), 0o600)
        json.dump(data, handle, ensure_ascii=False, indent=2, sort_keys=True)
        handle.write("\n")
    os.replace(tmp_path, path)
    if private:
        path.chmod(0o600)


def open_private_text(path: Path):
    ensure_private_directory(path.parent)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(descriptor, 0o600)
    return os.fdopen(descriptor, "w", encoding="utf-8")


def parse_utc(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def elapsed_seconds(start: datetime | None, end: datetime | None) -> float | None:
    if start is None or end is None:
        return None
    seconds = (end - start).total_seconds()
    if seconds < 0:
        return None
    return round(seconds, 3)


def git_head(root: Path) -> str | None:
    result = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "HEAD"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    return result.stdout.strip() or None


def effective_codex_home(args: argparse.Namespace) -> Path:
    root = args.workspace.resolve(strict=False)
    configured = os.environ.get("CODEX_HOME")
    if configured:
        path = Path(configured).expanduser()
        return path if path.is_absolute() else root / path
    return root / ".codex"


def child_environment(args: argparse.Namespace) -> dict[str, str]:
    root = args.workspace.resolve(strict=False)
    env = os.environ.copy()
    env["CODEX_WORKDIR"] = str(root)
    env["CODEX_HOME"] = str(effective_codex_home(args))
    env["CHANGERAIL_ACTIVE_RUN_ID"] = args.run_id
    env["CHANGERAIL_ACTIVE_RUN_DIR"] = str((args.runtime_root / args.run_id).resolve(strict=False))
    env["CHANGERAIL_COMMAND_OUTPUT_THRESHOLD_BYTES"] = str(COMMAND_OUTPUT_THRESHOLD_BYTES)
    env["CHANGERAIL_DISCOVERY_POLICY"] = child_discovery_policy()
    return env


def child_discovery_policy() -> str:
    return (
        "Start discovery with scoped paths, rg -l, counts, top-level file lists "
        "or bounded excerpts before broad matching-line output. Treat truncated "
        "output, including exit 130 after truncation, as inconclusive and collect "
        "narrower structured evidence before acceptance or verification claims. "
        f"Per-command output threshold: {COMMAND_OUTPUT_THRESHOLD_BYTES} bytes. "
        "Raw stdout/stderr evidence remains ignored runtime state, not committable payload."
    )


def stale_symlinks(root: Path) -> list[str]:
    if not root.exists():
        return []
    stale: list[str] = []
    for path in root.rglob("*"):
        try:
            if path.is_symlink() and not path.exists():
                stale.append(str(path.relative_to(root)))
        except OSError:
            stale.append(str(path))
    return sorted(stale)


def auth_state(codex_home: Path, env: dict[str, str]) -> Check:
    if any(env.get(name) for name in AUTH_ENV_VARS):
        return Check("CODEX auth", "pass", "auth environment variable is set")
    for name in AUTH_MARKER_FILES:
        if (codex_home / name).is_file():
            return Check("CODEX auth", "pass", f"{codex_home / name}")
    return Check("CODEX auth", "fail", f"no auth marker or supported auth environment variable found; {AUTH_REMEDIATION}")


def codex_binary_state(launcher: Path) -> Check:
    default_launcher = (repo_root_from_script() / "bin" / "codex").resolve(strict=False)
    selected_launcher = launcher.resolve(strict=False)
    if selected_launcher != default_launcher:
        return Check("codex binary", "skip", f"custom launcher selected: {selected_launcher}")
    found = shutil.which("codex")
    return Check("codex binary", "pass" if found else "fail", found or "not found")


def no_push_selected(args: argparse.Namespace) -> bool:
    return any(value == "--no-push" for value in getattr(args, "deliver_arg", []) or [])


def sanitize_remote_detail(value: str) -> str:
    compact = compact_reason(value or "git ls-remote failed")
    compact = URL_USERINFO_RE.sub(r"\1<redacted>@", compact)
    compact = TOKEN_VALUE_RE.sub(r"\1=<redacted>", compact)
    return compact


def classify_remote_failure(returncode: int, stdout: str, stderr: str, timed_out: bool = False) -> tuple[str, str, bool]:
    if timed_out:
        return "timeout", f"git ls-remote timed out after {REMOTE_REACHABILITY_TIMEOUT_SECONDS:g}s", True
    raw_detail = stderr.strip() or stdout.strip() or "remote branch ref was not found"
    detail = sanitize_remote_detail(raw_detail)
    text = raw_detail.lower()
    if returncode == 2 and not stderr.strip():
        return "missing_branch", detail, False
    if any(
        marker in text
        for marker in (
            "could not resolve hostname",
            "name or service not known",
            "temporary failure in name resolution",
            "nodename nor servname",
            "no address associated",
            "failed to resolve",
            "resolve host",
        )
    ):
        return "dns", detail, True
    if any(
        marker in text
        for marker in (
            "permission denied",
            "authentication failed",
            "access denied",
            "could not read username",
            "repository not found",
            "not authorized",
            "authorization failed",
            "publickey",
        )
    ):
        return "auth", detail, False
    if any(
        marker in text
        for marker in (
            "bad configuration option",
            "terminating, 1 bad configuration",
            "no such identity",
            "identityfile",
            "host key verification failed",
            "known_hosts",
            "no matching host key",
            "no matching key exchange",
            "ssh: connect to host",
            "could not open a connection",
            "connection refused",
        )
    ):
        return "ssh_config", detail, False
    return "unknown_remote_failure", detail, True


def remote_check_data(proof: RemoteProof) -> dict[str, Any]:
    data: dict[str, Any] = {
        "result": "passed" if proof.status == "pass" else "failed",
        "attempts": proof.attempts,
    }
    if proof.remote:
        data["remote"] = proof.remote
    if proof.branch:
        data["branch"] = proof.branch
    if proof.remote_url_class:
        data["remote_url_class"] = proof.remote_url_class
    if proof.failure_class:
        data["failure_class"] = proof.failure_class
        data["retryable"] = proof.retryable
    if proof.detail:
        data["detail"] = proof.detail
    command = "git ls-remote --exit-code <remote> refs/heads/<branch>"
    data["evidence"] = {
        "command": command,
        "result": data["result"],
        "detail": proof.detail or proof.message,
    }
    return data


def git_text(root: Path, *git_args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *git_args],
        capture_output=True,
        text=True,
        check=False,
    )


def current_branch(root: Path) -> str:
    result = git_text(root, "branch", "--show-current")
    return result.stdout.strip() if result.returncode == 0 else ""


def publish_target_state(args: argparse.Namespace) -> Check:
    if no_push_selected(args):
        return Check(
            "publish target",
            "pass",
            "mode=no-push explicit=true remote_probe=skipped",
        )

    root = args.workspace.resolve(strict=False)
    if not git_is_repo(root):
        proof = RemoteProof("fail", "mode=remote-push git repository unavailable", failure_class="unknown_remote_failure", retryable=True)
        return Check("publish target", "fail", proof.message, remote_check_data(proof))

    branch = current_branch(root)
    if not branch:
        proof = RemoteProof("fail", "mode=remote-push current branch unavailable", failure_class="missing_branch", retryable=False)
        return Check("publish target", "fail", proof.message, remote_check_data(proof))

    remote = git_text(root, "config", "--get", f"branch.{branch}.remote").stdout.strip()
    merge_ref = git_text(root, "config", "--get", f"branch.{branch}.merge").stdout.strip()
    remote_branch = merge_ref.removeprefix("refs/heads/") if merge_ref.startswith("refs/heads/") else ""
    if not remote or not remote_branch:
        proof = RemoteProof(
            "fail",
            f"mode=remote-push branch={branch} upstream=missing; configure an approved remote/upstream or pass --no-push explicitly",
            branch=branch,
            failure_class="missing_branch",
            detail="upstream is missing",
            retryable=False,
        )
        return Check("publish target", "fail", proof.message, remote_check_data(proof))
    upstream = git_text(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}")
    upstream_name = upstream.stdout.strip() if upstream.returncode == 0 and upstream.stdout.strip() else f"{remote}/{remote_branch}"

    remote_url = git_text(root, "remote", "get-url", remote)
    if remote_url.returncode != 0 or not remote_url.stdout.strip():
        proof = RemoteProof(
            "fail",
            f"mode=remote-push remote={remote} branch={remote_branch} remote_url=missing",
            remote=remote,
            branch=remote_branch,
            failure_class="unknown_remote_failure",
            detail="remote URL is missing",
            retryable=True,
        )
        return Check("publish target", "fail", proof.message, remote_check_data(proof))
    url = remote_url.stdout.strip()
    url_class = remote_url_class(url)
    if remote_has_embedded_credentials(url):
        proof = RemoteProof(
            "fail",
            f"mode=remote-push remote={remote} branch={remote_branch} remote_url_class={url_class} credential_in_url=rejected",
            remote=remote,
            branch=remote_branch,
            remote_url_class=url_class,
            failure_class="auth",
            detail="credential_in_url=rejected",
            retryable=False,
        )
        return Check("publish target", "fail", proof.message, remote_check_data(proof))

    proof: RemoteProof | None = None
    for attempt in range(1, REMOTE_PREFLIGHT_MAX_ATTEMPTS + 1):
        try:
            reachable = subprocess.run(
                ["git", "-C", str(root), "ls-remote", "--exit-code", remote, f"refs/heads/{remote_branch}"],
                capture_output=True,
                text=True,
                check=False,
                timeout=REMOTE_REACHABILITY_TIMEOUT_SECONDS,
            )
        except subprocess.TimeoutExpired:
            failure_class, detail, retryable = classify_remote_failure(124, "", "", timed_out=True)
            proof = RemoteProof(
                "fail",
                f"mode=remote-push remote={remote} branch={remote_branch} remote_url_class={url_class} reachable=false failure_class={failure_class}",
                remote=remote,
                branch=remote_branch,
                remote_url_class=url_class,
                failure_class=failure_class,
                detail=detail,
                retryable=retryable,
                attempts=attempt,
            )
        else:
            if reachable.returncode == 0:
                proof = RemoteProof(
                    "pass",
                    f"mode=remote-push remote={remote} branch={remote_branch} upstream={upstream_name} remote_url_class={url_class} reachable=true",
                    remote=remote,
                    branch=remote_branch,
                    remote_url_class=url_class,
                    detail="remote branch reachable",
                    retryable=False,
                    attempts=attempt,
                )
                break
            failure_class, detail, retryable = classify_remote_failure(
                reachable.returncode,
                reachable.stdout,
                reachable.stderr,
            )
            proof = RemoteProof(
                "fail",
                f"mode=remote-push remote={remote} branch={remote_branch} remote_url_class={url_class} reachable=false failure_class={failure_class} detail={detail}",
                remote=remote,
                branch=remote_branch,
                remote_url_class=url_class,
                failure_class=failure_class,
                detail=detail,
                retryable=retryable,
                attempts=attempt,
            )
        if not proof.retryable or attempt >= REMOTE_PREFLIGHT_MAX_ATTEMPTS:
            break
        time.sleep(REMOTE_PREFLIGHT_BACKOFF_SECONDS)

    if proof is None:
        proof = RemoteProof(
            "fail",
            f"mode=remote-push remote={remote} branch={remote_branch} remote_url_class={url_class} reachable=false failure_class=unknown_remote_failure",
            remote=remote,
            branch=remote_branch,
            remote_url_class=url_class,
            failure_class="unknown_remote_failure",
            detail="git ls-remote failed",
            retryable=True,
        )
    return Check(
        "publish target",
        proof.status,
        proof.message,
        remote_check_data(proof),
    )


def sanitized_endpoint(url: str) -> str:
    parts = urllib.parse.urlsplit(url)
    scheme = parts.scheme or "unknown"
    host = parts.hostname or "unknown-host"
    port = f":{parts.port}" if parts.port is not None else ""
    return f"{scheme}://{host}{port}"


def remote_url_class(remote_url: str) -> str:
    parts = urllib.parse.urlsplit(remote_url)
    if parts.scheme:
        if parts.scheme == "file":
            return "local-file"
        if parts.scheme in {"http", "https"}:
            return "https"
        if parts.scheme == "ssh":
            return "ssh"
        return parts.scheme
    if remote_url.startswith(("/", ".", "~")):
        return "local-path"
    if ":" in remote_url and "/" not in remote_url.split(":", 1)[0]:
        return "scp"
    return "local-path"


def remote_has_embedded_credentials(remote_url: str) -> bool:
    parts = urllib.parse.urlsplit(remote_url)
    return bool(parts.scheme and (parts.username is not None or parts.password is not None))


def connectivity_probe_url(url: str) -> str:
    parts = urllib.parse.urlsplit(url)
    if not parts.hostname:
        return url
    host = parts.hostname
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    port = f":{parts.port}" if parts.port is not None else ""
    netloc = f"{host}{port}"
    return urllib.parse.urlunsplit((parts.scheme, netloc, parts.path, parts.query, parts.fragment))


def record_commit(record: dict[str, Any], root: Path) -> None:
    head = git_head(root)
    if head:
        record.setdefault("workspace", {})["head_commit"] = head
        record["commit"] = head


def card_id(card: str) -> str:
    return Path(card).name.removesuffix(".md")


def repository_relative(path: Path, root: Path) -> str:
    try:
        return path.relative_to(root).as_posix()
    except ValueError:
        return path.as_posix()


def review_fingerprint(root: Path) -> tuple[dict[str, Any] | None, str | None]:
    helper = repo_root_from_script() / "bin" / "changerail-review-verdict"
    result = subprocess.run(
        [str(helper), "fingerprint", "--workspace", str(root)],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None, result.stderr.strip() or result.stdout.strip() or "review fingerprint failed"
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        return None, f"review fingerprint JSON is invalid: {exc}"
    return payload if isinstance(payload, dict) else None, "review fingerprint did not return an object"


def retained_payload_identity(args: argparse.Namespace, root: Path) -> tuple[dict[str, Any] | None, str | None]:
    fingerprint, error = review_fingerprint(root)
    if fingerprint is None:
        return None, error or "review fingerprint unavailable"
    missing = [
        key
        for key in ("head_commit", "tree_sha", "diff_fingerprint")
        if not isinstance(fingerprint.get(key), str) or not fingerprint[key]
    ]
    if missing:
        return None, "review fingerprint missing required fields: " + ", ".join(missing)
    identity = {
        "schema": "changerail.retained-payload-identity.v1",
        "source_run_id": args.run_id,
        "source_status_path": repository_relative(status_path(args), root),
        "captured_at": utc_now(),
        "card": {
            "id": card_id(args.card),
            "path": args.card,
        },
        "workspace": {
            "root": str(root),
        },
        "head_commit": fingerprint["head_commit"],
        "tree_sha": fingerprint["tree_sha"],
        "diff_fingerprint": fingerprint["diff_fingerprint"],
        "review_target": {
            "kind": "working-tree",
        },
    }
    return identity, None


def retained_recovery_summary(child_status: dict[str, Any], run_status_path: str | None = None) -> dict[str, Any] | None:
    retained = child_status.get("retained_payload")
    if not isinstance(retained, dict):
        return None
    card = retained.get("card")
    review_target = retained.get("review_target")
    if not isinstance(card, dict) or not isinstance(review_target, dict):
        return None
    summary = {
        "kind": "original-retained-payload",
        "source_run_id": retained.get("source_run_id"),
        "source_run_status_path": run_status_path or retained.get("source_status_path"),
        "source_terminal_reason": "investigation_required",
        "card": {
            "id": card.get("id"),
            "path": card.get("path"),
        },
        "fingerprint": {
            "head_commit": retained.get("head_commit"),
            "tree_sha": retained.get("tree_sha"),
            "diff_fingerprint": retained.get("diff_fingerprint"),
        },
        "review_target_kind": review_target.get("kind"),
    }
    if all(isinstance(value, str) and value for value in (
        summary["source_run_id"],
        summary["source_run_status_path"],
        summary["source_terminal_reason"],
        summary["card"]["id"],
        summary["card"]["path"],
        summary["fingerprint"]["head_commit"],
        summary["fingerprint"]["tree_sha"],
        summary["fingerprint"]["diff_fingerprint"],
        summary["review_target_kind"],
    )):
        return summary
    return None


def current_card_locations(root: Path, card: str) -> list[str]:
    filename = Path(card).name
    seen: set[str] = set()
    locations: list[str] = []
    direct = root / card
    if direct.exists():
        relative = repository_relative(direct, root)
        seen.add(relative)
        locations.append(relative)
    for column in BOARD_COLUMNS:
        candidate = root / "openspec" / "board" / column / filename
        if not candidate.exists():
            continue
        relative = repository_relative(candidate, root)
        if relative not in seen:
            seen.add(relative)
            locations.append(relative)
    return sorted(locations)


def card_is_published(root: Path, card: str) -> bool:
    locations = current_card_locations(root, card)
    return bool(locations) and all(path.startswith("openspec/board/4.done/") for path in locations)


def load_plan(path: Path) -> tuple[dict[str, Any] | None, list[str]]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        return None, [f"plan cannot be read: {exc}"]
    except json.JSONDecodeError as exc:
        return None, [f"plan JSON is invalid: {exc}"]
    if not isinstance(data, dict):
        return None, ["plan must be a JSON object"]
    errors = schema_errors(data, "changerail-delivery-plan.schema.json")
    return data, errors


def plan_fingerprint(data: dict[str, Any]) -> str:
    encoded = json.dumps(data, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def plan_mode(args: argparse.Namespace, data: dict[str, Any] | None) -> str:
    if getattr(args, "no_push", False):
        return "no-push"
    if isinstance(data, dict) and data.get("push_mode") == "no-push":
        return "no-push"
    return "push"


def safe_plan_id(value: Any) -> str:
    text = str(value or "invalid-plan").strip().lower()
    cleaned = "".join(char if char.isalnum() else "-" for char in text)
    cleaned = "-".join(part for part in cleaned.split("-") if part)
    if not cleaned or not cleaned[0].isalnum():
        return "invalid-plan"
    return cleaned


def safe_generated_id(value: str) -> str:
    text = value.strip().lower()
    chars = [char if ("a" <= char <= "z" or "0" <= char <= "9") else "-" for char in text]
    cleaned = "-".join(part for part in "".join(chars).split("-") if part)
    if not cleaned or not ("a" <= cleaned[0] <= "z" or "0" <= cleaned[0] <= "9"):
        return ""
    return cleaned


def compact_reason(value: Any, limit: int = 160) -> str:
    text = " ".join(str(value or "").split())
    if len(text) <= limit:
        return text
    return text[: limit - 3].rstrip() + "..."


def nonnegative_int(value: Any) -> int | None:
    if isinstance(value, bool):
        return None
    if isinstance(value, int) and value >= 0:
        return value
    return None


def structured_output_sources(item: dict[str, Any]) -> list[dict[str, Any]]:
    sources = [item]
    for key in ("output", "outputs", "metadata"):
        value = item.get(key)
        if isinstance(value, dict):
            sources.append(value)
    return sources


def stream_payload(source: dict[str, Any], stream: str) -> Any:
    for key in (stream, f"{stream}_text", f"{stream}_output"):
        if key in source:
            return source[key]
    return None


def structured_stream_bytes(item: dict[str, Any], stream: str) -> int | None:
    keys = (
        f"{stream}_bytes",
        f"{stream}_byte_count",
        f"{stream}Bytes",
        f"{stream}ByteCount",
    )
    for source in structured_output_sources(item):
        for key in keys:
            value = nonnegative_int(source.get(key))
            if value is not None:
                return value
        payload = stream_payload(source, stream)
        if isinstance(payload, dict):
            for key in ("bytes", "byte_count", "size_bytes"):
                value = nonnegative_int(payload.get(key))
                if value is not None:
                    return value
        elif isinstance(payload, str):
            return len(payload.encode("utf-8"))
    return None


def structured_total_output_bytes(item: dict[str, Any], stdout_bytes: int | None, stderr_bytes: int | None) -> int | None:
    for source in structured_output_sources(item):
        for key in ("output_bytes", "output_byte_count", "total_output_bytes", "total_bytes"):
            value = nonnegative_int(source.get(key))
            if value is not None:
                return value
    known = [value for value in (stdout_bytes, stderr_bytes) if value is not None]
    if known:
        return sum(known)
    return None


def structured_bool(item: dict[str, Any], keys: tuple[str, ...]) -> bool | None:
    for source in structured_output_sources(item):
        for key in keys:
            value = source.get(key)
            if isinstance(value, bool):
                return value
        for stream in ("stdout", "stderr"):
            payload = stream_payload(source, stream)
            if isinstance(payload, dict):
                for key in keys:
                    value = payload.get(key)
                    if isinstance(value, bool):
                        return value
    return None


def structured_truncated(item: dict[str, Any]) -> bool | None:
    return structured_bool(
        item,
        (
            "truncated",
            "is_truncated",
            "output_truncated",
            "runner_truncated",
            "stdout_truncated",
            "stderr_truncated",
        ),
    )


def command_output_metadata(item: dict[str, Any], exit_code: int | None) -> dict[str, Any] | None:
    stdout_bytes = structured_stream_bytes(item, "stdout")
    stderr_bytes = structured_stream_bytes(item, "stderr")
    total_bytes = structured_total_output_bytes(item, stdout_bytes, stderr_bytes)
    truncated = structured_truncated(item)
    if stdout_bytes is None and stderr_bytes is None and total_bytes is None and truncated is None:
        return None

    threshold_exceeded = bool(total_bytes is not None and total_bytes > COMMAND_OUTPUT_THRESHOLD_BYTES)
    classification = "unknown"
    if truncated:
        classification = "runner_truncated"
    elif isinstance(exit_code, int) and exit_code != 0:
        classification = "process_failure"
    elif isinstance(exit_code, int) and exit_code == 0 and total_bytes is not None:
        classification = "success_oversized" if threshold_exceeded else "success_bounded"

    metadata: dict[str, Any] = {
        "threshold_bytes": COMMAND_OUTPUT_THRESHOLD_BYTES,
        "threshold_exceeded": threshold_exceeded,
        "classification": classification,
    }
    if stdout_bytes is not None:
        metadata["stdout_bytes"] = stdout_bytes
    if stderr_bytes is not None:
        metadata["stderr_bytes"] = stderr_bytes
    if total_bytes is not None:
        metadata["total_bytes"] = total_bytes
    if truncated is not None:
        metadata["truncated"] = truncated
    return metadata


def command_total_bytes(command: dict[str, Any]) -> int:
    output = command.get("output")
    if isinstance(output, dict):
        value = output.get("total_bytes")
        if isinstance(value, int) and value >= 0:
            return value
    return 0


def sanitize_command_label(command: Any, root: Path) -> str:
    label = sanitize_remote_detail(str(command or "unknown command"))
    runtime = root / ".runtime" / "changerail"
    label = label.replace(str(runtime), ".runtime/changerail/<runtime>")
    label = re.sub(r"(?<!\S)\.runtime/changerail/\S+", ".runtime/changerail/<runtime>", label)
    label = label.replace(str(root), "<workspace>")
    return compact_reason(label, MAX_COMMAND_LABEL_LENGTH)


def oversized_command_summary(command: dict[str, Any], root: Path) -> dict[str, Any]:
    output = command.get("output") if isinstance(command.get("output"), dict) else {}
    summary: dict[str, Any] = {
        "command": sanitize_command_label(command.get("command"), root),
        "total_bytes": command_total_bytes(command),
        "threshold_bytes": output.get("threshold_bytes", COMMAND_OUTPUT_THRESHOLD_BYTES),
        "classification": output.get("classification", "unknown"),
    }
    command_id = command.get("command_id")
    if isinstance(command_id, str) and command_id:
        summary["command_id"] = command_id
    for key in ("stdout_bytes", "stderr_bytes"):
        value = output.get(key)
        if isinstance(value, int) and value >= 0:
            summary[key] = value
    if isinstance(output.get("truncated"), bool):
        summary["truncated"] = output["truncated"]
    return summary


def command_output_summary(commands: list[dict[str, Any]], root: Path) -> dict[str, Any] | None:
    observed = [command for command in commands if isinstance(command.get("output"), dict)]
    if not observed:
        return None
    oversized = [
        command
        for command in observed
        if isinstance(command.get("output"), dict) and command["output"].get("threshold_exceeded") is True
    ]
    largest = max((command_total_bytes(command) for command in observed), default=0)
    summary: dict[str, Any] = {
        "threshold_bytes": COMMAND_OUTPUT_THRESHOLD_BYTES,
        "observed_command_count": len(observed),
        "oversized_command_count": len(oversized),
        "largest_command_bytes": largest,
    }
    if oversized:
        top = sorted(oversized, key=command_total_bytes, reverse=True)[:MAX_OVERSIZED_COMMANDS]
        summary["top_oversized_commands"] = [oversized_command_summary(command, root) for command in top]
    return summary


def oversized_command_lines(record: dict[str, Any]) -> list[str]:
    performance = record.get("performance")
    if not isinstance(performance, dict):
        return []
    output = performance.get("command_output")
    if not isinstance(output, dict) or not output.get("oversized_command_count"):
        return []
    threshold = output.get("threshold_bytes", COMMAND_OUTPUT_THRESHOLD_BYTES)
    largest = output.get("largest_command_bytes", "unknown")
    lines = [
        f"oversized_commands: count={output.get('oversized_command_count')} threshold_bytes={threshold} largest_command_bytes={largest}"
    ]
    top = output.get("top_oversized_commands")
    if isinstance(top, list):
        for command in top:
            if not isinstance(command, dict):
                continue
            lines.append(
                "oversized_command: "
                f"bytes={command.get('total_bytes', 'unknown')} "
                f"classification={command.get('classification', 'unknown')} "
                f"command={command.get('command', 'unknown command')}"
            )
    lines.append("remediation: use scoped paths, rg -l, counts, or bounded excerpts; treat truncated output as inconclusive.")
    return lines


def parse_key_value(value: str, label: str) -> tuple[str | None, str | None, str | None]:
    if "=" not in value:
        return None, None, f"{label} must use key=value syntax: {value}"
    key, item = value.split("=", 1)
    key = key.strip()
    item = item.strip()
    if not key or not item:
        return None, None, f"{label} must include non-empty key and value: {value}"
    return key, item, None


def generated_card_id(card_ref: str) -> str:
    return safe_generated_id(Path(card_ref).name.removesuffix(".md"))


def plan_runtime_root(args: argparse.Namespace) -> Path:
    return args.runtime_root


def plan_status_path(args: argparse.Namespace) -> Path:
    return plan_runtime_root(args) / args.run_id / "status.json"


def git_is_repo(root: Path) -> bool:
    result = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    return result.returncode == 0


def normalize_card_ref(card_ref: str) -> str:
    return Path(card_ref).name


def resolve_plan_card(workspace: Path, card_ref: str) -> tuple[str | None, list[str]]:
    errors: list[str] = []
    seen: set[str] = set()
    matches: list[str] = []
    direct = workspace / card_ref
    if direct.exists():
        relative = repository_relative(direct, workspace)
        seen.add(relative)
        matches.append(relative)
    filename = Path(card_ref).name
    for column in BOARD_COLUMNS:
        candidate = workspace / "openspec" / "board" / column / filename
        if not candidate.exists():
            continue
        relative = repository_relative(candidate, workspace)
        if relative not in seen:
            seen.add(relative)
            matches.append(relative)
    matches = sorted(matches)
    if not matches:
        errors.append(f"card not found: {card_ref}")
        return None, errors
    if len(matches) > 1:
        errors.append(f"card is ambiguous: {card_ref}: {', '.join(matches)}")
        return None, errors
    resolved = matches[0]
    if resolved.startswith("openspec/board/5.canceled/"):
        errors.append(f"card is canceled: {resolved}")
        return resolved, errors
    return resolved, errors


def check_plan_semantics(
    data: dict[str, Any],
    consumer_root: Path,
    allow_dirty_workspaces: set[str] | None = None,
) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[Check]]:
    checks: list[Check] = []
    allow_dirty_workspaces = allow_dirty_workspaces or set()
    workspaces = data.get("workspaces") if isinstance(data.get("workspaces"), list) else []
    cards = data.get("cards") if isinstance(data.get("cards"), list) else []
    waves = data.get("waves") if isinstance(data.get("waves"), list) else []

    workspace_by_alias: dict[str, dict[str, Any]] = {}
    resolved_workspaces: list[dict[str, Any]] = []
    seen_aliases: set[str] = set()
    for workspace in workspaces:
        if not isinstance(workspace, dict):
            continue
        alias = workspace.get("alias")
        path = workspace.get("path")
        if not isinstance(alias, str) or not isinstance(path, str):
            continue
        if alias in seen_aliases:
            checks.append(Check("duplicate workspace alias", "fail", alias))
        seen_aliases.add(alias)
        root = (consumer_root / path).resolve(strict=False)
        state = "preflighted"
        if not root.is_dir():
            state = "blocked"
            checks.append(Check("workspace exists", "fail", f"{alias}: {root}"))
        elif not git_is_repo(root):
            state = "blocked"
            checks.append(Check("workspace git repository", "fail", f"{alias}: {root}"))
        else:
            checks.append(Check("workspace", "pass", f"{alias}: {root}"))
            clean, clean_reason = git_clean(root)
            dirty_allowed = alias in allow_dirty_workspaces
            checks.append(
                Check(
                    "workspace dirty state",
                    "pass" if clean or dirty_allowed else "fail",
                    f"{alias}: {clean_reason}"
                    if clean or not dirty_allowed
                    else f"{alias}: retained investigation recovery will validate exact dirty payload",
                )
            )
            if not clean and not dirty_allowed:
                state = "blocked"
        entry = {"alias": alias, "path": path, "root": str(root), "state": state}
        workspace_by_alias[alias] = entry
        resolved_workspaces.append(entry)

    max_parallel = data.get("max_parallel", 1)
    if isinstance(max_parallel, int) and max_parallel >= 1:
        checks.append(Check("max_parallel", "pass", str(max_parallel)))
    else:
        checks.append(Check("max_parallel", "fail", "must be >= 1"))
    per_workspace = data.get("per_workspace_parallelism", 1)
    if per_workspace == 1:
        checks.append(Check("per_workspace_parallelism", "pass", "1"))
    else:
        checks.append(Check("per_workspace_parallelism", "fail", "must be 1"))

    wave_ids: set[int] = set()
    wave_deps: dict[int, list[int]] = {}
    for wave in waves:
        if not isinstance(wave, dict):
            continue
        wave_id = wave.get("id")
        if not isinstance(wave_id, int):
            continue
        if wave_id in wave_ids:
            checks.append(Check("duplicate wave", "fail", str(wave_id)))
        wave_ids.add(wave_id)
        dependencies = wave.get("depends_on", [])
        wave_deps[wave_id] = dependencies if isinstance(dependencies, list) else []
    for wave_id, dependencies in wave_deps.items():
        for dependency in dependencies:
            if dependency not in wave_ids:
                checks.append(Check("wave dependency", "fail", f"wave {wave_id} depends on missing wave {dependency}"))
            elif dependency >= wave_id:
                checks.append(Check("wave dependency", "fail", f"wave {wave_id} depends on non-earlier wave {dependency}"))

    card_ids: set[str] = set()
    card_refs: set[tuple[str, str]] = set()
    resolved_refs: set[tuple[str, str]] = set()
    card_waves: dict[str, int] = {}
    resolved_cards: list[dict[str, Any]] = []
    for card in cards:
        if not isinstance(card, dict):
            continue
        card_id = card.get("id")
        workspace_alias = card.get("workspace")
        card_ref = card.get("card")
        if not isinstance(card_id, str) or not isinstance(workspace_alias, str) or not isinstance(card_ref, str):
            continue
        if card_id in card_ids:
            checks.append(Check("duplicate card id", "fail", card_id))
        card_ids.add(card_id)
        ref_key = (workspace_alias, normalize_card_ref(card_ref))
        if ref_key in card_refs:
            checks.append(Check("duplicate card", "fail", f"{workspace_alias}:{card_ref}"))
        card_refs.add(ref_key)

        workspace_entry = workspace_by_alias.get(workspace_alias)
        entry: dict[str, Any] = {
            "id": card_id,
            "workspace": workspace_alias,
            "card": card_ref,
            "state": "ready",
        }
        if isinstance(card.get("depends_on"), list):
            entry["depends_on"] = card["depends_on"]
        if isinstance(card.get("recovery_for"), str):
            entry["recovery_for"] = card["recovery_for"]
        wave = card.get("wave")
        if isinstance(wave, int):
            entry["wave"] = wave
            card_waves[card_id] = wave
            if wave_ids and wave not in wave_ids:
                checks.append(Check("card wave", "fail", f"{card_id}: missing wave {wave}"))
        if workspace_entry is None:
            entry["state"] = "blocked"
            entry["reason"] = "workspace not declared"
            checks.append(Check("card workspace", "fail", f"{card_id}: {workspace_alias}"))
            resolved_cards.append(entry)
            continue
        resolved_path, card_errors = resolve_plan_card(Path(workspace_entry["root"]), card_ref)
        if resolved_path:
            entry["resolved_path"] = resolved_path
            resolved_key = (workspace_alias, resolved_path)
            if resolved_key in resolved_refs:
                entry["state"] = "blocked"
                entry["reason"] = "duplicate resolved card"
                checks.append(Check("duplicate resolved card", "fail", f"{workspace_alias}:{resolved_path}"))
            resolved_refs.add(resolved_key)
        if card_errors:
            entry["state"] = "blocked"
            entry["reason"] = "; ".join(card_errors)
            for error in card_errors:
                checks.append(Check("card resolution", "fail", f"{card_id}: {error}"))
        else:
            checks.append(Check("card resolution", "pass", f"{card_id}: {resolved_path}"))
        resolved_cards.append(entry)

    card_by_id = {
        card.get("id"): card
        for card in cards
        if isinstance(card, dict) and isinstance(card.get("id"), str)
    }
    recovery_sources: set[str] = set()
    for card in cards:
        if not isinstance(card, dict) or not isinstance(card.get("id"), str):
            continue
        card_id = card["id"]
        wave = card_waves.get(card_id)
        for dependency in card.get("depends_on", []) if isinstance(card.get("depends_on"), list) else []:
            if dependency not in card_ids:
                checks.append(Check("card dependency", "fail", f"{card_id}: missing {dependency}"))
                continue
            dependency_wave = card_waves.get(dependency)
            if isinstance(wave, int) and isinstance(dependency_wave, int) and dependency_wave > wave:
                checks.append(Check("card dependency", "fail", f"{card_id}: dependency {dependency} is in later wave"))
        recovery_for = card.get("recovery_for")
        if isinstance(recovery_for, str):
            if recovery_for == card_id:
                checks.append(Check("card recovery", "fail", f"{card_id}: recovery_for points to itself"))
            elif recovery_for not in card_ids:
                checks.append(Check("card recovery", "fail", f"{card_id}: missing source {recovery_for}"))
            elif recovery_for in recovery_sources:
                checks.append(Check("card recovery", "fail", f"{recovery_for}: multiple recovery cards"))
            else:
                source = card_by_id[recovery_for]
                if isinstance(source.get("recovery_for"), str):
                    checks.append(Check("card recovery", "fail", f"{card_id}: recovery source cannot itself be a recovery"))
                if card.get("workspace") != source.get("workspace"):
                    checks.append(Check("card recovery", "fail", f"{card_id}: recovery must share source workspace"))
                if card.get("wave", 1) != source.get("wave", 1):
                    checks.append(Check("card recovery", "fail", f"{card_id}: recovery must share source wave"))
                card_dependencies = card.get("depends_on", []) if isinstance(card.get("depends_on"), list) else []
                source_dependencies = source.get("depends_on", []) if isinstance(source.get("depends_on"), list) else []
                if card_dependencies != source_dependencies:
                    checks.append(Check("card recovery", "fail", f"{card_id}: recovery must inherit source dependencies"))
                recovery_sources.add(recovery_for)
    cycle = find_card_cycle(cards)
    if cycle:
        checks.append(Check("card dependency cycle", "fail", " -> ".join(cycle)))
    elif cards:
        checks.append(Check("card dependency cycle", "pass", "none"))

    return resolved_workspaces, resolved_cards, checks


def find_card_cycle(cards: list[Any]) -> list[str]:
    graph: dict[str, list[str]] = {}
    for card in cards:
        if not isinstance(card, dict) or not isinstance(card.get("id"), str):
            continue
        graph[card["id"]] = [dep for dep in card.get("depends_on", []) if isinstance(dep, str)]
    visiting: set[str] = set()
    visited: set[str] = set()
    stack: list[str] = []

    def visit(node: str) -> list[str] | None:
        if node in visiting:
            start = stack.index(node) if node in stack else 0
            return stack[start:] + [node]
        if node in visited:
            return None
        visiting.add(node)
        stack.append(node)
        for dependency in graph.get(node, []):
            if dependency not in graph:
                continue
            cycle = visit(dependency)
            if cycle:
                return cycle
        stack.pop()
        visiting.remove(node)
        visited.add(node)
        return None

    for node in graph:
        cycle = visit(node)
        if cycle:
            return cycle
    return []


def child_run_id(args: argparse.Namespace, card: dict[str, Any]) -> str:
    return f"{args.run_id}-{card['id']}"


def child_runtime_root(workspace: dict[str, Any]) -> Path:
    return Path(workspace["root"]) / ".runtime" / "changerail" / "delivery-runs"


def child_status_path_for(args: argparse.Namespace, card: dict[str, Any], workspace: dict[str, Any]) -> Path:
    return child_runtime_root(workspace) / child_run_id(args, card) / "status.json"


def child_command_for_card(args: argparse.Namespace, card: dict[str, Any], workspace: dict[str, Any], mode: str) -> list[str]:
    card_path = card.get("resolved_path") or card["card"]
    resume_status_path = card.get("resume_status_path")
    if isinstance(resume_status_path, str) and resume_status_path:
        status_path_value = resolve_path(Path(resume_status_path), args.consumer_root)
        command = [
            str(args.launcher),
            "resume",
            card_path,
            "--status-path",
            str(status_path_value),
            "--workspace",
            workspace["root"],
            "--runtime-root",
            str(child_runtime_root(workspace)),
            "--run-id",
            child_run_id(args, card),
        ]
    else:
        command = [
            str(args.launcher),
            "run",
            card_path,
            "--workspace",
            workspace["root"],
            "--runtime-root",
            str(child_runtime_root(workspace)),
            "--run-id",
            child_run_id(args, card),
        ]
    if card.get("model"):
        command.extend(["--model", str(card["model"])])
    if card.get("reasoning_effort"):
        command.extend(["--reasoning-effort", str(card["reasoning_effort"])])
    if mode == "no-push":
        command.append("--deliver-arg=--no-push")
    return command


def apply_plan_card_overrides(data: dict[str, Any], cards: list[dict[str, Any]]) -> None:
    sources = {
        item.get("id"): item
        for item in data.get("cards", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }
    for card in cards:
        source = sources.get(card["id"])
        if not isinstance(source, dict):
            continue
        if isinstance(source.get("model"), str):
            card["model"] = source["model"]
        if isinstance(source.get("reasoning_effort"), str):
            card["reasoning_effort"] = source["reasoning_effort"]


def append_single_card_preflight_checks(
    args: argparse.Namespace,
    cards: list[dict[str, Any]],
    workspaces: dict[str, dict[str, Any]],
    checks: list[Check],
    mode: str,
) -> None:
    for card in cards:
        if card.get("state") == "blocked":
            continue
        workspace = workspaces.get(card["workspace"])
        if not workspace:
            continue
        child_preflight_run_id = child_run_id(args, card) + "-preflight"
        child_status_path = child_runtime_root(workspace) / child_preflight_run_id / "status.json"
        command = [
            str(args.launcher),
            "preflight",
            card.get("resolved_path") or card["card"],
            "--workspace",
            workspace["root"],
            "--runtime-root",
            str(child_runtime_root(workspace)),
            "--run-id",
            child_preflight_run_id,
            "--json",
            "--write-status",
        ]
        if mode == "no-push":
            command.append("--deliver-arg=--no-push")
        result = subprocess.run(command, cwd=Path(workspace["root"]), capture_output=True, text=True, check=False)
        if result.returncode == 0:
            checks.append(Check("single-card preflight", "pass", f"{card['id']}: ready"))
        else:
            card["run_id"] = child_preflight_run_id
            card["run_status_path"] = repository_relative(child_status_path, args.consumer_root)
            child_status = load_json_object(child_status_path)
            failed = first_failed_child_check(child_status)
            if failed:
                name, reason, failure_class = failed
                compact = f"{name} fail: {reason}"
                if failure_class:
                    card["failure_class"] = failure_class
            else:
                compact = f"child preflight failed: status missing or invalid; exit {result.returncode}"
            card["state"] = "blocked"
            card["reason"] = compact
            checks.append(Check("single-card preflight", "fail", f"{card['id']}: {compact}"))


def first_failed_child_check(child_status: dict[str, Any] | None) -> tuple[str, str, str | None] | None:
    if not isinstance(child_status, dict):
        return None
    checks = child_status.get("preflight", {}).get("checks")
    if not isinstance(checks, list):
        return None
    for check in checks:
        if not isinstance(check, dict) or check.get("status") != "fail":
            continue
        name = compact_reason(check.get("name") or "child preflight")
        message = compact_reason(check.get("message") or "failed")
        failure_class = check.get("failure_class")
        if not isinstance(failure_class, str):
            failure_class = None
        if failure_class:
            message = f"{failure_class}: {message}"
        return name, message, failure_class
    return None


def compact_plan_failure_lines(status: dict[str, Any]) -> list[str]:
    cards = status.get("cards")
    if not isinstance(cards, list):
        return []
    lines: list[str] = []
    for card in cards:
        if not isinstance(card, dict) or card.get("state") != "blocked":
            continue
        reason = card.get("reason")
        status_path = card.get("run_status_path")
        if not isinstance(reason, str) or not isinstance(status_path, str):
            continue
        card_id = card.get("id") if isinstance(card.get("id"), str) else "unknown-card"
        lines.append(f"{card_id}: {compact_reason(reason)} (status: {status_path})")
    return lines


def print_compact_plan_failures(status: dict[str, Any]) -> None:
    for line in compact_plan_failure_lines(status):
        print(f"- {line}")


def build_plan_view(
    args: argparse.Namespace,
    data: dict[str, Any],
    include_child_preflight: bool = False,
) -> tuple[dict[str, Any], dict[str, Any]]:
    workspaces, cards, checks = check_plan_semantics(data, args.consumer_root)
    checks.append(Check("single-card runner exists", "pass" if args.launcher.is_file() else "fail", str(args.launcher)))
    checks.append(Check("single-card runner executable", "pass" if os.access(args.launcher, os.X_OK) else "fail", str(args.launcher)))
    workspace_by_alias = {workspace["alias"]: workspace for workspace in workspaces}
    apply_plan_card_overrides(data, cards)
    mode = plan_mode(args, data)
    if include_child_preflight and all(check.status != "fail" for check in checks):
        append_single_card_preflight_checks(args, cards, workspace_by_alias, checks, mode)
    status_result = "DELIVERED" if all(check.status != "fail" for check in checks) else "BLOCKED"
    for card in cards:
        workspace = workspace_by_alias.get(card["workspace"])
        if workspace and card["state"] != "blocked":
            card["command"] = child_command_for_card(args, card, workspace, mode)
    status = plan_status_record(args, data, workspaces, cards, checks, "preflight", status_result)
    view = {
        "result": status_result,
        "status_path": str(plan_status_path(args)),
        "plan": status["plan"],
        "mode": mode,
        "workspaces": workspaces,
        "cards": cards,
        "checks": [check_payload(check) for check in checks],
    }
    return view, status


def plan_status_record(
    args: argparse.Namespace,
    data: dict[str, Any],
    workspaces: list[dict[str, Any]],
    cards: list[dict[str, Any]],
    checks: list[Check],
    phase: str,
    result: str,
    locks: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    status_cards: list[dict[str, Any]] = []
    for card in cards:
        entry = {
            key: card[key]
            for key in (
                "id",
                "workspace",
                "card",
                "resolved_path",
                "state",
                "wave",
                "depends_on",
                "recovery_for",
                "run_id",
                "run_status_path",
                "result",
                "terminal_reason",
                "retained_recovery",
                "failure_class",
                "recovered_by",
                "upstream_state",
                "upstream_detail",
                "started_at",
                "ended_at",
                "reason",
            )
            if key in card
        }
        if entry.get("state") == "ready" and result == "DELIVERED":
            entry["state"] = "ready"
        status_cards.append(entry)
    status_workspaces = [
        {key: workspace[key] for key in ("alias", "path", "state", "reason") if key in workspace}
        for workspace in workspaces
    ]
    record: dict[str, Any] = {
        "schema": PLAN_STATUS_SCHEMA,
        "run_id": args.run_id,
        "updated_at": utc_now(),
        "plan": {
            "id": data["id"],
            "path": repository_relative(args.plan, args.consumer_root),
            "fingerprint": plan_fingerprint(data),
        },
        "phase": phase,
        "result": result,
        "mode": plan_mode(args, data),
        "timestamps": {
            "started_at": args.started_at,
            "ended_at": utc_now(),
        },
        "max_parallel": data.get("max_parallel", 1),
        "per_workspace_parallelism": data.get("per_workspace_parallelism", 1),
        "workspaces": status_workspaces,
        "cards": status_cards,
        "checks": [check_payload(check) for check in checks],
        "summary": {
            "total_cards": len(status_cards),
            "delivered": sum(1 for card in status_cards if card.get("state") == "delivered"),
            "blocked": sum(1 for card in status_cards if card.get("state") == "blocked"),
            "no_go": sum(1 for card in status_cards if card.get("state") == "no-go"),
            "skipped": sum(1 for card in status_cards if card.get("state") == "skipped"),
            "recovered": sum(1 for card in status_cards if card.get("state") == "recovered"),
        },
    }
    if result != "RUNNING":
        record["terminal_outcome"] = result
    if locks:
        record["locks"] = locks
    errors = schema_errors(record, "changerail-delivery-plan-status.schema.json")
    if errors:
        record["checks"].append({"name": "status schema", "status": "fail", "message": "; ".join(errors)})
        record["result"] = "BLOCKED"
        record["terminal_outcome"] = "BLOCKED"
    return record


def changed_path_count(root: Path) -> int | None:
    result = subprocess.run(
        ["git", "-C", str(root), "status", "--porcelain"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    return sum(1 for line in result.stdout.splitlines() if line.strip())


def review_history_path(root: Path, card: str) -> Path:
    return root / ".runtime" / "changerail" / "reviews" / f"{card_id(card)}.history.json"


def delivery_manifest_path(root: Path, card: str) -> Path:
    return root / ".runtime" / "changerail" / "delivery-manifests" / f"{card_id(card)}.json"


def load_json_object(path: Path) -> dict[str, Any] | None:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return payload if isinstance(payload, dict) else None


def review_timing(root: Path, card: str, started_at: str) -> dict[str, Any] | None:
    history = load_json_object(review_history_path(root, card))
    cycles = history.get("cycles") if history else None
    if not isinstance(cycles, list):
        return None
    started = parse_utc(started_at)
    entries: list[dict[str, Any]] = []
    previous_reviewed: datetime | None = None
    final_go: datetime | None = None
    first_reviewed: datetime | None = None
    for cycle in cycles:
        if not isinstance(cycle, dict):
            continue
        review_cycle = cycle.get("review_cycle")
        if not isinstance(review_cycle, int):
            continue
        entry: dict[str, Any] = {"review_cycle": review_cycle}
        result = cycle.get("result")
        if result in {"go", "no-go"}:
            entry["result"] = result
        reviewed_at_raw = cycle.get("reviewed_at")
        reviewed_at = parse_utc(reviewed_at_raw if isinstance(reviewed_at_raw, str) else None)
        if isinstance(reviewed_at_raw, str):
            entry["reviewed_at"] = reviewed_at_raw
        if reviewed_at is not None:
            if first_reviewed is None:
                first_reviewed = reviewed_at
            latency = elapsed_seconds(started, reviewed_at)
            if latency is not None:
                entry["latency_seconds"] = latency
            since_previous = elapsed_seconds(previous_reviewed, reviewed_at)
            if since_previous is not None:
                entry["since_previous_seconds"] = since_previous
            previous_reviewed = reviewed_at
            if result == "go":
                final_go = reviewed_at
        entries.append(entry)
    if not entries:
        return None
    summary: dict[str, Any] = {
        "cycle_count": len(entries),
        "cycles": entries,
    }
    first_latency = elapsed_seconds(started, first_reviewed)
    if first_latency is not None:
        summary["first_review_latency_seconds"] = first_latency
    final_latency = elapsed_seconds(started, final_go)
    if final_latency is not None:
        summary["time_to_final_go_seconds"] = final_latency
    return summary


def publish_timing(root: Path, card: str, started_at: str) -> dict[str, Any] | None:
    manifest = load_json_object(delivery_manifest_path(root, card))
    publish = manifest.get("publish") if manifest else None
    if not isinstance(publish, dict):
        return None
    pushed_at_raw = publish.get("pushed_at")
    if not isinstance(pushed_at_raw, str):
        return None
    started = parse_utc(started_at)
    pushed_at = parse_utc(pushed_at_raw)
    summary: dict[str, Any] = {"pushed_at": pushed_at_raw}
    latency = elapsed_seconds(started, pushed_at)
    if latency is not None:
        summary["latency_seconds"] = latency
    return summary


class PerformanceCollector:
    def __init__(self, root: Path) -> None:
        self.root = root
        self.started_monotonic = time.monotonic()
        self.event_counts: dict[str, int] = {}
        self.agent_message_count = 0
        self.command_starts: dict[str, dict[str, Any]] = {}
        self.commands: list[dict[str, Any]] = []
        self.timeline: list[dict[str, Any]] = []

    def observe_line(self, line: str) -> None:
        observed_at = utc_now()
        observed_monotonic = time.monotonic()
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            return
        if not isinstance(event, dict):
            return
        event_type = self.event_type(event)
        self.event_counts[event_type] = self.event_counts.get(event_type, 0) + 1
        item = event.get("item") if isinstance(event.get("item"), dict) else {}
        item_type = item.get("type")
        if item_type == "agent_message" or event_type in {"assistant-message", "agent_message"}:
            self.agent_message_count += 1
        timeline_entry: dict[str, Any] = {
            "observed_at": observed_at,
            "event_type": event_type,
        }
        event_id = event.get("id")
        if isinstance(event_id, str) and event_id:
            timeline_entry["event_id"] = event_id
        item_id = item.get("id")
        if isinstance(item_id, str) and item_id:
            timeline_entry["item_id"] = item_id
        signal = event_terminal_signal(event)
        if signal.outcome:
            timeline_entry["terminal_outcome"] = signal.outcome
        if signal.reason:
            timeline_entry["terminal_reason"] = signal.reason
        if item_type == "command_execution":
            self.observe_command(item, event_type, observed_at, observed_monotonic, timeline_entry)
        self.append_timeline(timeline_entry)

    def event_type(self, event: dict[str, Any]) -> str:
        for key in ("type", "event", "name"):
            value = event.get(key)
            if isinstance(value, str) and value:
                return value
        return "unknown"

    def observe_command(
        self,
        item: dict[str, Any],
        event_type: str,
        observed_at: str,
        observed_monotonic: float,
        timeline_entry: dict[str, Any],
    ) -> None:
        command_id = item.get("id")
        if not isinstance(command_id, str) or not command_id:
            command_id = f"command-{len(self.command_starts) + len(self.commands) + 1}"
        command = item.get("command")
        timeline_entry["command_id"] = command_id
        if isinstance(command, str) and command:
            timeline_entry["command"] = sanitize_command_label(command, self.root)
        status = item.get("status")
        if event_type.endswith(".started") or status == "in_progress":
            self.command_starts[command_id] = {
                "command_id": command_id,
                "command": command if isinstance(command, str) else None,
                "started_at": observed_at,
                "started_monotonic": observed_monotonic,
            }
            return
        if event_type.endswith(".completed") or status == "completed":
            start = self.command_starts.pop(command_id, {})
            summary: dict[str, Any] = {"command_id": command_id}
            command_value = command if isinstance(command, str) else start.get("command")
            if isinstance(command_value, str) and command_value:
                summary["command"] = sanitize_command_label(command_value, self.root)
            started_at = start.get("started_at")
            if isinstance(started_at, str):
                summary["started_at"] = started_at
            summary["ended_at"] = observed_at
            started_monotonic = start.get("started_monotonic")
            if isinstance(started_monotonic, (int, float)):
                duration = round(max(0.0, observed_monotonic - float(started_monotonic)), 6)
                summary["duration_seconds"] = duration
                timeline_entry["duration_seconds"] = duration
            exit_code = item.get("exit_code")
            if isinstance(exit_code, int):
                summary["exit_code"] = exit_code
            output = command_output_metadata(item, exit_code if isinstance(exit_code, int) else None)
            if output:
                summary["output"] = output
            self.commands.append(summary)

    def append_timeline(self, entry: dict[str, Any]) -> None:
        if len(self.timeline) >= MAX_TIMELINE_EVENTS:
            self.timeline.pop(0)
        self.timeline.append(entry)

    def record_terminal(self, outcome: str, reason: str | None = None) -> None:
        entry = {
            "observed_at": utc_now(),
            "event_type": "terminal_outcome",
            "terminal_outcome": outcome,
        }
        if reason:
            entry["terminal_reason"] = reason
        self.append_timeline(entry)

    def summary(self, root: Path, card: str, started_at: str) -> dict[str, Any]:
        data: dict[str, Any] = {
            "wall_time_seconds": round(max(0.0, time.monotonic() - self.started_monotonic), 3),
        }
        if self.event_counts:
            data["event_counts"] = dict(sorted(self.event_counts.items()))
        data["agent_message_count"] = self.agent_message_count
        data["command_execution_count"] = len(self.commands)
        changed = changed_path_count(root)
        if changed is not None:
            data["file_change_count"] = changed
        if self.commands:
            commands = self.commands[-MAX_COMMANDS:]
            data["commands"] = commands
            data["slowest_commands"] = sorted(
                commands,
                key=lambda command: command.get("duration_seconds", -1),
                reverse=True,
            )[:MAX_SLOW_COMMANDS]
            output_summary = command_output_summary(self.commands, root)
            if output_summary:
                data["command_output"] = output_summary
        if self.timeline:
            data["timeline"] = self.timeline
        review = review_timing(root, card, started_at)
        if review:
            data["review"] = review
        publish = publish_timing(root, card, started_at)
        if publish:
            data["publish"] = publish
        return data


def base_record(args: argparse.Namespace, phase: str, result: str) -> dict[str, Any]:
    root = args.workspace.resolve(strict=False)
    record: dict[str, Any] = {
        "schema": SCHEMA,
        "run_id": args.run_id,
        "updated_at": utc_now(),
        "workspace": {
            "root": str(root),
            "repository": root.name,
        },
        "card": {
            "id": card_id(args.card),
            "path": args.card,
        },
        "phase": phase,
        "result": result,
        "timestamps": {
            "started_at": args.started_at,
        },
        "command": {
            "argv": [],
            "launcher": str(args.launcher),
            "stdin": "closed",
            "json": True,
        },
        "usage": {
            "available": False,
            "reason": "usage not observed",
        },
    }
    record_commit(record, root)
    if args.model:
        record["command"]["model"] = args.model
    if args.reasoning_effort:
        record["command"]["reasoning_effort"] = args.reasoning_effort
    return record


def status_path(args: argparse.Namespace) -> Path:
    return args.runtime_root / args.run_id / "status.json"


def log_paths(args: argparse.Namespace) -> tuple[Path, Path]:
    run_dir = args.runtime_root / args.run_id
    return run_dir / "stdout.jsonl", run_dir / "stderr.log"


def check_preflight(args: argparse.Namespace, allow_dirty_workspace: bool = False) -> list[Check]:
    root = args.workspace.resolve(strict=False)
    launcher = args.launcher
    env = child_environment(args)
    codex_home = effective_codex_home(args)
    config = codex_home / "config.toml"
    stale = stale_symlinks(codex_home)
    clean, clean_reason = git_clean(root)
    checks = [
        Check("workspace", "pass" if root.is_dir() else "fail", str(root)),
        Check(
            "workspace dirty state",
            "pass" if clean or allow_dirty_workspace else "fail",
            clean_reason
            if clean or not allow_dirty_workspace
            else "dirty tree accepted only after retained-payload fingerprint validation",
        ),
        Check("CODEX_WORKDIR", "pass", env["CODEX_WORKDIR"]),
        Check("launcher exists", "pass" if launcher.is_file() else "fail", str(launcher)),
        Check("launcher executable", "pass" if os.access(launcher, os.X_OK) else "fail", str(launcher)),
        Check("CODEX_HOME", "pass" if codex_home.exists() else "fail", str(codex_home)),
        Check("CODEX config", "pass" if config.is_file() else "skip", str(config)),
        codex_automation_authority_state(config),
        auth_state(codex_home, env),
        Check(
            "CODEX_HOME symlinks",
            "pass" if not stale else "fail",
            "no stale symlinks" if not stale else f"stale symlinks: {', '.join(stale[:10])}; {AUTH_REMEDIATION}",
        ),
        codex_binary_state(launcher),
        publish_target_state(args),
    ]
    if args.connectivity_url:
        try:
            with urllib.request.urlopen(connectivity_probe_url(args.connectivity_url), timeout=args.connectivity_timeout) as response:
                checks.append(Check("connectivity", "pass", f"{sanitized_endpoint(args.connectivity_url)} status={response.status}"))
        except (OSError, urllib.error.URLError) as exc:
            checks.append(Check("connectivity", "fail", f"{sanitized_endpoint(args.connectivity_url)} error={exc.__class__.__name__}"))
    else:
        checks.append(Check("connectivity", "skip", "no connectivity URL provided"))
    return checks


def codex_automation_authority_state(config: Path) -> Check:
    expected = 'approval_policy="never" and sandbox_mode="danger-full-access"'
    if not config.is_file():
        return Check(
            "Codex automation authority",
            "fail",
            f"effective config.toml is missing; unattended delivery requires {expected}",
        )
    try:
        with config.open("rb") as handle:
            payload = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError):
        return Check(
            "Codex automation authority",
            "fail",
            f"effective config.toml cannot be parsed; unattended delivery requires {expected}",
        )
    if payload.get("approval_policy") == "never" and payload.get("sandbox_mode") == "danger-full-access":
        return Check("Codex automation authority", "pass", expected)
    return Check(
        "Codex automation authority",
        "fail",
        f"effective config.toml does not grant unattended delivery authority; expected {expected}",
    )


def build_command(args: argparse.Namespace) -> list[str]:
    prompt = "$changerail-deliver " + args.card
    for value in args.deliver_arg:
        prompt += " " + value
    prompt += "\n\nChangeRail child discovery policy:\n" + child_discovery_policy()
    command = [str(args.launcher), "exec", "--json"]
    if args.model:
        command.extend(["-m", args.model])
    if args.reasoning_effort:
        command.extend(["-c", f'model_reasoning_effort="{args.reasoning_effort}"'])
    command.append(prompt)
    return command


def parse_usage(stdout_path: Path) -> dict[str, Any]:
    usage: dict[str, Any] = {
        "available": False,
        "reason": "usage not observed",
    }
    try:
        lines = stdout_path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return usage
    for line in lines:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        candidate = event.get("usage") if isinstance(event, dict) else None
        if not isinstance(candidate, dict):
            candidate = event.get("token_usage") if isinstance(event, dict) else None
        if not isinstance(candidate, dict):
            continue
        parsed = {"available": True}
        for source, target in (
            ("input_tokens", "input_tokens"),
            ("prompt_tokens", "input_tokens"),
            ("output_tokens", "output_tokens"),
            ("completion_tokens", "output_tokens"),
            ("cached_input_tokens", "cached_input_tokens"),
            ("input_cached_tokens", "cached_input_tokens"),
            ("uncached_input_tokens", "uncached_input_tokens"),
            ("reasoning_tokens", "reasoning_tokens"),
            ("total_tokens", "total_tokens"),
        ):
            value = candidate.get(source)
            if isinstance(value, int) and value >= 0:
                parsed[target] = value
        for source, target in (
            ("prompt_tokens_details", "cached_input_tokens"),
            ("input_tokens_details", "cached_input_tokens"),
        ):
            details = candidate.get(source)
            if isinstance(details, dict):
                value = details.get("cached_tokens")
                if isinstance(value, int) and value >= 0:
                    parsed[target] = value
        for source in ("completion_tokens_details", "output_tokens_details"):
            details = candidate.get(source)
            if isinstance(details, dict):
                value = details.get("reasoning_tokens")
                if isinstance(value, int) and value >= 0:
                    parsed["reasoning_tokens"] = value
        return parsed
    return usage


def normalize_terminal_value(value: str) -> str | None:
    normalized = value.strip().lower().replace("_", "-").replace(" ", "-")
    if not normalized:
        return None
    if normalized in {"delivered", "delivery/delivered"}:
        return "DELIVERED"
    if normalized in {"no-go", "nogo"} or normalized.endswith("/no-go"):
        return "NO-GO"
    if "awaiting-review" in normalized or normalized in {"awaiting-external-review", "awaiting-review"}:
        return "BLOCKED"
    if normalized in {"blocked", "delivery/blocked"}:
        return "BLOCKED"
    return None


def normalize_terminal_reason(value: str) -> str | None:
    normalized = value.strip()
    if not normalized:
        return None
    if not all(character.isalnum() or character == "_" for character in normalized):
        return None
    if not normalized[0].isalnum() or normalized != normalized.lower():
        return None
    return normalized


def event_type(event: dict[str, Any]) -> str:
    for key in ("type", "event", "name"):
        value = event.get(key)
        if isinstance(value, str) and value:
            return value
    return "unknown"


def agent_message_text(event: dict[str, Any]) -> str | None:
    if event_type(event) != "item.completed":
        return None
    item = event.get("item")
    if not isinstance(item, dict) or item.get("type") != "agent_message":
        return None
    for key in ("text", "content", "message"):
        value = item.get(key)
        if isinstance(value, str):
            return value
    content = item.get("content")
    if isinstance(content, list):
        parts: list[str] = []
        for part in content:
            if isinstance(part, dict):
                text = part.get("text")
                if isinstance(text, str):
                    parts.append(text)
        if parts:
            return "\n".join(parts)
    return None


def terminal_signal_from_marker_lines(text: str) -> TerminalSignal:
    signal = TerminalSignal()
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if line.startswith("terminal_outcome: "):
            signal.outcome = normalize_terminal_value(line.removeprefix("terminal_outcome: "))
        elif line.startswith("terminal_reason: "):
            raw_reason = line.removeprefix("terminal_reason: ")
            signal.reason = normalize_terminal_reason(raw_reason) or "malformed_terminal_reason"
    if signal.outcome is None:
        signal.reason = None
    return signal


def event_terminal_signal(event: Any) -> TerminalSignal:
    signal = TerminalSignal()
    if not isinstance(event, dict):
        return signal
    for key in ("type", "event", "name"):
        value = event.get(key)
        if isinstance(value, str):
            outcome = normalize_terminal_value(value)
            if outcome:
                signal.outcome = outcome
                break
    for key in TERMINAL_FIELD_KEYS:
        value = event.get(key)
        if isinstance(value, str):
            outcome = normalize_terminal_value(value)
            if outcome:
                signal.outcome = outcome
                break
    for key in TERMINAL_REASON_KEYS:
        value = event.get(key)
        if isinstance(value, str):
            signal.reason = normalize_terminal_reason(value) or "malformed_terminal_reason"
            break
    marker = agent_message_text(event)
    if marker:
        marker_signal = terminal_signal_from_marker_lines(marker)
        if marker_signal.outcome:
            signal = marker_signal
    if signal.outcome is None:
        signal.reason = None
    return signal


def event_terminal_outcome(event: Any) -> str | None:
    return event_terminal_signal(event).outcome


def stdout_terminal_signal(stdout_path: Path) -> TerminalSignal:
    try:
        text = stdout_path.read_text(encoding="utf-8")
    except OSError:
        return TerminalSignal()
    signal = TerminalSignal()
    for line in text.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        candidate = event_terminal_signal(event)
        if candidate.outcome:
            signal = candidate
    return signal


def review_verdict_path(root: Path, card: str) -> Path:
    return root / ".runtime" / "changerail" / "reviews" / f"{card_id(card)}.json"


def review_verdict_fallback_signal(args: argparse.Namespace) -> TerminalSignal:
    root = args.workspace.resolve(strict=False)
    verdict = review_verdict_path(root, args.card)
    if not verdict.is_file() or card_is_published(root, args.card):
        return TerminalSignal()

    helper = repo_root_from_script() / "scripts" / "changerail_review_verdict.py"
    if not helper.is_file():
        return TerminalSignal("BLOCKED", "review_verdict_helper_unavailable")
    result = subprocess.run(
        [
            sys.executable,
            str(helper),
            "validate",
            str(verdict),
            "--check-fresh",
            "--workspace",
            str(root),
            "--json",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return TerminalSignal("BLOCKED", "review_verdict_invalid")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        return TerminalSignal("BLOCKED", "review_verdict_invalid")
    if payload.get("result") == "no-go":
        return TerminalSignal("NO-GO")
    if payload.get("result") == "go":
        return TerminalSignal("BLOCKED", "unpublished_go_verdict")
    return TerminalSignal()


def fallback_terminal_signal(args: argparse.Namespace, exit_code: int, structured_signal: TerminalSignal) -> TerminalSignal:
    if structured_signal.outcome:
        return structured_signal
    review_signal = review_verdict_fallback_signal(args)
    if review_signal.outcome:
        return review_signal
    if exit_code != 0:
        return TerminalSignal("BLOCKED")
    root = args.workspace.resolve(strict=False)
    if card_is_published(root, args.card):
        return TerminalSignal("DELIVERED")
    return TerminalSignal("BLOCKED", "unpublished_card")


def command_preflight(args: argparse.Namespace) -> int:
    args.started_at = utc_now()
    checks = check_preflight(args)
    record = base_record(args, "preflight", "DELIVERED" if all(c.status != "fail" for c in checks) else "BLOCKED")
    record["preflight"] = {"checks": [check_payload(check) for check in checks]}
    record["timestamps"]["ended_at"] = utc_now()
    record_commit(record, args.workspace.resolve(strict=False))
    if args.write_status:
        atomic_write_json(status_path(args), record)
    print(json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) if args.json else record["result"])
    return 0 if record["result"] == "DELIVERED" else 1


def run_single_card_delivery(args: argparse.Namespace, checks: list[Check]) -> int:
    root = args.workspace.resolve(strict=False)
    args.runtime_root.mkdir(parents=True, exist_ok=True)
    stdout_path, stderr_path = log_paths(args)
    command = build_command(args)
    record = base_record(args, "delivery", "RUNNING")
    record["command"]["argv"] = command
    record["preflight"] = {"checks": [check_payload(check) for check in checks]}
    record["logs"] = {"stdout": str(stdout_path), "stderr": str(stderr_path)}
    if any(check.status == "fail" for check in checks):
        record["phase"] = "terminal"
        record["result"] = "BLOCKED"
        record["terminal_outcome"] = "BLOCKED"
        record["timestamps"]["ended_at"] = utc_now()
        atomic_write_json(status_path(args), record)
        print("terminal_outcome: BLOCKED")
        print(f"status: {status_path(args)}")
        return 1
    atomic_write_json(status_path(args), record)
    performance = PerformanceCollector(root)
    with open_private_text(stdout_path) as stdout, open_private_text(stderr_path) as stderr:
        process = subprocess.Popen(
            command,
            cwd=root,
            env=child_environment(args),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=stderr,
            text=True,
            bufsize=1,
        )
        record["process"] = {"pid": process.pid}
        atomic_write_json(status_path(args), record)
        if process.stdout is not None:
            for line in process.stdout:
                stdout.write(line)
                stdout.flush()
                performance.observe_line(line)
        exit_code = process.wait()
    terminal_signal = fallback_terminal_signal(args, exit_code, stdout_terminal_signal(stdout_path))
    outcome = terminal_signal.outcome or "BLOCKED"
    if exit_code != 0 and outcome == "DELIVERED":
        outcome = "BLOCKED"
        terminal_signal.reason = "nonzero_child_exit"
    record["phase"] = "terminal"
    record["result"] = outcome
    record["terminal_outcome"] = outcome
    if terminal_signal.reason:
        record["terminal_reason"] = terminal_signal.reason
    if outcome == "BLOCKED" and terminal_signal.reason == "investigation_required":
        identity, identity_error = retained_payload_identity(args, root)
        if identity:
            record["retained_payload"] = identity
        else:
            checks_payload = record.setdefault("preflight", {}).setdefault("checks", [])
            if isinstance(checks_payload, list):
                checks_payload.append(
                    check_payload(
                        Check(
                            "retained payload identity",
                            "fail",
                            "retained_payload_identity_unavailable",
                            {"detail": identity_error or "review fingerprint unavailable"},
                        )
                    )
                )
    record.setdefault("process", {})["exit_code"] = exit_code
    record["usage"] = parse_usage(stdout_path)
    performance.record_terminal(outcome, terminal_signal.reason)
    record["performance"] = performance.summary(root, args.card, args.started_at)
    record["timestamps"]["ended_at"] = utc_now()
    record["updated_at"] = utc_now()
    record_commit(record, root)
    atomic_write_json(status_path(args), record)
    print(f"terminal_outcome: {outcome}")
    if terminal_signal.reason:
        print(f"terminal_reason: {terminal_signal.reason}")
    for line in oversized_command_lines(record):
        print(line)
    print(f"status: {status_path(args)}")
    return 0 if outcome == "DELIVERED" else 1


def command_run(args: argparse.Namespace) -> int:
    args.started_at = utc_now()
    return run_single_card_delivery(args, check_preflight(args))


def prior_status_remote_failure(prior: dict[str, Any]) -> str | None:
    checks = prior.get("preflight", {}).get("checks")
    if not isinstance(checks, list):
        return None
    for check in checks:
        if not isinstance(check, dict):
            continue
        if check.get("name") != "publish target" or check.get("status") != "fail":
            continue
        failure_class = check.get("failure_class")
        if isinstance(failure_class, str) and failure_class in REMOTE_FAILURE_CLASSES:
            return failure_class
    return None


def resume_fail(name: str, message: str, reason: str) -> tuple[list[Check], str]:
    return [Check(name, "fail", message, {"detail": reason})], reason


def authorization_failure_reason(preflight: dict[str, Any] | None) -> str:
    if not isinstance(preflight, dict):
        return "retained_resume_preflight_failed"
    guard = preflight.get("complexity_guard")
    authorization = guard.get("published_investigation_authorization") if isinstance(guard, dict) else None
    if isinstance(authorization, dict):
        status = authorization.get("status")
        detail = str(authorization.get("detail", "")).lower()
        if status == "missing":
            return "authorization_absence"
        if status == "invalid":
            if "unchanged tracked head" in detail or "tracked" in detail or "4.done" in detail:
                return "authorization_stale"
            if any(fragment in detail for fragment in ("successor", "investigation", "depends on", "blocks", "path/id", "reference")):
                return "relation_mismatch"
            if "production_loc_ceiling" in detail:
                return "authorization_ceiling_violation"
            return "authorization_validation_failed"
    if isinstance(guard, dict):
        reasons = guard.get("reasons")
        if isinstance(reasons, list):
            joined = " ".join(str(reason).lower() for reason in reasons)
            if "added production loc" in joined or "exceeds" in joined:
                return "authorization_ceiling_violation"
            if "new authority or wire protocol" in joined:
                return "authorization_absence"
    return "retained_resume_preflight_failed"


def retained_resume_review_preflight(args: argparse.Namespace) -> tuple[Check, str | None]:
    root = args.workspace.resolve(strict=False)
    output = args.runtime_root / args.run_id / "retained-resume-review-preflight.json"
    helper = repo_root_from_script() / "bin" / "changerail-review-verdict"
    result = subprocess.run(
        [
            str(helper),
            "preflight",
            args.card,
            "--workspace",
            str(root),
            "--output",
            str(output),
            "--json",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    try:
        preflight = json.loads(result.stdout)
    except json.JSONDecodeError:
        preflight = None
    if result.returncode == 0 and isinstance(preflight, dict):
        authorization = preflight.get("complexity_guard", {}).get("published_investigation_authorization", {})
        if isinstance(authorization, dict) and authorization.get("status") == "valid":
            return (
                Check(
                    "published investigation authorization",
                    "pass",
                    "deterministic review preflight accepted the retained resume authorization",
                    {"detail": repository_relative(output, root)},
                ),
                None,
            )
    reason = authorization_failure_reason(preflight)
    detail = result.stderr.strip() or result.stdout.strip() or "review preflight failed"
    return (
        Check("published investigation authorization", "fail", compact_reason(detail), {"detail": reason}),
        reason,
    )


def retained_resume_checks(args: argparse.Namespace, prior: dict[str, Any]) -> tuple[list[Check], str | None, bool]:
    root = args.workspace.resolve(strict=False)
    retained = prior.get("retained_payload")
    if not isinstance(retained, dict):
        checks, reason = resume_fail("retained payload identity", "prior status has no retained_payload identity", "missing_retained_identity")
        return checks, reason, False
    expected_status_path = repository_relative(args.status_path, root)
    if retained.get("source_run_id") != prior.get("run_id") or retained.get("source_status_path") != expected_status_path:
        checks, reason = resume_fail(
            "retained payload source",
            "retained payload source run/status does not match the resume input",
            "prior_status_mismatch",
        )
        return checks, reason, False
    retained_card = retained.get("card")
    if not isinstance(retained_card, dict) or retained_card.get("id") != card_id(args.card) or retained_card.get("path") != args.card:
        checks, reason = resume_fail("retained payload card", "retained payload belongs to another card", "card_mismatch")
        return checks, reason, False
    retained_workspace = retained.get("workspace")
    if not isinstance(retained_workspace, dict) or retained_workspace.get("root") != str(root):
        checks, reason = resume_fail("retained payload workspace", "retained payload belongs to another workspace", "workspace_mismatch")
        return checks, reason, False
    review_target = retained.get("review_target")
    if not isinstance(review_target, dict) or review_target.get("kind") != "working-tree":
        checks, reason = resume_fail(
            "retained payload review target",
            "retained payload does not identify the working tree review target",
            "missing_retained_identity",
        )
        return checks, reason, False
    fingerprint, fingerprint_error = review_fingerprint(root)
    if fingerprint is None:
        checks, reason = resume_fail(
            "retained payload fingerprint",
            fingerprint_error or "current retained payload fingerprint cannot be computed",
            "retained_payload_fingerprint_unavailable",
        )
        return checks, reason, False
    mismatched = [
        key
        for key in ("head_commit", "tree_sha", "diff_fingerprint")
        if fingerprint.get(key) != retained.get(key)
    ]
    if mismatched:
        checks, reason = resume_fail(
            "retained payload fingerprint",
            "current retained payload fingerprint differs: " + ", ".join(mismatched),
            "payload_drift",
        )
        return checks, reason, False
    preflight_check, preflight_reason = retained_resume_review_preflight(args)
    checks = [
        Check("resume prior status", "pass", "prior investigation_required status accepted"),
        Check("retained payload fingerprint", "pass", "current working tree matches retained identity"),
        preflight_check,
    ]
    return checks, preflight_reason, preflight_reason is None


def resume_prior_checks(args: argparse.Namespace) -> tuple[list[Check], str | None, bool]:
    prior = load_json_object(args.status_path)
    if prior is None:
        checks, reason = resume_fail("resume prior status", f"prior status cannot be read: {args.status_path}", "prior_status_invalid")
        return checks, reason, False
    errors = schema_errors(prior, "changerail-delivery-run.schema.json")
    if errors:
        checks, reason = resume_fail("resume prior status", "; ".join(errors), "prior_status_invalid")
        return checks, reason, False
    if prior.get("schema") != SCHEMA or prior.get("result") != "BLOCKED":
        checks, reason = resume_fail("resume prior status", "prior status is not a blocked delivery-run record", "prior_status_invalid")
        return checks, reason, False
    prior_workspace = prior.get("workspace", {}).get("root")
    if prior_workspace != str(args.workspace.resolve(strict=False)):
        checks, reason = resume_fail("resume prior status", "prior status belongs to another workspace", "workspace_mismatch")
        return checks, reason, False
    prior_card = prior.get("card", {}).get("path")
    if prior_card != args.card:
        checks, reason = resume_fail("resume prior status", "prior status belongs to another card", "card_mismatch")
        return checks, reason, False
    if prior.get("terminal_reason") == "investigation_required":
        return retained_resume_checks(args, prior)
    failure_class = prior_status_remote_failure(prior)
    if not failure_class:
        checks, reason = resume_fail(
            "resume prior status",
            "prior status did not stop at a recoverable remote or retained-payload boundary",
            "prior_status_not_recoverable",
        )
        return checks, reason, False
    return [
        Check(
            "resume prior status",
            "pass",
            f"prior remote preflight failure accepted: {failure_class}",
            {"failure_class": failure_class},
        )
    ], None, False


def command_resume(args: argparse.Namespace) -> int:
    args.started_at = utc_now()
    resume_checks, failure_reason, allow_dirty_workspace = resume_prior_checks(args)
    if any(check.status == "fail" for check in resume_checks):
        record = base_record(args, "terminal", "BLOCKED")
        record["preflight"] = {"checks": [check_payload(check) for check in resume_checks]}
        record["terminal_outcome"] = "BLOCKED"
        record["terminal_reason"] = failure_reason or "resume_prior_status_invalid"
        record["timestamps"]["ended_at"] = utc_now()
        args.runtime_root.mkdir(parents=True, exist_ok=True)
        atomic_write_json(status_path(args), record)
        print("terminal_outcome: BLOCKED")
        print(f"terminal_reason: {record['terminal_reason']}")
        print(f"status: {status_path(args)}")
        return 1
    return run_single_card_delivery(args, resume_checks + check_preflight(args, allow_dirty_workspace))


def workspace_lock_path(args: argparse.Namespace, workspace: dict[str, Any]) -> Path:
    digest = hashlib.sha256(str(Path(workspace["root"]).resolve(strict=False)).encode("utf-8")).hexdigest()[:16]
    return plan_runtime_root(args) / "locks" / f"{digest}.lock"


def create_workspace_lock(args: argparse.Namespace, workspace: dict[str, Any]) -> tuple[dict[str, Any], str | None]:
    path = workspace_lock_path(args, workspace)
    if path.exists():
        lock = {
            "workspace": workspace["alias"],
            "path": repository_relative(path, args.consumer_root),
            "state": "stale",
            "reason": "lock already exists; remove it only after proving no live queue child owns this workspace",
        }
        return lock, lock["reason"]
    payload = {"workspace": workspace["alias"], "run_id": args.run_id, "created_at": utc_now()}
    ensure_private_directory(path.parent)
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        lock = {
            "workspace": workspace["alias"],
            "path": repository_relative(path, args.consumer_root),
            "state": "stale",
            "reason": "lock already exists; remove it only after proving no live queue child owns this workspace",
        }
        return lock, lock["reason"]
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        os.fchmod(handle.fileno(), 0o600)
        handle.write(json.dumps(payload, ensure_ascii=True, indent=2) + "\n")
    return {
        "workspace": workspace["alias"],
        "path": repository_relative(path, args.consumer_root),
        "state": "created",
        "created_at": payload["created_at"],
    }, None


def release_workspace_lock(args: argparse.Namespace, workspace: dict[str, Any]) -> dict[str, Any]:
    path = workspace_lock_path(args, workspace)
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    return {
        "workspace": workspace["alias"],
        "path": repository_relative(path, args.consumer_root),
        "state": "released",
    }


def git_clean(root: Path) -> tuple[bool, str]:
    result = subprocess.run(["git", "-C", str(root), "status", "--porcelain"], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        return False, result.stderr.strip() or "git status failed"
    dirty = [line for line in result.stdout.splitlines() if line.strip()]
    if dirty:
        return False, f"dirty tree: {len(dirty)} paths: {', '.join(dirty[:5])}"
    return True, "clean tree"


def upstream_state(root: Path) -> tuple[str, str]:
    upstream = subprocess.run(
        ["git", "-C", str(root), "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"],
        capture_output=True,
        text=True,
        check=False,
    )
    if upstream.returncode != 0:
        return "unknown", "no upstream"
    counts = subprocess.run(
        ["git", "-C", str(root), "rev-list", "--left-right", "--count", f"{upstream.stdout.strip()}...HEAD"],
        capture_output=True,
        text=True,
        check=False,
    )
    if counts.returncode != 0:
        return "unknown", counts.stderr.strip() or "cannot compare upstream"
    parts = counts.stdout.strip().split()
    if len(parts) != 2:
        return "unknown", counts.stdout.strip() or "cannot parse upstream comparison"
    behind, ahead = parts
    if behind == "0" and ahead == "0":
        return "equal", f"HEAD == {upstream.stdout.strip()}"
    return "ahead" if behind == "0" else "diverged", f"behind={behind} ahead={ahead}"


def queue_success_check(workspace: dict[str, Any], card: dict[str, Any], mode: str) -> tuple[bool, str, dict[str, str]]:
    root = Path(workspace["root"])
    clean, clean_reason = git_clean(root)
    if not clean:
        return False, clean_reason, {}
    upstream, upstream_reason = upstream_state(root)
    details = {"upstream_state": upstream, "upstream_detail": upstream_reason}
    if mode == "no-push":
        if upstream != "ahead":
            return False, f"{clean_reason}; expected ahead-of-upstream for --no-push, got {upstream}: {upstream_reason}", details
        return True, f"{clean_reason}; ahead_state={upstream}: {upstream_reason}", details
    locations = current_card_locations(root, card.get("resolved_path") or card["card"])
    done_locations = [path for path in locations if path.startswith("openspec/board/4.done/")]
    if len(done_locations) != 1 or len(locations) != 1:
        return False, f"expected exactly one done card location, got {locations}", details
    if upstream != "equal":
        return False, f"upstream check failed: {upstream_reason}", details
    return True, f"{clean_reason}; {upstream_reason}; card={done_locations[0]}", details


def dependency_list(card: dict[str, Any]) -> list[str]:
    dependencies = card.get("depends_on", [])
    if not isinstance(dependencies, list):
        return []
    return [dependency for dependency in dependencies if isinstance(dependency, str)]


def retained_recovery_is_valid(card: dict[str, Any]) -> bool:
    if card.get("terminal_reason") != "investigation_required":
        return False
    retained = card.get("retained_recovery")
    if not isinstance(retained, dict):
        return False
    fingerprint = retained.get("fingerprint")
    retained_card = retained.get("card")
    return (
        retained.get("kind") == "original-retained-payload"
        and retained.get("source_terminal_reason") == "investigation_required"
        and isinstance(retained.get("source_run_id"), str)
        and isinstance(retained.get("source_run_status_path"), str)
        and isinstance(retained_card, dict)
        and isinstance(fingerprint, dict)
        and retained_card.get("id") == card.get("id")
        and isinstance(retained_card.get("path"), str)
        and isinstance(fingerprint.get("head_commit"), str)
        and isinstance(fingerprint.get("tree_sha"), str)
        and isinstance(fingerprint.get("diff_fingerprint"), str)
        and retained.get("review_target_kind") == "working-tree"
    )


def recoverable_source(card: dict[str, Any]) -> bool:
    if card.get("state") == "no-go" and card.get("result") == "NO-GO":
        return True
    if (
        card.get("state") == "blocked"
        and card.get("result") == "BLOCKED"
        and retained_recovery_is_valid(card)
    ):
        return True
    return (
        card.get("state") == "blocked"
        and card.get("result") == "BLOCKED"
        and card.get("terminal_reason") == "fix_budget_exhausted"
    )


def retained_original_resume_workspaces(previous: dict[str, Any] | None, data: dict[str, Any]) -> set[str]:
    if not isinstance(previous, dict):
        return set()
    if previous.get("plan", {}).get("fingerprint") != plan_fingerprint(data):
        return set()
    cards = previous.get("cards")
    if not isinstance(cards, list):
        return set()
    workspaces: set[str] = set()
    for card in cards:
        if not isinstance(card, dict) or not retained_recovery_is_valid(card):
            continue
        workspace = card.get("workspace")
        if isinstance(workspace, str):
            workspaces.add(workspace)
    return workspaces


def recovery_by_source(cards: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    linked: dict[str, dict[str, Any]] = {}
    for card in cards:
        source = card.get("recovery_for")
        if isinstance(source, str):
            linked[source] = card
    return linked


def valid_recovery_augmentation(
    previous: dict[str, Any],
    data: dict[str, Any],
    cards: list[dict[str, Any]],
    checks: list[Check],
) -> bool:
    previous_cards = {
        card.get("id"): card
        for card in previous.get("cards", [])
        if isinstance(card, dict) and isinstance(card.get("id"), str)
    }
    current_cards = {card["id"]: card for card in cards if isinstance(card.get("id"), str)}
    if not previous_cards:
        checks.append(Check("resume recovery augmentation", "fail", "previous aggregate status has no cards"))
        return False
    previous_fingerprint = previous.get("plan", {}).get("fingerprint")
    previous_ids = set(previous_cards)
    base_plan = dict(data)
    base_plan["cards"] = [
        card
        for card in data.get("cards", [])
        if isinstance(card, dict) and card.get("id") in previous_ids
    ]
    if previous_fingerprint != plan_fingerprint(base_plan):
        checks.append(Check("resume recovery augmentation", "fail", "plan changed outside added recovery cards"))
        return False
    recovery_sources: set[str] = set()
    for card_id, previous_card in previous_cards.items():
        current = current_cards.get(card_id)
        if current is None:
            checks.append(Check("resume recovery augmentation", "fail", f"missing prior card {card_id}"))
            return False
        for key in ("workspace", "card", "wave"):
            if previous_card.get(key) != current.get(key):
                checks.append(Check("resume recovery augmentation", "fail", f"{card_id}: {key} changed"))
                return False
        if dependency_list(previous_card) != dependency_list(current):
            checks.append(Check("resume recovery augmentation", "fail", f"{card_id}: dependencies changed"))
            return False
    for card_id, current in current_cards.items():
        if card_id in previous_cards:
            continue
        source_id = current.get("recovery_for")
        if not isinstance(source_id, str):
            checks.append(Check("resume recovery augmentation", "fail", f"{card_id}: added card lacks recovery_for"))
            return False
        if source_id in recovery_sources:
            checks.append(Check("resume recovery augmentation", "fail", f"{source_id}: multiple recovery cards"))
            return False
        source_previous = previous_cards.get(source_id)
        source_current = current_cards.get(source_id)
        if not isinstance(source_previous, dict) or not isinstance(source_current, dict):
            checks.append(Check("resume recovery augmentation", "fail", f"{card_id}: source {source_id} missing"))
            return False
        if not recoverable_source(source_previous):
            checks.append(Check("resume recovery augmentation", "fail", f"{card_id}: source {source_id} is not recoverable"))
            return False
        if current.get("workspace") != source_current.get("workspace") or current.get("wave") != source_current.get("wave"):
            checks.append(Check("resume recovery augmentation", "fail", f"{card_id}: recovery must share source workspace and wave"))
            return False
        if dependency_list(current) != dependency_list(source_current):
            checks.append(Check("resume recovery augmentation", "fail", f"{card_id}: recovery must inherit source dependencies"))
            return False
        recovery_sources.add(source_id)
    if not recovery_sources:
        checks.append(Check("resume recovery augmentation", "fail", "plan changed without added recovery card"))
        return False
    checks.append(Check("resume recovery augmentation", "pass", ", ".join(sorted(recovery_sources))))
    return True


def child_terminal_signal(child_status: dict[str, Any] | None) -> TerminalSignal:
    if not isinstance(child_status, dict):
        return TerminalSignal("BLOCKED", "missing_or_invalid_child_status")
    errors = schema_errors(child_status, "changerail-delivery-run.schema.json")
    if errors:
        return TerminalSignal("BLOCKED", "missing_or_invalid_child_status")
    result = child_status.get("result")
    if result not in {"DELIVERED", "NO-GO", "BLOCKED"}:
        return TerminalSignal("BLOCKED", "missing_or_invalid_child_status")
    reason = child_status.get("terminal_reason")
    return TerminalSignal(result, reason if isinstance(reason, str) else None)


def ready_cards(cards: list[dict[str, Any]], completed: set[str], running_workspaces: set[str]) -> list[dict[str, Any]]:
    cards_by_id = {card["id"]: card for card in cards if isinstance(card.get("id"), str)}
    candidates: list[dict[str, Any]] = []
    active_waves = [
        card.get("wave", 1)
        for card in cards
        if card.get("state") in {"pending", "ready", "running"}
    ]
    current_wave = min(active_waves) if active_waves else None
    for card in cards:
        if card.get("state") not in {"pending", "ready"}:
            continue
        if current_wave is not None and card.get("wave", 1) != current_wave:
            continue
        if card["workspace"] in running_workspaces:
            continue
        recovery_for = card.get("recovery_for")
        if isinstance(recovery_for, str):
            source = cards_by_id.get(recovery_for)
            if not isinstance(source, dict) or not recoverable_source(source):
                continue
        dependencies = dependency_list(card)
        if all(dep in completed for dep in dependencies):
            candidates.append(card)
    return sorted(candidates, key=lambda item: (item.get("wave", 1), item["workspace"], item["id"]))


def write_plan_status(
    args: argparse.Namespace,
    data: dict[str, Any],
    workspaces: list[dict[str, Any]],
    cards: list[dict[str, Any]],
    checks: list[Check],
    phase: str,
    result: str,
    locks: list[dict[str, Any]] | None = None,
) -> dict[str, Any]:
    status = plan_status_record(args, data, workspaces, cards, checks, phase, result, locks)
    atomic_write_json(plan_status_path(args), status)
    return status


def run_queue(args: argparse.Namespace, resume: bool = False) -> tuple[dict[str, Any], int]:
    args.started_at = utc_now()
    data, errors = load_plan(args.plan)
    if data is None or errors:
        record = blocked_plan_status_for_errors(args, errors, data)
        atomic_write_json(plan_status_path(args), record)
        return record, 1
    previous = load_json_object(args.status_path) if resume and getattr(args, "status_path", None) else None
    if resume and previous is None:
        previous = load_json_object(plan_status_path(args))
    allow_dirty_workspaces = retained_original_resume_workspaces(previous, data) if resume else set()
    workspaces, cards, checks = check_plan_semantics(data, args.consumer_root, allow_dirty_workspaces)
    checks.append(Check("single-card runner exists", "pass" if args.launcher.is_file() else "fail", str(args.launcher)))
    checks.append(Check("single-card runner executable", "pass" if os.access(args.launcher, os.X_OK) else "fail", str(args.launcher)))
    workspace_by_alias = {workspace["alias"]: workspace for workspace in workspaces}
    apply_plan_card_overrides(data, cards)
    mode = plan_mode(args, data)
    if all(check.status != "fail" for check in checks):
        append_single_card_preflight_checks(args, cards, workspace_by_alias, checks, mode)
    if any(check.status == "fail" for check in checks):
        record = write_plan_status(args, data, workspaces, cards, checks, "terminal", "BLOCKED")
        return record, 1
    if resume:
        previous_fingerprint = previous.get("plan", {}).get("fingerprint") if isinstance(previous, dict) else None
        if previous_fingerprint != plan_fingerprint(data) and not (
            isinstance(previous, dict) and valid_recovery_augmentation(previous, data, cards, checks)
        ):
            checks.append(Check("resume fingerprint", "fail", "plan fingerprint differs from aggregate status"))
            record = write_plan_status(args, data, workspaces, cards, checks, "terminal", "BLOCKED")
            return record, 1
    previous_cards = {}
    if isinstance(previous, dict) and isinstance(previous.get("cards"), list):
        previous_cards = {card.get("id"): card for card in previous["cards"] if isinstance(card, dict)}
    mode = plan_mode(args, data)
    for card in cards:
        card["state"] = "pending"
        card["run_id"] = child_run_id(args, card)
        workspace = workspace_by_alias[card["workspace"]]
        card["run_status_path"] = repository_relative(child_status_path_for(args, card, workspace), args.consumer_root)
        previous_card = previous_cards.get(card["id"])
        if resume and isinstance(previous_card, dict) and previous_card.get("state") == "delivered":
            ok, reason, details = queue_success_check(workspace, card, mode)
            card.update(details)
            if ok:
                card["state"] = "skipped"
                card["result"] = "DELIVERED"
                card["reason"] = f"already delivered; {reason}"
        if resume and isinstance(previous_card, dict) and retained_recovery_is_valid(previous_card):
            retained_recovery = previous_card.get("retained_recovery")
            if isinstance(retained_recovery, dict):
                card["retained_recovery"] = retained_recovery
            if card["id"] not in recovery_by_source(cards):
                status_path = previous_card.get("run_status_path")
                if not isinstance(status_path, str) or not status_path:
                    status_path = retained_recovery.get("source_run_status_path") if isinstance(retained_recovery, dict) else None
                if isinstance(status_path, str) and status_path:
                    card["resume_status_path"] = status_path
                    card["reason"] = "retained investigation recovery will resume original child"
        if resume and isinstance(previous_card, dict) and recoverable_source(previous_card):
            recoveries = recovery_by_source(cards)
            if card["id"] in recoveries:
                card["state"] = "blocked" if previous_card.get("result") == "BLOCKED" else "no-go"
                card["result"] = previous_card.get("result")
                if isinstance(previous_card.get("terminal_reason"), str):
                    card["terminal_reason"] = previous_card["terminal_reason"]
                if isinstance(previous_card.get("retained_recovery"), dict):
                    card["retained_recovery"] = previous_card["retained_recovery"]
                if isinstance(previous_card.get("reason"), str):
                    card["reason"] = previous_card["reason"]
                if isinstance(previous_card.get("run_status_path"), str):
                    card["run_status_path"] = previous_card["run_status_path"]
    completed = {card["id"] for card in cards if card.get("state") == "skipped"}
    cards_by_id = {card["id"]: card for card in cards if isinstance(card.get("id"), str)}
    for card in cards:
        source_id = card.get("recovery_for")
        source = cards_by_id.get(source_id) if isinstance(source_id, str) else None
        if card.get("state") in {"pending", "ready"} and isinstance(source, dict) and source.get("state") in {"delivered", "skipped"}:
            card["state"] = "skipped"
            card["reason"] = f"source {source_id} already delivered; recovery not required"
            completed.add(card["id"])
    running: dict[str, tuple[subprocess.Popen[str], dict[str, Any], dict[str, Any]]] = {}
    locks: list[dict[str, Any]] = []
    result = "RUNNING"
    status = write_plan_status(args, data, workspaces, cards, checks, "running" if not resume else "resuming", result, locks)
    max_parallel = min(int(data.get("max_parallel", 1)), max(1, len(workspaces)))

    while True:
        running_workspaces = {card["workspace"] for _key, (_process, card, _workspace) in running.items()}
        while result == "RUNNING" and len(running) < max_parallel:
            candidates = ready_cards(cards, completed, running_workspaces)
            if not candidates:
                break
            card = candidates[0]
            workspace = workspace_by_alias[card["workspace"]]
            lock, lock_error = create_workspace_lock(args, workspace)
            locks.append(lock)
            if lock_error:
                card["state"] = "blocked"
                card["result"] = "BLOCKED"
                card["reason"] = lock_error
                checks.append(Check("workspace lock", "fail", f"{card['workspace']}: {lock_error}"))
                result = "BLOCKED"
                break
            command = child_command_for_card(args, card, workspace, mode)
            card["state"] = "running"
            card["started_at"] = utc_now()
            process = subprocess.Popen(
                command,
                cwd=Path(workspace["root"]),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                text=True,
            )
            running[card["id"]] = (process, card, workspace)
            running_workspaces.add(card["workspace"])
            status = write_plan_status(args, data, workspaces, cards, checks, "running" if not resume else "resuming", result, locks)

        if not running:
            unfinished = [card for card in cards if card.get("state") in {"pending", "ready"}]
            if result == "RUNNING" and unfinished:
                checks.append(Check("queue progress", "fail", "no runnable cards remain"))
                result = "BLOCKED"
            break

        time.sleep(0.01)
        for card_id, (process, card, workspace) in list(running.items()):
            exit_code = process.poll()
            if exit_code is None:
                continue
            running.pop(card_id)
            locks.append(release_workspace_lock(args, workspace))
            card["ended_at"] = utc_now()
            child_status = load_json_object(child_status_path_for(args, card, workspace))
            child_signal = child_terminal_signal(child_status)
            child_result = child_signal.outcome or "BLOCKED"
            card["result"] = child_result
            if child_signal.reason:
                card["terminal_reason"] = child_signal.reason
            if child_signal.reason == "investigation_required" and isinstance(child_status, dict):
                retained = retained_recovery_summary(child_status, card.get("run_status_path"))
                if retained:
                    card["retained_recovery"] = retained
            if child_result == "DELIVERED":
                ok, reason, details = queue_success_check(workspace, card, mode)
                card.update(details)
                if ok:
                    card["state"] = "delivered"
                    card["reason"] = reason
                    completed.add(card["id"])
                    source_id = card.get("recovery_for")
                    if isinstance(source_id, str):
                        source = next((item for item in cards if item.get("id") == source_id), None)
                        if isinstance(source, dict) and recoverable_source(source):
                            source["state"] = "recovered"
                            source["recovered_by"] = card["id"]
                            prior_reason = source.get("reason")
                            source["reason"] = (
                                f"{prior_reason}; recovered by {card['id']}"
                                if isinstance(prior_reason, str) and prior_reason
                                else f"recovered by {card['id']}"
                            )
                            completed.add(source_id)
                    else:
                        for recovery in cards:
                            if recovery.get("recovery_for") == card["id"] and recovery.get("state") in {"pending", "ready"}:
                                recovery["state"] = "skipped"
                                recovery["reason"] = f"source {card['id']} delivered; recovery not required"
                                completed.add(recovery["id"])
                else:
                    card["state"] = "blocked"
                    card["result"] = "BLOCKED"
                    card["reason"] = reason
                    result = "BLOCKED"
            elif child_result == "NO-GO":
                card["state"] = "no-go"
                card["reason"] = "child returned NO-GO"
                result = "NO-GO"
            else:
                card["state"] = "blocked"
                reason = "child returned BLOCKED"
                if child_signal.reason:
                    reason += f": {child_signal.reason}"
                card["reason"] = reason
                result = "BLOCKED"
            status = write_plan_status(args, data, workspaces, cards, checks, "running" if not resume else "resuming", result, locks)

    while running:
        for card_id, (process, card, workspace) in list(running.items()):
            if process.poll() is None:
                time.sleep(0.01)
                continue
            running.pop(card_id)
            locks.append(release_workspace_lock(args, workspace))
            card["ended_at"] = utc_now()
    if result == "RUNNING":
        result = "DELIVERED"
    status = write_plan_status(args, data, workspaces, cards, checks, "terminal", result, locks)
    return status, 0 if result == "DELIVERED" else 1


def build_generated_plan(args: argparse.Namespace) -> tuple[dict[str, Any] | None, list[str]]:
    errors: list[str] = []
    workspaces: list[dict[str, Any]] = []
    aliases: set[str] = set()
    for value in args.workspace:
        alias, path, error = parse_key_value(value, "workspace")
        if error:
            errors.append(error)
            continue
        assert alias is not None and path is not None
        if alias in aliases:
            errors.append(f"duplicate workspace alias: {alias}")
        aliases.add(alias)
        workspaces.append({"alias": alias, "path": path})
    default_workspace = args.default_workspace or (workspaces[0]["alias"] if workspaces else None)
    if default_workspace not in aliases:
        errors.append(f"default workspace is not declared: {default_workspace}")

    cards: list[dict[str, Any]] = []
    card_ids: set[str] = set()
    for raw in args.card:
        card_id_override: str | None = None
        spec = raw.strip()
        if "=" in spec:
            left, spec = spec.split("=", 1)
            card_id_override = safe_generated_id(left)
            if not card_id_override:
                errors.append(f"invalid card id: {left}")
        workspace_alias = default_workspace
        if ":" in spec:
            prefix, remainder = spec.split(":", 1)
            if prefix in aliases:
                workspace_alias = prefix
                spec = remainder
        if not spec:
            errors.append(f"card path is empty: {raw}")
            continue
        if workspace_alias not in aliases:
            errors.append(f"card workspace is not declared: {workspace_alias}")
            continue
        card_id = card_id_override or generated_card_id(spec)
        if not card_id:
            errors.append(f"invalid generated card id for path: {spec}")
            continue
        if card_id in card_ids:
            errors.append(f"duplicate card id: {card_id}")
        card_ids.add(card_id)
        cards.append({"id": card_id, "workspace": workspace_alias, "card": spec})

    dependencies_by_card: dict[str, list[str]] = {}
    for value in args.depends:
        target, raw_deps, error = parse_key_value(value, "depends")
        if error:
            errors.append(error)
            continue
        assert target is not None and raw_deps is not None
        dependencies = [dep.strip() for dep in raw_deps.split(",") if dep.strip()]
        if target not in card_ids:
            errors.append(f"dependency target is not declared: {target}")
        missing = [dep for dep in dependencies if dep not in card_ids]
        if missing:
            errors.append(f"{target}: dependencies are not declared: {', '.join(missing)}")
        if not dependencies:
            errors.append(f"{target}: depends must include at least one dependency")
        dependencies_by_card[target] = dependencies

    for card in cards:
        dependencies = dependencies_by_card.get(card["id"])
        if dependencies:
            card["depends_on"] = dependencies

    plan: dict[str, Any] = {
        "schema": PLAN_SCHEMA,
        "id": safe_generated_id(args.id),
        "per_workspace_parallelism": 1,
        "push_mode": "no-push" if args.no_push else "push",
        "workspaces": workspaces,
        "cards": cards,
    }
    if not plan["id"]:
        errors.append(f"invalid plan id: {args.id}")
    if args.description:
        plan["description"] = args.description
    if args.max_parallel is not None:
        plan["max_parallel"] = args.max_parallel
    schema_check = schema_errors(plan, "changerail-delivery-plan.schema.json")
    errors.extend(schema_check)
    if errors:
        return None, errors
    return plan, []


def command_generate_plan(args: argparse.Namespace) -> int:
    plan, errors = build_generated_plan(args)
    if errors or plan is None:
        print(json.dumps({"result": "BLOCKED", "errors": errors}, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 1
    if args.output:
        atomic_write_json(args.output, plan, private=False)
        print(f"wrote: {args.output}")
    else:
        print(json.dumps(plan, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


def command_plan(args: argparse.Namespace) -> int:
    args.started_at = utc_now()
    data, errors = load_plan(args.plan)
    if data is None:
        record = blocked_plan_status_for_errors(args, errors)
        atomic_write_json(plan_status_path(args), record)
        print(json.dumps({"result": "BLOCKED", "errors": errors, "status_path": str(plan_status_path(args))}, ensure_ascii=False, indent=2))
        return 1
    if errors:
        record = blocked_plan_status_for_errors(args, errors, data)
        atomic_write_json(plan_status_path(args), record)
        print(json.dumps({"result": "BLOCKED", "errors": errors, "status_path": str(plan_status_path(args))}, ensure_ascii=False, indent=2))
        return 1
    view, status = build_plan_view(args, data)
    atomic_write_json(plan_status_path(args), status)
    if args.json:
        print(json.dumps(view, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(f"result: {view['result']}")
        print(f"status: {view['status_path']}")
        for card in view["cards"]:
            command = " ".join(card.get("command", []))
            print(f"- {card['id']} workspace={card['workspace']} card={card.get('resolved_path', card['card'])} command={command}")
    return 0 if view["result"] == "DELIVERED" else 1


def command_preflight_plan(args: argparse.Namespace) -> int:
    args.started_at = utc_now()
    data, errors = load_plan(args.plan)
    if data is None or errors:
        record = blocked_plan_status_for_errors(args, errors, data)
        atomic_write_json(plan_status_path(args), record)
        print(json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) if args.json else "terminal_outcome: BLOCKED")
        if not args.json:
            print(f"status: {plan_status_path(args)}")
        return 1
    _view, status = build_plan_view(args, data, include_child_preflight=True)
    atomic_write_json(plan_status_path(args), status)
    if args.json:
        print(json.dumps(status, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(f"terminal_outcome: {status['result']}")
        print(f"status: {plan_status_path(args)}")
        print_compact_plan_failures(status)
    return 0 if status["result"] == "DELIVERED" else 1


def command_run_plan(args: argparse.Namespace) -> int:
    status, exit_code = run_queue(args, resume=False)
    if args.json:
        print(json.dumps(status, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(f"terminal_outcome: {status.get('terminal_outcome', status['result'])}")
        print(f"status: {plan_status_path(args)}")
        print_compact_plan_failures(status)
    return exit_code


def command_resume_plan(args: argparse.Namespace) -> int:
    status, exit_code = run_queue(args, resume=True)
    if args.json:
        print(json.dumps(status, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        print(f"terminal_outcome: {status.get('terminal_outcome', status['result'])}")
        print(f"status: {plan_status_path(args)}")
        print_compact_plan_failures(status)
    return exit_code


def blocked_plan_status_for_errors(
    args: argparse.Namespace,
    errors: list[str],
    data: dict[str, Any] | None = None,
) -> dict[str, Any]:
    fallback = data or {"id": Path(getattr(args, "plan", "plan")).stem or "invalid-plan"}
    if "schema" not in fallback:
        fallback["schema"] = PLAN_SCHEMA
    args.started_at = getattr(args, "started_at", utc_now())
    checks = [Check("plan validation", "fail", "; ".join(errors) if errors else "invalid plan")]
    record = {
        "schema": PLAN_STATUS_SCHEMA,
        "run_id": args.run_id,
        "updated_at": utc_now(),
        "plan": {
            "id": safe_plan_id(fallback.get("id")),
            "path": repository_relative(args.plan, args.consumer_root),
            "fingerprint": plan_fingerprint(fallback),
        },
        "phase": "preflight",
        "result": "BLOCKED",
        "terminal_outcome": "BLOCKED",
        "mode": plan_mode(args, data),
        "timestamps": {
            "started_at": args.started_at,
            "ended_at": utc_now(),
        },
        "max_parallel": fallback.get("max_parallel", 1),
        "per_workspace_parallelism": fallback.get("per_workspace_parallelism", 1),
        "workspaces": [],
        "cards": [],
        "checks": [check_payload(check) for check in checks],
        "summary": {"total_cards": 0, "delivered": 0, "blocked": 0, "no_go": 0, "skipped": 0},
    }
    schema_check = schema_errors(record, "changerail-delivery-plan-status.schema.json")
    if schema_check:
        record["checks"].append({"name": "status schema", "status": "fail", "message": "; ".join(schema_check)})
        record["max_parallel"] = 1
        record["per_workspace_parallelism"] = 1
    return record


def command_status_plan(args: argparse.Namespace) -> int:
    path = args.status_path or plan_status_path(args)
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"status-plan failed: {exc}", file=sys.stderr)
        return 1
    errors = schema_errors(data, "changerail-delivery-plan-status.schema.json")
    if errors:
        print(json.dumps({"result": "BLOCKED", "errors": errors}, ensure_ascii=False, indent=2), file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        plan = data.get("plan", {}) if isinstance(data.get("plan"), dict) else {}
        print(f"result: {data.get('result')}")
        print(f"plan: {plan.get('id', 'unknown')}")
        print(f"cards: {len(data.get('cards', [])) if isinstance(data.get('cards'), list) else 0}")
        print_compact_plan_failures(data)
    return 0 if data.get("result") != "BLOCKED" else 1


def safe_status_segment(value: str, label: str) -> tuple[str | None, str | None]:
    if not value:
        return None, f"{label} is empty"
    if value in {".", ".."} or "/" in value or "\\" in value:
        return None, f"{label} must be a single path segment"
    return value, None


def status_reader_error(args: argparse.Namespace, message: str, errors: list[str] | None = None) -> int:
    details = errors or [message]
    if getattr(args, "json", False):
        print(
            json.dumps({"result": "BLOCKED", "errors": details}, ensure_ascii=False, indent=2, sort_keys=True),
            file=sys.stderr,
        )
    else:
        print(f"status failed: {message}", file=sys.stderr)
        for detail in details:
            if detail != message:
                print(f"- {detail}", file=sys.stderr)
    return 1


def select_delivery_status_path(args: argparse.Namespace) -> tuple[Path | None, list[str]]:
    selectors = []
    if args.status_path is not None:
        selectors.append("status path")
    if args.run_id is not None:
        selectors.append("--run-id")
    if len(selectors) > 1:
        return None, ["conflicting status selectors: " + ", ".join(selectors)]
    if args.status_path is not None:
        return args.status_path, []
    if args.run_id is not None:
        run_id, error = safe_status_segment(args.run_id, "run id")
        if error:
            return None, [error]
        assert run_id is not None
        return args.runtime_root / run_id / "status.json", []
    if not args.runtime_root.is_dir():
        return None, [f"delivery-run runtime root does not exist: {args.runtime_root}"]
    candidates: list[Path] = []
    for child in args.runtime_root.iterdir():
        status = child / "status.json"
        if status.is_file():
            candidates.append(status)
    if not candidates:
        return None, [f"no delivery-run status records under {args.runtime_root}"]
    candidates.sort(key=lambda path: (path.stat().st_mtime_ns, path.as_posix()), reverse=True)
    return candidates[0], []


def load_valid_json_record(path: Path, schema_filename: str, label: str) -> tuple[dict[str, Any] | None, list[str]]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        return None, [f"{label} cannot be read: {exc}"]
    except json.JSONDecodeError as exc:
        return None, [f"{label} JSON is invalid: {exc}"]
    if not isinstance(payload, dict):
        return None, [f"{label} must be a JSON object"]
    errors = schema_errors(payload, schema_filename)
    return (payload if not errors else None), errors


def status_record_workspace(args: argparse.Namespace, record: dict[str, Any]) -> Path:
    workspace = record.get("workspace")
    if isinstance(workspace, dict):
        root = workspace.get("root")
        if isinstance(root, str) and root:
            return Path(root).expanduser().resolve(strict=False)
    return args.workspace.resolve(strict=False)


def status_record_card_id(record: dict[str, Any]) -> tuple[str | None, str | None]:
    card = record.get("card")
    if not isinstance(card, dict):
        return None, "status card metadata is missing"
    raw = card.get("id")
    if not isinstance(raw, str) or not raw:
        return None, "status card id is missing"
    return safe_status_segment(raw, "card id")


def linked_attention_artifacts(root: Path, record: dict[str, Any]) -> tuple[list[tuple[str, Path, str]], str | None]:
    status_card_id, error = status_record_card_id(record)
    if error:
        return [], error
    assert status_card_id is not None
    return [
        (
            "manifest",
            root / ".runtime" / "changerail" / "delivery-manifests" / f"{status_card_id}.json",
            "changerail-delivery-manifest.schema.json",
        ),
        (
            "review_verdict",
            root / ".runtime" / "changerail" / "reviews" / f"{status_card_id}.json",
            "changerail-review-verdict.schema.json",
        ),
        (
            "review_history",
            root / ".runtime" / "changerail" / "reviews" / f"{status_card_id}.history.json",
            "changerail-review-cycle-history.schema.json",
        ),
        (
            "evidence",
            root / ".runtime" / "changerail" / "evidence" / status_card_id / "index.json",
            "changerail-evidence-index.schema.json",
        ),
    ], None


def command_status(args: argparse.Namespace) -> int:
    selected, selection_errors = select_delivery_status_path(args)
    if selected is None:
        return status_reader_error(args, selection_errors[0], selection_errors)
    record, errors = load_valid_json_record(selected, "changerail-delivery-run.schema.json", "delivery-run status")
    if record is None:
        return status_reader_error(args, "delivery-run status is invalid", errors)
    if args.json:
        print(json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True))
        return 0

    root = status_record_workspace(args, record)
    card = record.get("card", {}) if isinstance(record.get("card"), dict) else {}
    print(f"card: {card.get('path', 'unknown')}")
    print(f"run_id: {record.get('run_id')}")
    print(f"phase: {record.get('phase')}")
    print(f"result: {record.get('result')}")
    print(f"updated_at: {record.get('updated_at')}")
    if record.get("terminal_reason"):
        print(f"terminal_reason: {record.get('terminal_reason')}")
    print(f"status: {repository_relative(selected, root)}")

    artifacts, artifact_error = linked_attention_artifacts(root, record)
    if artifact_error:
        print(f"runtime_artifacts: invalid ({artifact_error})")
        return 1

    manifest: dict[str, Any] | None = None
    linked_errors: list[str] = []
    for label, path, schema_filename in artifacts:
        relative = repository_relative(path, root)
        if not path.exists():
            print(f"{label}: {relative} (missing)")
            continue
        payload, artifact_errors = load_valid_json_record(path, schema_filename, label)
        if artifact_errors:
            linked_errors.append(f"{label}: {'; '.join(artifact_errors)}")
            print(f"{label}: {relative} (invalid: {artifact_errors[0]})")
            continue
        print(f"{label}: {relative}")
        if label == "manifest":
            manifest = payload

    pause_reasons = manifest.get("runtime_pause_reasons") if isinstance(manifest, dict) else None
    if isinstance(pause_reasons, list):
        for index, reason in enumerate(pause_reasons, start=1):
            if not isinstance(reason, dict):
                continue
            print(f"pause_reason[{index}].summary: {reason.get('summary')}")
            print(f"pause_reason[{index}].next_action: {reason.get('next_action')}")

    return 1 if linked_errors else 0


def add_common(parser: argparse.ArgumentParser) -> None:
    root = repo_root_from_script()
    parser.add_argument("card", help="single repository-relative board card path")
    parser.add_argument("--workspace", type=Path)
    parser.add_argument("--runtime-root", type=Path)
    parser.add_argument("--run-id", default=utc_run_id())
    parser.add_argument("--launcher", type=Path, default=root / "bin" / "codex")
    parser.add_argument("--connectivity-url")
    parser.add_argument("--connectivity-timeout", type=float, default=5.0)


def add_plan_common(parser: argparse.ArgumentParser) -> None:
    root = repo_root_from_script()
    parser.add_argument("plan", type=Path, help="delivery plan JSON path")
    parser.add_argument("--consumer-root", type=Path)
    parser.add_argument("--runtime-root", type=Path)
    parser.add_argument("--run-id", default=utc_run_id())
    parser.add_argument("--launcher", type=Path, default=root / "bin" / "changerail-delivery-runner")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--no-push", action="store_true")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    run = subparsers.add_parser("run", help="run non-interactive ChangeRail delivery")
    add_common(run)
    run.add_argument("--model")
    run.add_argument("--reasoning-effort")
    run.add_argument(
        "--deliver-arg",
        action="append",
        default=[],
        help="extra argument appended to the $changerail-deliver prompt, repeatable",
    )
    run.set_defaults(func=command_run)

    preflight = subparsers.add_parser("preflight", help="run preflight checks only")
    add_common(preflight)
    preflight.add_argument(
        "--deliver-arg",
        action="append",
        default=[],
        help="extra argument that would be appended to the $changerail-deliver prompt, repeatable",
    )
    preflight.add_argument("--json", action="store_true")
    preflight.add_argument("--write-status", action="store_true")
    preflight.set_defaults(func=command_preflight, model=None, reasoning_effort=None)

    resume = subparsers.add_parser("resume", help="resume a blocked single-card delivery after fresh preflight")
    resume.add_argument("card", nargs="?", help="single repository-relative board card path; defaults to prior status card")
    resume.add_argument("--status-path", type=Path, required=True, help="prior delivery-run status.json path")
    resume.add_argument("--workspace", type=Path)
    resume.add_argument("--runtime-root", type=Path)
    resume.add_argument("--run-id", default=utc_run_id())
    resume.add_argument("--launcher", type=Path, default=repo_root_from_script() / "bin" / "codex")
    resume.add_argument("--connectivity-url")
    resume.add_argument("--connectivity-timeout", type=float, default=5.0)
    resume.add_argument("--model")
    resume.add_argument("--reasoning-effort")
    resume.add_argument(
        "--deliver-arg",
        action="append",
        default=[],
        help="extra argument appended to the $changerail-deliver prompt, repeatable",
    )
    resume.set_defaults(func=command_resume)

    status = subparsers.add_parser("status", help="read single-card delivery status")
    status.add_argument("status_path", nargs="?", type=Path, help="delivery-run status.json path")
    status.add_argument("--workspace", type=Path)
    status.add_argument("--runtime-root", type=Path)
    status.add_argument("--run-id")
    status.add_argument("--json", action="store_true")
    status.set_defaults(func=command_status)

    plan = subparsers.add_parser("plan", help="resolve a delivery plan without launching children")
    add_plan_common(plan)
    plan.set_defaults(func=command_plan)

    preflight_plan = subparsers.add_parser("preflight-plan", help="validate a delivery plan and write aggregate status")
    add_plan_common(preflight_plan)
    preflight_plan.set_defaults(func=command_preflight_plan)

    generate_plan = subparsers.add_parser("generate-plan", help="generate a delivery plan from ordered cards")
    generate_plan.add_argument("--id", required=True, help="generated plan id")
    generate_plan.add_argument("--description")
    generate_plan.add_argument("--workspace", action="append", required=True, help="workspace alias=relative-path, repeatable")
    generate_plan.add_argument("--default-workspace", help="default workspace alias for --card entries")
    generate_plan.add_argument(
        "--card",
        action="append",
        required=True,
        help="card path, alias:path, id=path or id=alias:path; repeatable",
    )
    generate_plan.add_argument("--depends", action="append", default=[], help="card-id=dependency-id[,dependency-id], repeatable")
    generate_plan.add_argument("--max-parallel", type=int)
    generate_plan.add_argument("--no-push", action="store_true")
    generate_plan.add_argument("--output", type=Path)
    generate_plan.add_argument("--consumer-root", type=Path)
    generate_plan.set_defaults(func=command_generate_plan)

    run_plan = subparsers.add_parser("run-plan", help="run a validated delivery plan")
    add_plan_common(run_plan)
    run_plan.set_defaults(func=command_run_plan)

    resume_plan = subparsers.add_parser("resume-plan", help="resume an aggregate delivery plan run")
    add_plan_common(resume_plan)
    resume_plan.add_argument("--status-path", type=Path)
    resume_plan.set_defaults(func=command_resume_plan)

    status_plan = subparsers.add_parser("status-plan", help="read aggregate delivery plan status")
    status_plan.add_argument("status_path", nargs="?", type=Path)
    status_plan.add_argument("--consumer-root", type=Path)
    status_plan.add_argument("--runtime-root", type=Path)
    status_plan.add_argument("--run-id", default=utc_run_id())
    status_plan.add_argument("--json", action="store_true")
    status_plan.set_defaults(func=command_status_plan, no_push=False, plan=Path("delivery-plan.json"))

    args = parser.parse_args(argv)
    if args.command in {"run", "preflight", "resume"}:
        workspace_arg = args.workspace
        if args.command == "resume":
            args.status_path = resolve_path(args.status_path)
            prior = load_json_object(args.status_path)
            if args.card is None and isinstance(prior, dict):
                prior_card = prior.get("card", {}).get("path")
                if isinstance(prior_card, str) and prior_card:
                    args.card = prior_card
            if workspace_arg is None and isinstance(prior, dict):
                prior_workspace = prior.get("workspace", {}).get("root")
                if isinstance(prior_workspace, str) and prior_workspace:
                    workspace_arg = Path(prior_workspace)
            if args.card is None:
                args.card = "unknown-card.md"
        args.workspace = resolve_path(workspace_arg) if workspace_arg else invocation_workspace()
        if args.runtime_root:
            args.runtime_root = resolve_path(args.runtime_root, args.workspace)
        else:
            args.runtime_root = args.workspace / ".runtime" / "changerail" / "delivery-runs"
        args.launcher = resolve_path(args.launcher)
    elif args.command == "status":
        args.workspace = resolve_path(args.workspace) if args.workspace else invocation_workspace()
        if args.runtime_root:
            args.runtime_root = resolve_path(args.runtime_root, args.workspace)
        else:
            args.runtime_root = args.workspace / ".runtime" / "changerail" / "delivery-runs"
        if args.status_path is not None:
            args.status_path = resolve_path(args.status_path, args.workspace)
    else:
        args.consumer_root = resolve_path(args.consumer_root) if getattr(args, "consumer_root", None) else invocation_workspace()
        if hasattr(args, "status_path") and args.status_path:
            args.status_path = resolve_path(args.status_path, args.consumer_root)
        if hasattr(args, "plan"):
            args.plan = resolve_path(args.plan, args.consumer_root)
        if getattr(args, "runtime_root", None):
            args.runtime_root = resolve_path(args.runtime_root, args.consumer_root)
        elif hasattr(args, "runtime_root"):
            args.runtime_root = args.consumer_root / ".runtime" / "changerail" / "delivery-plans"
        if hasattr(args, "launcher"):
            args.launcher = resolve_path(args.launcher)
        if hasattr(args, "output") and args.output:
            args.output = resolve_path(args.output, args.consumer_root)
    return args


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
