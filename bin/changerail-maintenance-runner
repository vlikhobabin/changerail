#!/bin/sh
""":"
self="$0"
if command -v readlink >/dev/null 2>&1; then
    resolved=$(readlink -f "$0" 2>/dev/null || true)
    if [ -n "$resolved" ]; then
        self="$resolved"
    fi
fi
exec "$(dirname "$self")/changerail-python" "$0" "$@"
":"""
from __future__ import annotations

# Launch the ChangeRail maintenance runner from a repo or symlinked wrapper.

import json
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SCRIPT = ROOT / "scripts" / "changerail_maintenance_runner.py"


def missing_helper() -> int:
    payload = {
        "ok": False,
        "diagnostic": {
            "kind": "changerail_maintenance_runner",
            "code": "helper_missing",
            "message": "ChangeRail maintenance runner helper could not be found from the wrapper.",
            "expected_path": str(SCRIPT),
        },
    }
    print(json.dumps(payload, ensure_ascii=False), file=sys.stderr)
    return 2


def main() -> int:
    if not SCRIPT.is_file():
        return missing_helper()
    sys.path.insert(0, str(ROOT / "scripts"))
    from changerail_maintenance_runner import main as runner_main

    return runner_main()


if __name__ == "__main__":
    raise SystemExit(main())
