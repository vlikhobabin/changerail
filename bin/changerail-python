#!/bin/sh
set -u

MIN_MAJOR=3
MIN_MINOR=11
REQUIRED_MODULES="tomllib jsonschema markdown_it"

resolve_self() {
    self=$1
    if command -v readlink >/dev/null 2>&1; then
        resolved=$(readlink -f "$self" 2>/dev/null || true)
        if [ -n "$resolved" ]; then
            self=$resolved
        fi
    fi
    printf '%s\n' "$self"
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

self=$(resolve_self "$0")
self_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd -P)
root=$(CDPATH= cd -- "$self_dir/.." && pwd -P)

check_only=0
json_output=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        --check)
            check_only=1
            shift
            ;;
        --json)
            json_output=1
            shift
            ;;
        --help)
            printf 'usage: %s [--check] [--json] [script.py [args...]]\n' "$0"
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

target=${1:-}

fail() {
    code=$1
    message=$2
    if [ "$json_output" -eq 1 ]; then
        escaped=$(json_escape "$message")
        printf '{"ok":false,"diagnostic":{"kind":"changerail_python_runtime","message":"%s"}}\n' "$escaped"
    else
        printf '%s\n' "$message" >&2
    fi
    exit "$code"
}

candidate_source=default
candidate=${CHANGERAIL_PYTHON:-}
if [ -n "$candidate" ]; then
    candidate_source=CHANGERAIL_PYTHON
else
    if command -v python3 >/dev/null 2>&1; then
        candidate=python3
    elif command -v python >/dev/null 2>&1; then
        candidate=python
    else
        fail 2 "ChangeRail Python runtime error: no Python interpreter found; install Python 3.11 or newer and runtime dependencies from requirements-runtime.txt, or set CHANGERAIL_PYTHON."
    fi
fi

if [ "$candidate_source" = "CHANGERAIL_PYTHON" ]; then
    if [ -z "$candidate" ]; then
        fail 2 "ChangeRail Python runtime error: CHANGERAIL_PYTHON invalid: empty override; unset it or point it to Python 3.11 or newer."
    fi
    if [ -n "${candidate##*/*}" ]; then
        if ! command -v "$candidate" >/dev/null 2>&1; then
            fail 2 "ChangeRail Python runtime error: CHANGERAIL_PYTHON invalid: interpreter '$candidate' was not found; unset it or point it to Python 3.11 or newer."
        fi
    elif [ ! -x "$candidate" ]; then
        fail 2 "ChangeRail Python runtime error: CHANGERAIL_PYTHON invalid: interpreter '$candidate' is missing or not executable; unset it or point it to Python 3.11 or newer."
    fi
fi

resolved_candidate=$(command -v "$candidate" 2>/dev/null || true)
if [ -z "$resolved_candidate" ]; then
    resolved_candidate=$candidate
fi

probe='import importlib.util, sys
required = ("tomllib", "jsonschema", "markdown_it")
missing = [name for name in required if importlib.util.find_spec(name) is None]
version = "%d.%d.%d" % sys.version_info[:3]
print(version + "|" + sys.executable + "|" + ",".join(missing))
'

probe_output=$("$resolved_candidate" -c "$probe" 2>&1)
probe_status=$?
if [ "$probe_status" -ne 0 ]; then
    fail 2 "ChangeRail Python runtime error: selected interpreter '$resolved_candidate' could not run the runtime probe; set CHANGERAIL_PYTHON to Python 3.11 or newer. Probe output: $probe_output"
fi

probe_line=$(printf '%s\n' "$probe_output" | sed -n '1p')
version=${probe_line%%|*}
rest=${probe_line#*|}
executable=${rest%%|*}
missing_modules=${rest#*|}

case "$version" in
    *.*.*) ;;
    *)
        fail 2 "ChangeRail Python runtime error: selected interpreter '$resolved_candidate' returned an invalid runtime probe result; set CHANGERAIL_PYTHON to Python 3.11 or newer."
        ;;
esac

major=${version%%.*}
minor_patch=${version#*.}
minor=${minor_patch%%.*}

if [ "$major" -lt "$MIN_MAJOR" ] || { [ "$major" -eq "$MIN_MAJOR" ] && [ "$minor" -lt "$MIN_MINOR" ]; }; then
    fail 2 "ChangeRail Python runtime error: selected interpreter '$resolved_candidate' is Python $version; Python 3.11 or newer is required. Install a supported interpreter or set CHANGERAIL_PYTHON to one."
fi

if [ -n "$missing_modules" ]; then
    fail 2 "ChangeRail Python runtime error: selected interpreter '$resolved_candidate' is missing runtime module(s): $missing_modules. Install runtime dependencies with: $resolved_candidate -m pip install -r requirements-runtime.txt"
fi

runtime_dir="${CHANGERAIL_RUNTIME_ROOT:-$root/.runtime/changerail}/python-runtime"
mkdir -p "$runtime_dir" 2>/dev/null || true
state_path="$runtime_dir/last-check.json"
timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'unknown')
tmp_state="$state_path.$$"
if [ -d "$runtime_dir" ]; then
    escaped_executable=$(json_escape "$executable")
    escaped_source=$(json_escape "$candidate_source")
    escaped_version=$(json_escape "$version")
    {
        printf '{\n'
        printf '  "schema": "changerail.python-runtime-check.v1",\n'
        printf '  "checked_at": "%s",\n' "$timestamp"
        printf '  "source": "%s",\n' "$escaped_source"
        printf '  "executable": "%s",\n' "$escaped_executable"
        printf '  "version": "%s",\n' "$escaped_version"
        printf '  "required_modules": ["tomllib", "jsonschema", "markdown_it"]\n'
        printf '}\n'
    } > "$tmp_state" 2>/dev/null && mv "$tmp_state" "$state_path" 2>/dev/null || rm -f "$tmp_state"
fi

if [ "$json_output" -eq 1 ] && [ "$check_only" -eq 1 ]; then
    escaped_executable=$(json_escape "$executable")
    escaped_source=$(json_escape "$candidate_source")
    escaped_version=$(json_escape "$version")
    printf '{"ok":true,"source":"%s","executable":"%s","version":"%s","required_modules":["tomllib","jsonschema","markdown_it"]}\n' "$escaped_source" "$escaped_executable" "$escaped_version"
fi

if [ "$check_only" -eq 1 ]; then
    exit 0
fi

if [ -z "$target" ]; then
    fail 2 "ChangeRail Python runtime error: no target script supplied."
fi
shift

export CHANGERAIL_PYTHON_RESOLVED="$executable"
scripts_path="$root/scripts"
if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$scripts_path:$PYTHONPATH"
else
    export PYTHONPATH="$scripts_path"
fi

exec "$resolved_candidate" "$target" "$@"
