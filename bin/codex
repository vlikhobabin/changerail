#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export CODEX_HOME="${CODEX_HOME:-$repo_root/.codex}"
export CODEX_WORKDIR="${CODEX_WORKDIR:-$repo_root}"

# Resolve the user's dispatcher before any project-local PATH additions. It
# chooses the pool globally and keeps this repository's CODEX_HOME/MCP overlay.
codex_bin="${CHANGERAIL_CODEX_BIN:-$(command -v codex)}"
exec "$codex_bin" -C "$CODEX_WORKDIR" "$@"
