#!/bin/sh
# Invoke the selected project’s pinned dependency; never download implicitly.
set -eu
if [ "${1:-}" = --project ]; then
    CHRL_PROJECT_ROOT=$(CDPATH= cd -P "$2" && pwd)
    export CHRL_PROJECT_ROOT
    shift 2
    cd "$CHRL_PROJECT_ROOT"
fi
openspec_project_root=${CHRL_PROJECT_ROOT:-$(CDPATH= cd -P "$(dirname -- "$0")/.." && pwd)}
openspec_dependency_root="$openspec_project_root/tools/openspec"

export PYTHONDONTWRITEBYTECODE=1
export OPENSPEC_TELEMETRY=0 DO_NOT_TRACK=1 CI=true
export OPENSPEC_NO_COMPLETIONS=1 OPENSPEC_NO_AUTO_CONFIG=1
export OPENSPEC_NO_UPDATE_CHECK=1 NO_UPDATE_NOTIFIER=1
export npm_config_update_notifier=false

if ! command -v node >/dev/null 2>&1; then
    echo 'openspec: Node.js >=20.19.0 is required; no automatic installation is attempted.' >&2
    exit 1
fi
openspec_helper_root="$openspec_dependency_root"
if [ -e "$openspec_project_root/.changerail/engine-binding.json" ] || [ -L "$openspec_project_root/.changerail/engine-binding.json" ] || [ -n "${CHRL_ENGINE_ROOT:-}" ]; then
    CHRL_PROJECT_ROOT="$openspec_project_root"
    export CHRL_PROJECT_ROOT
    openspec_source_root=$(dirname "$(dirname "$(readlink -f "$0")")")
    openspec_python="$openspec_project_root/.venv/bin/python"
    if [ ! -x "$openspec_python" ]; then openspec_python=$(command -v python3); fi
    openspec_engine_root=$(PYTHONPATH="$openspec_source_root" "$openspec_python" -P -m scripts.changerail.engine_runtime --engine-root)
    openspec_helper_root="$openspec_engine_root/tools/openspec"
fi
node "$openspec_helper_root/check-install.mjs"
exec node "$openspec_dependency_root/node_modules/@fission-ai/openspec/bin/openspec.js" "$@"
