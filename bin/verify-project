self="$0"
if command -v readlink >/dev/null 2>&1; then
    resolved=$(readlink -f "$0" 2>/dev/null || true)
    if [ -n "$resolved" ]; then
        self="$resolved"
    fi
fi
exec "$(dirname "$self")/changerail-python" "$0" "$@"
":"""
