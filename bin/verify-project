@dataclass
class Check:
    name: str
    ok: bool
    message: str
    severity: str = "blocking"
    status: str = ""

    def __post_init__(self) -> None:
        if not self.status:
            self.status = "pass" if self.ok else "fail"


@dataclass
class Advisory:
    name: str
    status: str
    message: str
    severity: str = "info"


@dataclass(frozen=True)
class BaselineDebt:
    command: str
    residual_risk: str
    rationale: str


@dataclass(frozen=True)
class VerificationPolicy:
    profile: str
    surfaces: dict[str, str]
    targeted_openspec_validation: str
    baseline_debt: tuple[BaselineDebt, ...]


@dataclass(frozen=True)
class BootstrapProfileDeclaration:
    project_profile: str
    surfaces_profile: str
    codex_policy: str


@dataclass(frozen=True)
class LockedNpmPackage:
    name: str
    version: str
    integrity: str
    source: str


def is_relative_to(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def print_check(check: Check) -> None:
    if check.severity == "info":
        status = "INFO"
    elif check.severity == "non-blocking" and check.status == "fail":
        status = "WARN"
    elif check.status == "skip":
        status = "SKIP"
    else:
        status = "PASS" if check.ok else "FAIL"
    print(f"{status} {check.name}: {check.message}")


def print_advisory(advisory: Advisory) -> None:
    status = "INFO" if advisory.status == "pass" else "WARN"
    print(f"{status} {advisory.name}: {advisory.message}")


def as_diagnostic(check: Check, message: str | None = None) -> Check:
    return Check(check.name, False, message or check.message, severity="non-blocking")


def policy_error(message: str) -> Check:
    return Check("verification policy", False, message)


def optional_missing(name: str, surface: str) -> Check:
    return Check(name, False, f"optional {surface} surface is missing", severity="non-blocking")


def forbidden_present(name: str, paths: list[str]) -> Check:
    return Check(name, False, "forbidden surface paths present: " + ", ".join(paths))


def forbidden_absent(name: str, surface: str) -> Check:
    return Check(name, True, f"forbidden {surface} surface is absent")


def skill_names(changerail_root: Path) -> list[str]:
    skills_root = changerail_root / "skills"
    if not skills_root.is_dir():
        return []
    return sorted(
        path.name
        for path in skills_root.iterdir()
        if path.is_dir() and (path / "SKILL.md").is_file()
    )


def expected_rel(expected: Path, changerail_root: Path) -> Path:
    try:
        return expected.resolve(strict=False).relative_to(changerail_root.resolve(strict=False))
    except ValueError:
        return Path(expected.name)


def accepted_target(resolved: Path, expected: Path, changerail_root: Path, aggregator_root: Path | None) -> tuple[bool, str]:
    expected_resolved = expected.resolve(strict=False)
    if resolved == expected_resolved:
        return True, f"resolves to {expected_resolved}"
    if is_relative_to(resolved, changerail_root):
        return False, f"resolves under ChangeRail but expected {expected_resolved}, got {resolved}"
    if aggregator_root is not None and is_relative_to(resolved, aggregator_root):
        rel = expected_rel(expected, changerail_root)
        try:
            agg_rel = resolved.relative_to(aggregator_root)
        except ValueError:
            agg_rel = Path()
        if agg_rel == rel:
            return True, f"resolves through aggregator {aggregator_root}"
        return False, f"aggregator path {resolved} does not match expected relative path {rel}"
    return False, f"resolves outside ChangeRail source: {resolved}"


def check_symlink(project: Path, rel_path: str, expected: Path, changerail_root: Path, aggregator_root: Path | None) -> Check:
    path = project / rel_path
    if not path.exists() and not path.is_symlink():
        return Check(rel_path, False, "missing")
    if not path.is_symlink():
        return Check(rel_path, False, "exists but is not a symlink")
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        return Check(rel_path, False, f"broken symlink: {exc}")
    ok, message = accepted_target(resolved, expected, changerail_root, aggregator_root)
    return Check(rel_path, ok, message)


def digest_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return f"sha256:{digest.hexdigest()}"


def digest_path(path: Path) -> str:
    if path.is_file() or path.is_symlink():
        return digest_file(path)
    if not path.is_dir():
        raise OSError(f"unsupported path for digest: {path}")
    digest = hashlib.sha256()
    for candidate in sorted(path.rglob("*")):
        if not (candidate.is_file() or candidate.is_symlink()):
            continue
        rel = candidate.relative_to(path).as_posix()
        digest.update(b"file\0")
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        digest.update(digest_file(candidate).encode("ascii"))
        digest.update(b"\0")
    return f"sha256:{digest.hexdigest()}"


def load_wiring_manifest(project: Path) -> tuple[dict[str, object] | None, Check | None]:
    path = project / WIRING_MANIFEST_REL
    if not path.is_file():
        return None, None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return None, Check(str(WIRING_MANIFEST_REL), False, f"cannot read generated wiring manifest: {exc}")
    if not isinstance(data, dict) or data.get("schema") != WIRING_MANIFEST_SCHEMA:
        return None, Check(str(WIRING_MANIFEST_REL), False, "unsupported generated wiring manifest schema")
    return data, Check(str(WIRING_MANIFEST_REL), True, "generated wiring manifest is readable")


def schema_error_path(error: jsonschema.ValidationError) -> str:
    path = "$"
    for part in error.absolute_path:
        path += f"[{part}]" if isinstance(part, int) else f".{part}"
    return path


def load_consumer_lock(
    project: Path,
    changerail_root: Path,
) -> tuple[dict[str, object] | None, Check]:
    path = project / CONSUMER_LOCK_REL
    if not path.is_file():
        return None, Check(
            "consumer lock schema",
            True,
            "lockless legacy compatibility path",
            severity="info",
            status="skip",
        )
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return None, Check("consumer lock schema", False, f"consumer lock is unreadable: {exc}")
    schema_path = changerail_root / "schemas" / "changerail-consumer-lock.schema.json"
    try:
        schema = json.loads(schema_path.read_text(encoding="utf-8"))
        validator = jsonschema.Draft202012Validator(schema)
        errors = sorted(validator.iter_errors(data), key=lambda error: list(error.absolute_path))
    except (OSError, json.JSONDecodeError, jsonschema.SchemaError) as exc:
        return None, Check("consumer lock schema", False, f"consumer lock schema is unavailable: {exc}")
    if errors:
        paths = ", ".join(dict.fromkeys(schema_error_path(error) for error in errors[:5]))
        return None, Check(
            "consumer lock schema",
            False,
            f"consumer lock failed schema validation at {paths}",
        )
    if not isinstance(data, dict) or data.get("schema") != CONSUMER_LOCK_SCHEMA:
        return None, Check("consumer lock schema", False, "unsupported consumer lock schema")
    return data, Check("consumer lock schema", True, "consumer lock is schema-valid and public-safe")


def consumer_lock_skip(name: str, message: str) -> Check:
    return Check(name, True, message, severity="info", status="skip")


def check_consumer_wiring(
    project: Path,
    changerail_root: Path,
    lock: dict[str, object] | None,
) -> Check:
    if lock is None:
        return consumer_lock_skip("consumer wiring validity", "no valid consumer lock to inspect")
    wiring = lock.get("wiring")
    if not isinstance(wiring, dict):
        return Check("consumer wiring validity", False, "consumer lock wiring section is invalid")
    backend = wiring.get("backend")
    if backend != "symlink":
        return Check(
            "consumer wiring validity",
            True,
            f"{backend} wiring ownership is validated by the generated wiring manifest",
        )
    path_mode = wiring.get("path_mode")
    artifacts = wiring.get("artifacts")
    if not isinstance(artifacts, list):
        return Check("consumer wiring validity", False, "consumer lock artifacts are invalid")
    failures: list[str] = []
    project_root = project.resolve()
    source_root = changerail_root.resolve()
    for entry in artifacts:
        if not isinstance(entry, dict):
            failures.append("invalid artifact entry")
            continue
        rel_path = entry.get("path")
        source_rel = entry.get("source")
        if not isinstance(rel_path, str) or not isinstance(source_rel, str):
            failures.append("incomplete artifact entry")
            continue
        destination = project / rel_path
        expected = changerail_root / source_rel
        try:
            destination.relative_to(project_root)
            expected.resolve(strict=False).relative_to(source_root)
        except ValueError:
            failures.append(f"{rel_path}: scope escape")
            continue
        if not destination.is_symlink():
            failures.append(f"{rel_path}: missing or project-owned non-symlink path")
            continue
        raw_target = os.readlink(destination)
        if path_mode == "absolute" and not Path(raw_target).is_absolute():
            failures.append(f"{rel_path}: expected absolute symlink target")
        if path_mode == "relative" and Path(raw_target).is_absolute():
            failures.append(f"{rel_path}: expected relative symlink target")
        try:
            resolved = destination.resolve(strict=True)
            expected_resolved = expected.resolve(strict=True)
        except OSError:
            failures.append(f"{rel_path}: broken symlink")
            continue
        if resolved != expected_resolved:
            failures.append(f"{rel_path}: target differs from declared source")
    if failures:
        return Check("consumer wiring validity", False, "; ".join(failures[:8]))
    return Check("consumer wiring validity", True, "all lock-owned wiring matches declared intent")


def check_consumer_source_revision(
    changerail_root: Path,
    lock: dict[str, object] | None,
) -> Check:
    if lock is None:
        return consumer_lock_skip("consumer source revision", "no valid consumer lock to compare")
    metadata = lock.get("changerail")
    if not isinstance(metadata, dict):
        return Check("consumer source revision", False, "consumer lock source metadata is invalid")
    expected_revision = metadata.get("revision")
    expected_version = metadata.get("version")
    try:
        version = (changerail_root / "VERSION").read_text(encoding="utf-8").strip()
        result = subprocess.run(
            ["git", "-C", str(changerail_root), "rev-parse", "HEAD"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    except OSError as exc:
        return Check("consumer source revision", False, f"cannot inspect ChangeRail source: {exc}")
    revision = result.stdout.strip() if result.returncode == 0 else ""
    matches = revision == expected_revision and version == expected_version
    if matches:
        return Check("consumer source revision", True, "ChangeRail version and revision match consumer lock")
    enforcement = lock.get("enforcement")
    message = "ChangeRail source drifted from consumer lock; install the locked revision or refresh the lock"
    if enforcement == "advisory":
        return Check("consumer source revision", False, message, severity="non-blocking")
    return Check("consumer source revision", False, message)


def manifest_artifact(manifest: dict[str, object] | None, rel_path: str) -> dict[str, object] | None:
    if not manifest:
        return None
    artifacts = manifest.get("artifacts")
    if not isinstance(artifacts, list):
        return None
    for entry in artifacts:
        if isinstance(entry, dict) and entry.get("path") == rel_path:
            return entry
    return None


def manifest_declares_any(manifest: dict[str, object] | None, rel_paths: Iterable[str]) -> bool:
    if not manifest:
        return False
    targets = set(rel_paths)
    artifacts = manifest.get("artifacts")
    if not isinstance(artifacts, list):
        return False
    for entry in artifacts:
        if not isinstance(entry, dict):
            continue
        path = entry.get("path")
        source = entry.get("source")
        if isinstance(path, str) and path in targets:
            return True
        if isinstance(source, str) and source in targets:
            return True
    return False


def generated_wiring_active(manifest: dict[str, object] | None) -> bool:
    return bool(manifest and manifest.get("backend") == "generated-copy")


def manifest_backend(manifest: dict[str, object] | None) -> str:
    if not manifest:
        return ""
    value = manifest.get("backend")
    return value if isinstance(value, str) else ""


def check_generated_artifact(
    project: Path,
    rel_path: str,
    expected: Path,
    changerail_root: Path,
    manifest: dict[str, object] | None,
) -> Check:
    entry = manifest_artifact(manifest, rel_path)
    if entry is None:
        return Check(rel_path, False, "missing generated ownership metadata")
    if entry.get("owner") != "generated":
        return Check(rel_path, False, "project-owned divergence: artifact is not generated-owned")
    source_rel = entry.get("source")
    recorded_digest = entry.get("digest")
    if not isinstance(source_rel, str) or not source_rel:
        return Check(rel_path, False, "generated ownership metadata missing source identity")
    if not isinstance(recorded_digest, str) or not recorded_digest:
        return Check(rel_path, False, "generated ownership metadata missing digest")
    expected_rel = expected.resolve(strict=False).relative_to(changerail_root.resolve(strict=False)).as_posix()
    if source_rel != expected_rel:
        return Check(rel_path, False, f"generated source identity mismatch: expected {expected_rel}, got {source_rel}")
    destination = project / rel_path
    source = changerail_root / source_rel
    if not destination.exists() and not destination.is_symlink():
        return Check(rel_path, False, "generated artifact missing")
    try:
        source_digest = digest_path(source)
        destination_digest = digest_path(destination)
    except OSError as exc:
        return Check(rel_path, False, f"generated digest check failed: {exc}")
    if destination_digest != recorded_digest and destination_digest != source_digest:
        return Check(rel_path, False, "project-owned divergence: generated artifact content differs from manifest")
    if source_digest != recorded_digest or destination_digest != source_digest:
        return Check(
            rel_path,
            False,
            "stale generated wiring; run bin/bootstrap-project <project> --refresh-wiring",
        )
    return Check(rel_path, True, "generated artifact matches ChangeRail source and ownership metadata")


def is_junction(path: Path) -> bool:
    checker = getattr(os.path, "isjunction", None)
    if checker is None:
        return False
    return bool(checker(path))


def check_junction_artifact(
    project: Path,
    rel_path: str,
    expected: Path,
    changerail_root: Path,
    manifest: dict[str, object] | None,
) -> Check:
    entry = manifest_artifact(manifest, rel_path)
    if entry is None:
        return Check(rel_path, False, "missing junction ownership metadata")
    if entry.get("owner") != "junction":
        return Check(rel_path, False, "artifact is not recorded as junction-owned")
    source_rel = entry.get("source")
    if not isinstance(source_rel, str) or not source_rel:
        return Check(rel_path, False, "junction metadata missing source identity")
    expected_rel = expected.resolve(strict=False).relative_to(changerail_root.resolve(strict=False)).as_posix()
    if source_rel != expected_rel:
        return Check(rel_path, False, f"junction source identity mismatch: expected {expected_rel}, got {source_rel}")
    destination = project / rel_path
    if not destination.exists():
        return Check(rel_path, False, "junction artifact missing")
    if not is_junction(destination):
        return Check(rel_path, False, "path exists but is not a Windows junction")
    try:
        resolved = destination.resolve(strict=True)
    except OSError as exc:
        return Check(rel_path, False, f"junction target cannot be resolved: {exc}")
    ok, message = accepted_target(resolved, expected, changerail_root, None)
    return Check(rel_path, ok, message if ok else f"junction target invalid: {message}")


def check_wiring_path(
    project: Path,
    rel_path: str,
    expected: Path,
    changerail_root: Path,
    aggregator_root: Path | None,
    manifest: dict[str, object] | None,
) -> Check:
    entry = manifest_artifact(manifest, rel_path)
    if generated_wiring_active(manifest) or (entry and entry.get("owner") == "generated"):
        return check_generated_artifact(project, rel_path, expected, changerail_root, manifest)
    if manifest_backend(manifest) == "junction" and entry and entry.get("owner") == "junction":
        return check_junction_artifact(project, rel_path, expected, changerail_root, manifest)
    return check_symlink(project, rel_path, expected, changerail_root, aggregator_root)


def proof_checks(proof: object) -> dict[str, dict[str, object]]:
    result: dict[str, dict[str, object]] = {}
    if not isinstance(proof, dict):
        return result
    checks = proof.get("checks")
    if not isinstance(checks, list):
        return result
    for check in checks:
        if not isinstance(check, dict):
            continue
        name = check.get("name")
        if isinstance(name, str) and name:
            result[name] = check
    return result


def proof_value_is_non_empty_string(value: object) -> bool:
    return isinstance(value, str) and bool(value.strip())


def proof_evidence_is_concrete(evidence: object) -> bool:
    if not isinstance(evidence, dict):
        return False
    if any(
        proof_value_is_non_empty_string(evidence.get(field))
        for field in ("command", "operation", "raw_output_path")
    ):
        return True
    argv = evidence.get("command_argv")
    return isinstance(argv, list) and any(proof_value_is_non_empty_string(item) for item in argv)


def proof_check_has_concrete_evidence(check: dict[str, object]) -> bool:
    if check.get("status") not in PROOF_STATUS_PASS:
        return False
    if not proof_value_is_non_empty_string(check.get("category")):
        return False
    if not proof_value_is_non_empty_string(check.get("message")):
        return False
    details = check.get("details")
    if not isinstance(details, dict) or not details:
        return False
    return proof_evidence_is_concrete(check.get("evidence"))


def git_safety_proof_error(name: str, check: dict[str, object]) -> str | None:
    if name not in GIT_SAFETY_PROOF_NAMES:
        return None
    details = check.get("details")
    if not isinstance(details, dict):
        return f"{name} missing Git safety details"
    if details.get("safe") is not True:
        if details.get("safe") is False:
            return f"{name} reports unsafe Git staging evidence"
        return f"{name} missing positive Git safety classification"
    if "unsafe_paths" not in details:
        return f"{name} missing unsafe_paths Git safety classification"
    unsafe_paths = details.get("unsafe_paths")
    if not isinstance(unsafe_paths, list):
        return f"{name} unsafe_paths must be an array"
    unsafe = [path for path in unsafe_paths if isinstance(path, str) and path.strip()]
    if unsafe:
        return f"{name} reports unsafe Git staging paths: {unsafe_git_path_summary(unsafe)}"
    return None


def unsafe_git_path_summary(paths: list[str]) -> str:
    counts: dict[str, int] = {}
    for path in paths:
        label = unsafe_git_path_label(path)
        counts[label] = counts.get(label, 0) + 1
    categories = ", ".join(f"{label}={count}" for label, count in sorted(counts.items()))
    return f"{len(paths)} path(s) ({categories})"


def unsafe_git_path_label(path: str) -> str:
    normalized = path.replace("\\", "/").lower()
    for label, markers in UNSAFE_GIT_PATH_MARKERS:
        if any(marker in normalized for marker in markers):
            return label
    if len(normalized) >= 3 and normalized[1] == ":" and normalized[2] == "/":
        return "absolute-windows-path"
    if normalized.startswith("/"):
        return "absolute-path"
    return "project-path"


def fallback_proof_errors(proof: object, backend: str, groups: tuple[tuple[str, ...], ...]) -> list[str]:
    if not isinstance(proof, dict):
        return ["proof is missing or is not an object"]
    errors: list[str] = []
    if proof.get("schema") != FALLBACK_PROOF_SCHEMA:
        errors.append("unsupported proof schema")
    if proof.get("mode") != backend:
        errors.append("proof mode mismatch")
    source = proof.get("source")
    if not isinstance(source, dict):
        errors.append("missing proof source metadata")
    else:
        kind = source.get("kind")
        tool = source.get("tool")
        if not proof_value_is_non_empty_string(kind) or not proof_value_is_non_empty_string(tool):
            errors.append("proof source must include kind and tool")
        if str(kind) in {"sample", "dry-run", "status-only"}:
            errors.append(f"proof source {kind!r} is not concrete evidence")
    checks = proof_checks(proof)
    missing = [
        aliases[0]
        for aliases in groups
        if not any(
            alias in checks and proof_check_has_concrete_evidence(checks[alias])
            for alias in aliases
        )
    ]
    if missing:
        errors.append("missing concrete passed evidence: " + ", ".join(missing))
    for name, check in checks.items():
        error = git_safety_proof_error(name, check)
        if error:
            errors.append(error)
    return errors


def check_generated_wiring_manifest(project: Path, changerail_root: Path, manifest: dict[str, object] | None) -> list[Check]:
    if not manifest:
        return []
    backend = manifest.get("backend")
    platform = manifest.get("platform")
    checks: list[Check] = []
    if backend == "generated-copy":
        artifacts = manifest.get("artifacts")
        if not isinstance(artifacts, list) or not artifacts:
            return [Check(str(WIRING_MANIFEST_REL), False, "generated-copy manifest has no artifacts")]
        for entry in artifacts:
            if not isinstance(entry, dict):
                checks.append(Check(str(WIRING_MANIFEST_REL), False, "generated artifact entry is not an object"))
                continue
            rel_path = entry.get("path")
            source_rel = entry.get("source")
            if not isinstance(rel_path, str) or not isinstance(source_rel, str):
                checks.append(Check(str(WIRING_MANIFEST_REL), False, "generated artifact entry missing path or source"))
                continue
            checks.append(
                check_generated_artifact(
                    project,
                    rel_path,
                    changerail_root / source_rel,
                    changerail_root,
                    manifest,
                )
            )
        return checks
    if platform == "windows" and backend == "symlink":
        proof = manifest.get("fallback_proof")
        errors = fallback_proof_errors(proof, "symlink", SYMLINK_PROOF_GROUPS)
        ok = not errors
        return [
            Check(
                "Windows symlink fallback proof",
                ok,
                "positive symlink fallback proof recorded with concrete evidence"
                if ok
                else "invalid symlink fallback proof: " + "; ".join(errors),
            )
        ]
    if platform == "windows" and backend == "junction":
        proof = manifest.get("fallback_proof")
        errors = fallback_proof_errors(proof, "junction", JUNCTION_PROOF_GROUPS)
        ok = not errors
        return [
            Check(
                "Windows junction fallback proof",
                ok,
                "positive cleanup and Git-safety proof recorded with concrete evidence"
                if ok
                else "invalid junction fallback proof: " + "; ".join(errors),
            )
        ]
    return []


def path_args_cover_root(args: Iterable[object], project: Path, base: Path) -> bool:
    root = project.resolve()
    for value in args:
        if not isinstance(value, str):
            continue
        try:
            candidate = Path(value)
            if not candidate.is_absolute():
                candidate = base / candidate
            if candidate.resolve(strict=False) == root:
                return True
        except OSError:
            continue
    return False


def check_mcp(project: Path) -> Check:
    path = project / ".mcp.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        return Check(".mcp.json", False, f"cannot read: {exc}")
    except json.JSONDecodeError as exc:
        return Check(".mcp.json", False, f"invalid JSON: {exc}")
    server = data.get("mcpServers", {}).get("filesystem", {})
    args = server.get("args", [])
    if not isinstance(args, list):
        return Check(".mcp.json", False, "filesystem args must be an array")
    if not path_args_cover_root(args, project, project):
        return Check(".mcp.json", False, "filesystem scope does not cover project root")
    return Check(".mcp.json", True, "filesystem scope covers project root")


def check_codex(project: Path) -> Check:
    path = project / ".codex" / "config.toml"
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        return Check(".codex/config.toml", False, f"cannot read: {exc}")
    except tomllib.TOMLDecodeError as exc:
        return Check(".codex/config.toml", False, f"invalid TOML: {exc}")

    project_key = str(project.resolve())
    projects = data.get("projects", {})
    if project_key not in projects and "." not in projects:
        return Check(".codex/config.toml", False, f"missing trusted project entry {project_key} or .")
    filesystem = data.get("mcp_servers", {}).get("filesystem", {})
    args = filesystem.get("args", [])
    if not isinstance(args, list):
        return Check(".codex/config.toml", False, "filesystem args must be an array")
    if not path_args_cover_root(args, project, project):
        return Check(".codex/config.toml", False, "filesystem MCP scope does not cover project root")
    return Check(
        ".codex/config.toml",
        True,
        "static trusted project and filesystem scope cover project root",
    )


def check_instruction_budget(project: Path) -> Check:
    config_path = project / ".codex" / "config.toml"
    try:
        config = tomllib.loads(config_path.read_text(encoding="utf-8"))
    except OSError as exc:
        return Check("static Codex instruction budget", False, f"cannot read config: {exc}")
    except tomllib.TOMLDecodeError as exc:
        return Check("static Codex instruction budget", False, f"invalid config TOML: {exc}")

    configured = config.get("project_doc_max_bytes")
    if configured is None:
        budget = DEFAULT_PROJECT_DOC_MAX_BYTES
        budget_source = "compatibility default"
    elif isinstance(configured, bool) or not isinstance(configured, int) or configured <= 0:
        return Check(
            "static Codex instruction budget",
            False,
            "project_doc_max_bytes must be a positive integer",
        )
    else:
        budget = configured
        budget_source = "tracked config"

    agents_path = project / "AGENTS.md"
    try:
        raw = agents_path.read_bytes()
        raw.decode("utf-8")
    except OSError as exc:
        return Check("static Codex instruction budget", False, f"cannot read AGENTS.md: {exc}")
    except UnicodeDecodeError as exc:
        return Check("static Codex instruction budget", False, f"AGENTS.md is not valid UTF-8: {exc}")

    measured = len(raw)
    measurement = f"{measured} measured UTF-8 bytes / {budget} allowed bytes ({budget_source})"
    remediation = (
        "reduce project/shared instructions, move operational detail to skills/docs, or review an "
        "explicit tracked budget change"
    )
    if measured > budget:
        return Check(
            "static Codex instruction budget",
            False,
            f"{measurement}; over budget: {remediation}",
        )
    if measured * 100 >= budget * PROJECT_DOC_WARNING_PERCENT:
        return Check(
            "static Codex instruction budget",
            False,
            f"{measurement}; at or above {PROJECT_DOC_WARNING_PERCENT}% warning threshold: {remediation}",
            severity="non-blocking",
        )
    return Check(
        "static Codex instruction budget",
        True,
        f"{measurement}; below {PROJECT_DOC_WARNING_PERCENT}% warning threshold",
    )


def runtime_diagnostics_result(
    status: str,
    reason: str,
    *,
    codex_version: str | None = None,
    evidence_dir: str | None = None,
    probes: dict[str, object] | None = None,
) -> dict[str, object]:
    return {
        "schema": RUNTIME_DIAGNOSTICS_SCHEMA,
        "status": status,
        "reason": reason,
        "adapter": (
            "codex-cli-0.147-doctor-v1"
            if codex_version and codex_version.startswith("0.147.")
            else None
        ),
        "codex_version": codex_version,
        "codex_home_class": "project-local",
        "evidence_dir": evidence_dir,
        "probes": probes or {},
    }


def runtime_evidence_directory(project: Path) -> tuple[Path | None, str | None]:
    try:
        ignore_lines = {
            line.strip()
            for line in (project / ".gitignore").read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        }
    except OSError:
        return None, None
    if ".runtime/" not in ignore_lines:
        return None, None
    current = project
    for part in (".runtime", "changerail", "diagnostics"):
        current = current / part
        if current.is_symlink():
            return None, None
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    rel_path = Path(".runtime") / "changerail" / "diagnostics" / f"{stamp}-{secrets.token_hex(4)}"
    path = project / rel_path
    try:
        path.parent.resolve(strict=False).relative_to(project.resolve())
        path.mkdir(parents=True, exist_ok=False)
    except (OSError, ValueError):
        return None, None
    return path, rel_path.as_posix()


def execute_runtime_probe(
    executable: str,
    arguments: list[str],
    *,
    project: Path,
    env: dict[str, str],
    evidence_dir: Path,
    evidence_name: str,
    timeout: int,
) -> tuple[int | None, bytes, bytes]:
    try:
        result = subprocess.run(
            [executable, *arguments],
            cwd=project,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        stdout = result.stdout
        stderr = result.stderr
        returncode: int | None = result.returncode
    except (OSError, subprocess.TimeoutExpired) as exc:
        stdout = exc.stdout if isinstance(exc, subprocess.TimeoutExpired) and exc.stdout else b""
        stderr = exc.stderr if isinstance(exc, subprocess.TimeoutExpired) and exc.stderr else b""
        returncode = None
    try:
        (evidence_dir / f"{evidence_name}.stdout").write_bytes(stdout)
        (evidence_dir / f"{evidence_name}.stderr").write_bytes(stderr)
    except OSError:
        return None, b"", b""
    return returncode, stdout, stderr


def parse_doctor_summary(data: object, codex_version: str) -> tuple[dict[str, object] | None, str]:
    if not isinstance(data, dict) or data.get("schemaVersion") != 1:
        return None, "doctor-schema-unsupported"
    if data.get("codexVersion") != codex_version:
        return None, "doctor-version-mismatch"
    overall = data.get("overallStatus")
    if overall not in {"ok", "warning", "error"}:
        return None, "doctor-status-invalid"
    checks = data.get("checks")
    if not isinstance(checks, dict):
        return None, "doctor-checks-invalid"
    selected: dict[str, str] = {}
    for name in RUNTIME_DOCTOR_CHECKS:
        item = checks.get(name)
        if not isinstance(item, dict) or item.get("status") not in {
            "ok",
            "warning",
            "error",
            "skipped",
        }:
            return None, "doctor-check-schema-invalid"
        selected[name] = str(item["status"])
    return {"overall_status": overall, "checks": selected}, "doctor-structured"


def parse_prompt_input_summary(data: object) -> tuple[dict[str, object] | None, str]:
    if not isinstance(data, list) or not data:
        return None, "prompt-input-schema-invalid"
    roles: set[str] = set()
    texts: list[str] = []
    for item in data:
        if not isinstance(item, dict) or item.get("type") != "message":
            return None, "prompt-input-message-invalid"
        role = item.get("role")
        if role not in {"system", "developer", "user", "assistant"}:
            return None, "prompt-input-role-invalid"
        roles.add(str(role))
        content = item.get("content")
        if not isinstance(content, list):
            return None, "prompt-input-content-invalid"
        for content_item in content:
            if not isinstance(content_item, dict) or not isinstance(content_item.get("text"), str):
                return None, "prompt-input-content-item-invalid"
            texts.append(str(content_item["text"]))
    discovered = any("# Repository Guidelines" in text and "AGENTS.md" in text for text in texts)
    return {
        "message_count": len(data),
        "roles": sorted(roles),
        "instructions_discovered": discovered,
    }, "prompt-input-structured"


def run_runtime_diagnostics(project: Path) -> dict[str, object]:
    expected_home = (project / ".codex").resolve(strict=False)
    declared_home = os.environ.get("CODEX_HOME")
    if declared_home:
        candidate = Path(declared_home).expanduser()
        if not candidate.is_absolute() or candidate.resolve(strict=False) != expected_home:
            result = runtime_diagnostics_result("invalid", "codex-home-mismatch")
            result["codex_home_class"] = "mismatch"
            return result

    evidence_path, evidence_rel = runtime_evidence_directory(project)
    if evidence_path is None or evidence_rel is None:
        return runtime_diagnostics_result("invalid", "ignored-evidence-path-unavailable")
    executable = shutil.which("codex")
    if executable is None:
        return runtime_diagnostics_result(
            "unsupported",
            "codex-command-unavailable",
            evidence_dir=evidence_rel,
        )
    env = {**os.environ, "CODEX_HOME": str(expected_home)}
    version_rc, version_stdout, _ = execute_runtime_probe(
        executable,
        ["--version"],
        project=project,
        env=env,
        evidence_dir=evidence_path,
        evidence_name="version",
        timeout=30,
    )
    if version_rc != 0:
        return runtime_diagnostics_result(
            "unsupported",
            "codex-version-probe-failed",
            evidence_dir=evidence_rel,
        )
    version_match = re.fullmatch(
        rb"codex-cli ([0-9]+)\.([0-9]+)\.([0-9]+)(?:[-+][A-Za-z0-9.-]+)?\s*",
        version_stdout,
    )
    if version_match is None:
        return runtime_diagnostics_result(
            "unsupported",
            "codex-version-format-unsupported",
            evidence_dir=evidence_rel,
        )
    major, minor, patch = (int(part) for part in version_match.groups())
    codex_version = f"{major}.{minor}.{patch}"
    if major != 0 or minor != SUPPORTED_CODEX_RUNTIME_MINOR:
        return runtime_diagnostics_result(
            "unsupported",
            "codex-version-unsupported",
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes={"version": {"status": "pass"}},
        )

    doctor_rc, doctor_stdout, _ = execute_runtime_probe(
        executable,
        ["doctor", "--json"],
        project=project,
        env=env,
        evidence_dir=evidence_path,
        evidence_name="doctor",
        timeout=90,
    )
    probes: dict[str, object] = {"version": {"status": "pass"}}
    if doctor_rc != 0:
        command_status = "unsupported" if doctor_rc == 2 else "fail"
        probes["doctor"] = {"status": command_status}
        return runtime_diagnostics_result(
            command_status,
            "doctor-command-unavailable" if doctor_rc == 2 else "doctor-command-failed",
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes=probes,
        )
    try:
        doctor_data = json.loads(doctor_stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        probes["doctor"] = {"status": "invalid"}
        return runtime_diagnostics_result(
            "invalid",
            "doctor-output-invalid",
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes=probes,
        )
    doctor_summary, doctor_reason = parse_doctor_summary(doctor_data, codex_version)
    if doctor_summary is None:
        probes["doctor"] = {"status": "invalid"}
        return runtime_diagnostics_result(
            "invalid",
            doctor_reason,
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes=probes,
        )
    doctor_passed = doctor_summary["overall_status"] == "ok" and all(
        status == "ok" for status in doctor_summary["checks"].values()
    )
    probes["doctor"] = {"status": "pass" if doctor_passed else "fail", **doctor_summary}

    prompt_rc, prompt_stdout, _ = execute_runtime_probe(
        executable,
        ["debug", "prompt-input"],
        project=project,
        env=env,
        evidence_dir=evidence_path,
        evidence_name="prompt-input",
        timeout=60,
    )
    if prompt_rc != 0:
        command_status = "unsupported" if prompt_rc == 2 else "fail"
        probes["prompt_input"] = {"status": command_status}
        return runtime_diagnostics_result(
            command_status,
            "prompt-input-command-unavailable" if prompt_rc == 2 else "prompt-input-command-failed",
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes=probes,
        )
    try:
        prompt_data = json.loads(prompt_stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        probes["prompt_input"] = {"status": "invalid"}
        return runtime_diagnostics_result(
            "invalid",
            "prompt-input-output-invalid",
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes=probes,
        )
    prompt_summary, prompt_reason = parse_prompt_input_summary(prompt_data)
    if prompt_summary is None:
        probes["prompt_input"] = {"status": "invalid"}
        return runtime_diagnostics_result(
            "invalid",
            prompt_reason,
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes=probes,
        )
    prompt_passed = bool(prompt_summary["instructions_discovered"])
    probes["prompt_input"] = {"status": "pass" if prompt_passed else "fail", **prompt_summary}
    if not doctor_passed:
        return runtime_diagnostics_result(
            "fail",
            "doctor-readiness-not-ok",
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes=probes,
        )
    if not prompt_passed:
        return runtime_diagnostics_result(
            "fail",
            "project-instructions-not-discovered",
            codex_version=codex_version,
            evidence_dir=evidence_rel,
            probes=probes,
        )
    return runtime_diagnostics_result(
        "pass",
        "supported-runtime-evidence-valid",
        codex_version=codex_version,
        evidence_dir=evidence_rel,
        probes=probes,
    )


def check_openspec_config(project: Path) -> Check:
    path = project / "openspec" / "config.yaml"
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return Check("openspec/config.yaml", False, f"cannot read: {exc}")
    if "schema:" not in text:
        return Check("openspec/config.yaml", False, "missing schema key")
    return Check("openspec/config.yaml", True, "config exists and declares schema")


def strip_yaml_comment(line: str) -> str:
    if "#" not in line:
        return line.rstrip()
    index = line.find("#")
    return line[:index].rstrip()


def yaml_scalar(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        return value[1:-1]
    return value


def yaml_lines_for_section(text: str, section: str) -> list[tuple[int, str]]:
    lines = text.splitlines()
    start: int | None = None
    for index, raw in enumerate(lines):
        line = strip_yaml_comment(raw)
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        if indent == 0 and line.strip() == f"{section}:":
            start = index + 1
            break
    if start is None:
        return []

    section_lines: list[tuple[int, str]] = []
    for raw in lines[start:]:
        line = strip_yaml_comment(raw)
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        if indent == 0:
            break
        section_lines.append((indent, line.strip()))
    return section_lines


def parse_simple_mapping(section_lines: list[tuple[int, str]], parent: str) -> dict[str, str]:
    mapping: dict[str, str] = {}
    in_parent = False
    parent_indent = -1
    for indent, line in section_lines:
        if indent == 2 and line == f"{parent}:":
            in_parent = True
            parent_indent = indent
            continue
        if in_parent and indent <= parent_indent:
            break
        if in_parent and indent == parent_indent + 2 and ":" in line and not line.startswith("- "):
            key, value = line.split(":", 1)
            mapping[yaml_scalar(key)] = yaml_scalar(value)
    return mapping


def parse_baseline_debt(section_lines: list[tuple[int, str]]) -> list[dict[str, str]]:
    entries: list[dict[str, str]] = []
    in_parent = False
    parent_indent = -1
    current: dict[str, str] | None = None
    for indent, line in section_lines:
        if indent == 2 and line.startswith("baseline_debt:"):
            if line.endswith("[]"):
                return []
            in_parent = True
            parent_indent = indent
            continue
        if in_parent and indent <= parent_indent:
            break
        if not in_parent:
            continue
        if indent == parent_indent + 2 and line.startswith("- "):
            if current is not None:
                entries.append(current)
            current = {}
            remainder = line[2:].strip()
            if ":" in remainder:
                key, value = remainder.split(":", 1)
                current[yaml_scalar(key)] = yaml_scalar(value)
            continue
        if current is not None and indent == parent_indent + 4 and ":" in line:
            key, value = line.split(":", 1)
            current[yaml_scalar(key)] = yaml_scalar(value)
    if current is not None:
        entries.append(current)
    return entries


def load_verification_policy(project: Path) -> tuple[VerificationPolicy, list[Check]]:
    default = VerificationPolicy(
        profile="all-surfaces",
        surfaces=dict(DEFAULT_SURFACE_POLICY),
        targeted_openspec_validation="required",
        baseline_debt=(),
    )
    path = project / "openspec" / "config.yaml"
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return default, []

    section = yaml_lines_for_section(text, "verification")
    if not section:
        return default, []

    errors: list[Check] = []
    profile = default.profile
    for indent, line in section:
        if indent == 2 and line.startswith("profile:"):
            profile = yaml_scalar(line.split(":", 1)[1])
            break

    surfaces = dict(DEFAULT_SURFACE_POLICY)
    for name, state in parse_simple_mapping(section, "surfaces").items():
        normalized_name = name.replace("-", "_")
        if normalized_name not in SURFACE_NAMES:
            errors.append(policy_error(f"unknown surface {name!r}"))
            continue
        if state not in SURFACE_STATES:
            errors.append(policy_error(f"surface {name!r} has invalid state {state!r}"))
            continue
        surfaces[normalized_name] = state

    mandatory = parse_simple_mapping(section, "mandatory")
    targeted = mandatory.get("targeted_openspec_validation", default.targeted_openspec_validation)
    if targeted != "required":
        errors.append(policy_error("targeted_openspec_validation must remain required"))
        targeted = "required"

    baseline_debt: list[BaselineDebt] = []
    for index, entry in enumerate(parse_baseline_debt(section), start=1):
        command = entry.get("command", "")
        residual_risk = entry.get("residual_risk", "")
        rationale = entry.get("rationale", "")
        if not command or not residual_risk or not rationale:
            errors.append(
                policy_error(
                    "baseline_debt entry "
                    f"#{index} must include command, residual_risk and rationale"
                )
            )
            continue
        baseline_debt.append(
            BaselineDebt(command=command, residual_risk=residual_risk, rationale=rationale)
        )

    policy = VerificationPolicy(
        profile=profile,
        surfaces=surfaces,
        targeted_openspec_validation=targeted,
        baseline_debt=tuple(baseline_debt),
    )
    return policy, errors


def load_bootstrap_profile(
    project: Path,
) -> tuple[BootstrapProfileDeclaration | None, Check | None]:
    path = project / "openspec" / "config.yaml"
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None, None
    section = yaml_lines_for_section(text, "bootstrap")
    if not section:
        return None, None
    values: dict[str, str] = {}
    for indent, line in section:
        if indent == 2 and ":" in line:
            key, value = line.split(":", 1)
            values[yaml_scalar(key)] = yaml_scalar(value)
    required = ("project_profile", "surfaces_profile", "codex_policy")
    missing = [name for name in required if not values.get(name)]
    if missing:
        return None, Check(
            "bootstrap profile consistency",
            False,
            "bootstrap profile metadata is incomplete: " + ", ".join(missing),
        )
    declaration = BootstrapProfileDeclaration(
        project_profile=values["project_profile"],
        surfaces_profile=values["surfaces_profile"],
        codex_policy=values["codex_policy"],
    )
    return declaration, None


def check_bootstrap_profile_consistency(
    project: Path,
    policy: VerificationPolicy,
    declaration: BootstrapProfileDeclaration | None,
) -> Check:
    if declaration is None:
        return Check(
            "bootstrap profile consistency",
            True,
            "legacy consumer without canonical profiles uses all-surfaces compatibility",
        )

    errors: list[str] = []
    if declaration.project_profile not in PROJECT_PROFILES:
        errors.append(f"unknown project_profile {declaration.project_profile!r}")
    expected_surfaces = SURFACE_PROFILE_POLICIES.get(declaration.surfaces_profile)
    if expected_surfaces is None:
        errors.append(f"unknown surfaces_profile {declaration.surfaces_profile!r}")
    else:
        if policy.profile != declaration.surfaces_profile:
            errors.append(
                f"verification profile is {policy.profile!r}, expected {declaration.surfaces_profile!r}"
            )
        mismatches = [
            f"{name}={policy.surfaces.get(name)!r} (expected {state!r})"
            for name, state in expected_surfaces.items()
            if policy.surfaces.get(name) != state
        ]
        if mismatches:
            errors.append("surface policy mismatch: " + ", ".join(mismatches))

    expected_codex = CODEX_POLICY_SETTINGS.get(declaration.codex_policy)
    if expected_codex is None:
        errors.append(f"unknown codex_policy {declaration.codex_policy!r}")
    else:
        config_path = project / ".codex" / "config.toml"
        try:
            config = tomllib.loads(config_path.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as exc:
            errors.append(f"cannot inspect .codex/config.toml authority: {exc}")
        else:
            actual_codex = (config.get("approval_policy"), config.get("sandbox_mode"))
            if actual_codex != expected_codex:
                errors.append(
                    "Codex authority mismatch: "
                    f"approval_policy={actual_codex[0]!r}, sandbox_mode={actual_codex[1]!r}; "
                    f"expected {expected_codex[0]!r}/{expected_codex[1]!r}"
                )

    if errors:
        return Check("bootstrap profile consistency", False, "; ".join(errors))
    return Check(
        "bootstrap profile consistency",
        True,
        "declared project, surface and Codex authority profiles are coherent",
    )


def parse_npm_package_arg(value: str) -> tuple[str, str] | None:
    if value.startswith("-"):
        return None
    if value.startswith("@"):
        index = value.rfind("@")
        if index <= 0:
            return value, ""
        return value[:index], value[index + 1 :]
    if "@" not in value:
        return None
    name, version = value.rsplit("@", 1)
    return name, version


def parse_npx_package_args(args: list[object]) -> list[tuple[str, str]]:
    package_args: list[tuple[str, str]] = []
    index = 0
    while index < len(args):
        arg = args[index]
        if not isinstance(arg, str):
            index += 1
            continue
        if arg in {"--package", "-p"}:
            if index + 1 < len(args) and isinstance(args[index + 1], str):
                package_spec = args[index + 1]
                package_args.append(parse_npm_package_arg(package_spec) or (package_spec, ""))
                index += 2
                continue
            package_args.append((arg, ""))
            index += 1
            continue
        if arg.startswith("--package="):
            package_spec = arg.split("=", 1)[1]
            package_args.append(parse_npm_package_arg(package_spec) or (package_spec, ""))
            index += 1
            continue
        parsed = parse_npm_package_arg(arg)
        if parsed:
            package_args.append(parsed)
        index += 1
    return package_args


def load_mcp_npm_lock(changerail_root: Path) -> tuple[dict[tuple[str, str], LockedNpmPackage], str | None]:
    path = changerail_root / "mcp-npm-lock.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        return {}, f"cannot read {path}: {exc}"
    except json.JSONDecodeError as exc:
        return {}, f"invalid JSON in {path}: {exc}"
    lock: dict[tuple[str, str], LockedNpmPackage] = {}
    errors: list[str] = []
    packages = data.get("packages", [])
    if not isinstance(packages, list):
        return {}, "mcp-npm-lock.json packages must be an array"
    for index, package in enumerate(packages, start=1):
        if not isinstance(package, dict):
            errors.append(f"mcp-npm-lock.json package #{index} must be an object")
            continue
        name = package.get("name")
        version = package.get("version")
        integrity = package.get("integrity")
        source = package.get("source", "npm")
        if not isinstance(name, str) or not name:
            errors.append(f"mcp-npm-lock.json package #{index} missing name")
            continue
        if not isinstance(version, str) or not EXACT_NPM_VERSION_RE.match(version):
            errors.append(f"mcp-npm-lock.json {name}: version must be exact semver")
            continue
        if not isinstance(integrity, str) or not SRI_INTEGRITY_RE.match(integrity):
            errors.append(f"mcp-npm-lock.json {name}@{version}: integrity must be SRI sha256/384/512")
            continue
        if source != "npm":
            errors.append(f"mcp-npm-lock.json {name}@{version}: source must be npm")
            continue
        key = (name, version)
        if key in lock:
            errors.append(f"mcp-npm-lock.json duplicates {name}@{version}")
            continue
        lock[key] = LockedNpmPackage(name=name, version=version, integrity=integrity, source=source)
    return lock, "; ".join(errors) if errors else None


def npm_mcp_pin_errors(
    label: str,
    servers: object,
    lock: dict[tuple[str, str], LockedNpmPackage],
) -> tuple[list[str], set[tuple[str, str]]]:
    errors: list[str] = []
    referenced: set[tuple[str, str]] = set()
    if not isinstance(servers, dict):
        return [f"{label}: MCP servers must be an object"], referenced
    for name, server in servers.items():
        if not isinstance(server, dict):
            continue
        if server.get("command") != "npx":
            continue
        args = server.get("args", [])
        if not isinstance(args, list):
            errors.append(f"{label}.{name}: args must be an array")
            continue
        package_args = parse_npx_package_args(args)
        if not package_args:
            errors.append(f"{label}.{name}: npx package argument is missing")
            continue
        for package_name, version in package_args:
            if not EXACT_NPM_VERSION_RE.match(version):
                errors.append(f"{label}.{name}: {package_name} is not exact-version pinned")
                continue
            if (package_name, version) not in lock:
                errors.append(f"{label}.{name}: {package_name}@{version} is absent from mcp-npm-lock.json")
                continue
            referenced.add((package_name, version))
    return errors, referenced


def npm_registry_integrity(package_name: str, version: str) -> tuple[str | None, str | None]:
    spec = f"{package_name}@{version}"
    npm_executable = resolve_executable("npm")
    if npm_executable is None:
        return None, "npm executable is not available for MCP integrity verification"
    try:
        result = subprocess.run(
            [npm_executable, "view", spec, "dist.integrity", "--json"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=30,
        )
    except FileNotFoundError:
        return None, "npm executable is not available for MCP integrity verification"
    except subprocess.TimeoutExpired:
        return None, f"npm registry integrity lookup timed out for {spec}"
    if result.returncode != 0:
        output = result.stdout.strip() or f"npm view failed with exit {result.returncode}"
        return None, f"npm registry integrity lookup failed for {spec}: {output}"
    output = result.stdout.strip()
    try:
        value = json.loads(output)
    except json.JSONDecodeError:
        value = output
    if not isinstance(value, str) or not value:
        return None, f"npm registry returned no dist.integrity for {spec}"
    return value, None


def resolve_executable(command: str) -> str | None:
    candidates = [command]
    if not Path(command).suffix:
        candidates.extend(f"{command}{suffix}" for suffix in (".cmd", ".bat", ".exe"))
    for candidate in candidates:
        resolved = shutil.which(candidate)
        if resolved:
            return resolved
    return None


def npm_integrity_errors(referenced: set[tuple[str, str]], lock: dict[tuple[str, str], LockedNpmPackage]) -> list[str]:
    errors: list[str] = []
    for package_name, version in sorted(referenced):
        locked = lock[(package_name, version)]
        registry_integrity, registry_error = npm_registry_integrity(package_name, version)
        if registry_error:
            errors.append(registry_error)
            continue
        if registry_integrity != locked.integrity:
            errors.append(
                f"npm registry integrity mismatch for {package_name}@{version}: "
                "tracked mcp-npm-lock.json does not match dist.integrity"
            )
    return errors


def check_mcp_npm_pins(
    project: Path,
    changerail_root: Path,
    *,
    include_codex: bool,
    include_legacy_mcp: bool,
) -> Check:
    lock, lock_error = load_mcp_npm_lock(changerail_root)
    if lock_error:
        return Check("MCP npm pins", False, lock_error)
    errors: list[str] = []
    referenced: set[tuple[str, str]] = set()
    if include_legacy_mcp:
        try:
            mcp_data = json.loads((project / ".mcp.json").read_text(encoding="utf-8"))
            mcp_errors, mcp_referenced = npm_mcp_pin_errors(".mcp.json", mcp_data.get("mcpServers", {}), lock)
            errors.extend(mcp_errors)
            referenced.update(mcp_referenced)
        except (OSError, json.JSONDecodeError) as exc:
            errors.append(f".mcp.json: {exc}")
    if include_codex:
        try:
            codex_data = tomllib.loads((project / ".codex" / "config.toml").read_text(encoding="utf-8"))
            codex_errors, codex_referenced = npm_mcp_pin_errors(
                ".codex/config.toml",
                codex_data.get("mcp_servers", {}),
                lock,
            )
            errors.extend(codex_errors)
            referenced.update(codex_referenced)
        except (OSError, tomllib.TOMLDecodeError) as exc:
            errors.append(f".codex/config.toml: {exc}")
    if not errors:
        errors.extend(npm_integrity_errors(referenced, lock))
    if errors:
        return Check("MCP npm pins", False, "; ".join(errors))
    return Check("MCP npm pins", True, "all npx MCP packages are exact-version pinned, locked and registry-verified")


def check_openspec_validate(project: Path) -> Check:
    openspec_name = "openspec.cmd" if os.name == "nt" else "openspec"
    wrapper = project / "bin" / openspec_name
    if not wrapper.exists():
        return Check("bin/openspec validate --all --strict", False, f"bin/{openspec_name} missing")
    try:
        result = subprocess.run(
            [str(wrapper), "validate", "--all", "--strict", "--no-interactive"],
            cwd=project,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env={**os.environ, "OPENSPEC_WORKDIR": str(project)},
            timeout=120,
        )
    except OSError as exc:
        return Check("bin/openspec validate --all --strict", False, f"cannot execute bin/{openspec_name}: {exc}")
    if result.returncode != 0:
        return Check("bin/openspec validate --all --strict", False, result.stdout.strip() or "failed")
    return Check("bin/openspec validate --all --strict", True, "OpenSpec validation passed")


def active_openspec_changes(project: Path) -> list[str]:
    changes_root = project / "openspec" / "changes"
    if not changes_root.is_dir():
        return []
    return sorted(
        path.name
        for path in changes_root.iterdir()
        if path.is_dir() and path.name != "archive" and not path.name.startswith(".")
    )


def check_targeted_openspec_validate(project: Path) -> Check:
    changes = active_openspec_changes(project)
    if not changes:
        return Check("targeted OpenSpec validation", True, "no active OpenSpec changes declared")
    openspec_name = "openspec.cmd" if os.name == "nt" else "openspec"
    wrapper = project / "bin" / openspec_name
    if not wrapper.exists():
        return Check("targeted OpenSpec validation", False, f"bin/{openspec_name} missing")
    failures: list[str] = []
    for change in changes:
        try:
            result = subprocess.run(
                [str(wrapper), "validate", change, "--strict", "--no-interactive"],
                cwd=project,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                env={**os.environ, "OPENSPEC_WORKDIR": str(project)},
                timeout=120,
            )
        except OSError as exc:
            failures.append(f"{change}: cannot execute bin/{openspec_name}: {exc}")
            continue
        if result.returncode != 0:
            output = result.stdout.strip() or f"openspec validate {change} failed"
            failures.append(f"{change}: {output}")
    if failures:
        return Check("targeted OpenSpec validation", False, "; ".join(failures))
    return Check(
        "targeted OpenSpec validation",
        True,
        "active OpenSpec changes passed: " + ", ".join(changes),
    )


def check_schemas_and_helper(project: Path, changerail_root: Path, aggregator_root: Path | None) -> list[Check]:
    checks = [
        check_symlink(
            project,
            "bin/changerail-review-verdict",
            changerail_root / "bin" / "changerail-review-verdict",
            changerail_root,
            aggregator_root,
        ),
        check_symlink(
            project,
            "bin/changerail-evidence",
            changerail_root / "bin" / "changerail-evidence",
            changerail_root,
            aggregator_root,
        ),
    ]
    for schema in SCHEMAS:
        path = changerail_root / "schemas" / schema
        checks.append(Check(f"schemas/{schema}", path.is_file(), "reachable from ChangeRail root" if path.is_file() else "missing"))
    return checks


def check_schemas_and_helper_with_wiring(
    project: Path,
    changerail_root: Path,
    aggregator_root: Path | None,
    manifest: dict[str, object] | None,
) -> list[Check]:
    checks = [
        check_wiring_path(
            project,
            "bin/changerail-review-verdict",
            changerail_root / "bin" / "changerail-review-verdict",
            changerail_root,
            aggregator_root,
            manifest,
        ),
        check_wiring_path(
            project,
            "bin/changerail-evidence",
            changerail_root / "bin" / "changerail-evidence",
            changerail_root,
            aggregator_root,
            manifest,
        ),
    ]
    for schema in SCHEMAS:
        path = changerail_root / "schemas" / schema
        checks.append(Check(f"schemas/{schema}", path.is_file(), "reachable from ChangeRail root" if path.is_file() else "missing"))
    return checks


def check_yaml_schema_key(project: Path, rel_path: str, schema: str) -> Check:
    path = project / rel_path
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return Check(rel_path, False, f"cannot read: {exc}")
    expected = f"schema: {schema}"
    if expected not in text:
        return Check(rel_path, False, f"missing {expected}")
    return Check(rel_path, True, f"declares {schema}")


def check_maintenance_policy_paths(project: Path) -> Check:
    rel_path = ".changerail/maintenance.yaml"
    path = project / rel_path
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return Check(rel_path, False, f"cannot read: {exc}")
    missing = [
        needle
        for needle in (
            "catalog_path: .changerail/knowledge.yaml",
            "generated_index_path: .changerail/KNOWLEDGE.md",
        )
        if needle not in text
    ]
    if missing:
        return Check(rel_path, False, "missing maintenance paths: " + ", ".join(missing))
    return Check(rel_path, True, "maintenance catalog and generated index paths are declared")


def check_maintenance_runtime_ignore(project: Path) -> Check:
    path = project / ".gitignore"
    try:
        lines = {
            line.strip()
            for line in path.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        }
    except OSError as exc:
        return Check(".gitignore maintenance runtime policy", False, f"cannot read .gitignore: {exc}")
    if ".runtime/" in lines:
        return Check(".gitignore maintenance runtime policy", True, ".runtime/ covers .runtime/changerail/maintenance/")
    accepted = {
        ".runtime/changerail/maintenance/",
        ".runtime/changerail/maintenance/**",
    }
    if lines.intersection(accepted):
        return Check(".gitignore maintenance runtime policy", True, ".runtime/changerail/maintenance/ is ignored")
    return Check(".gitignore maintenance runtime policy", False, "missing ignore pattern for .runtime/changerail/maintenance/")


def maintenance_opted_in(project: Path, manifest: dict[str, object] | None) -> bool:
    if any(path_present(project, rel_path) for rel_path in MAINTENANCE_OPT_IN_PATHS):
        return True
    return manifest_declares_any(manifest, MAINTENANCE_MANIFEST_PATHS)


def check_maintenance_opt_in_wiring(
    project: Path,
    changerail_root: Path,
    aggregator_root: Path | None,
    manifest: dict[str, object] | None,
) -> list[Check]:
    if not maintenance_opted_in(project, manifest):
        return [
            Check(
                "maintenance opt-in",
                True,
                "not configured",
                status="skip",
            )
        ]

    checks: list[Check] = [
        check_yaml_schema_key(
            project,
            ".changerail/knowledge.yaml",
            "changerail.repository-knowledge.v1",
        ),
        check_yaml_schema_key(
            project,
            ".changerail/maintenance.yaml",
            "changerail.maintenance-policy.v1",
        ),
        check_maintenance_policy_paths(project),
        check_maintenance_runtime_ignore(project),
    ]
    for helper in MAINTENANCE_HELPERS:
        checks.append(
            check_wiring_path(
                project,
                f"bin/{helper}",
                changerail_root / "bin" / helper,
                changerail_root,
                aggregator_root,
                manifest,
            )
        )
    if generated_wiring_active(manifest):
        for helper in MAINTENANCE_HELPERS:
            windows_helper = f"{helper}.cmd"
            source = changerail_root / "bin" / windows_helper
            if source.is_file():
                checks.append(
                    check_wiring_path(
                        project,
                        f"bin/{windows_helper}",
                        source,
                        changerail_root,
                        aggregator_root,
                        manifest,
                    )
                )
    for schema in MAINTENANCE_SCHEMAS:
        path = changerail_root / "schemas" / schema
        checks.append(
            Check(
                f"schemas/{schema}",
                path.is_file(),
                "reachable from ChangeRail root" if path.is_file() else "missing",
            )
        )
    return checks


def apply_surface_policy(check: Check, surface: str, state: str, exists: bool) -> Check:
    if state == "required":
        return check
    if state == "optional":
        if not exists and not check.ok:
            return optional_missing(check.name, surface)
        return check
    if state == "forbidden":
        if exists:
            return forbidden_present(check.name, [check.name])
        return forbidden_absent(check.name, surface)
    return policy_error(f"surface {surface!r} has invalid state {state!r}")


def path_present(project: Path, rel_path: str) -> bool:
    path = project / rel_path
    return path.exists() or path.is_symlink()


def any_path_present(project: Path, rel_paths: Iterable[str]) -> list[str]:
    return [rel_path for rel_path in rel_paths if path_present(project, rel_path)]


def codex_surface_present(project: Path) -> list[str]:
    present = any_path_present(project, [".codex/config.toml"])
    skills_root = project / ".codex" / "skills"
    if skills_root.exists() or skills_root.is_symlink():
        present.append(".codex/skills")
    return present


def claude_surface_present(project: Path) -> list[str]:
    return any_path_present(
        project,
        [".claude/skills", ".claude/commands/changerail", ".claude/commands/chrl"],
    )


def check_no_stale_opsx_wiring(project: Path) -> Check:
    stale = [rel for rel in STALE_OPSX_PATHS if (project / rel).exists() or (project / rel).is_symlink()]
    codex_skills = project / ".codex" / "skills"
    if codex_skills.is_dir():
        stale.extend(
            str(path.relative_to(project))
            for path in sorted(codex_skills.glob("opsx-*"), key=lambda item: item.name)
            if path.exists() or path.is_symlink()
        )
    if stale:
        return Check("stale OPSX wiring", False, "stale paths present: " + ", ".join(stale))
    return Check("stale OPSX wiring", True, "no stale OPSX command, skill or helper defaults")


def check_gitignore(project: Path) -> Check:
    path = project / ".gitignore"
    try:
        lines = {
            line.strip()
            for line in path.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        }
    except OSError as exc:
        return Check(".gitignore runtime/auth policy", False, f"cannot read .gitignore: {exc}")
    missing = [pattern for pattern in REQUIRED_IGNORES if pattern not in lines]
    if missing:
        return Check(".gitignore runtime/auth policy", False, f"missing ignore patterns: {', '.join(missing)}")
    return Check(".gitignore runtime/auth policy", True, "required runtime/auth paths are ignored")


def check_tracked_runtime(project: Path) -> Check:
    probe = subprocess.run(
        ["git", "-C", str(project), "rev-parse", "--is-inside-work-tree"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if probe.returncode != 0:
        return Check("tracked runtime/auth files", True, "project is not a git repository yet")
    result = subprocess.run(
        ["git", "-C", str(project), "ls-files", "-z"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        return Check("tracked runtime/auth files", False, result.stderr.decode("utf-8", "replace").strip())
    offenders: list[str] = []
    for raw in result.stdout.split(b"\0"):
        if not raw:
            continue
        rel = raw.decode("utf-8", "replace")
        if rel in FORBIDDEN_TRACKED_EXACT or any(rel.startswith(prefix) for prefix in FORBIDDEN_TRACKED_PREFIXES):
            offenders.append(rel)
    if offenders:
        return Check("tracked runtime/auth files", False, "tracked forbidden paths: " + ", ".join(offenders))
    return Check("tracked runtime/auth files", True, "no tracked runtime/auth files")


def delivery_auth_advisory(project: Path, changerail_root: Path) -> Advisory:
    for name in AUTH_ENV_VARS:
        if os.environ.get(name):
            return Advisory(
                "delivery runner auth readiness",
                "pass",
                f"auth environment variable {name} is set",
                severity="info",
            )

    explicit_home = os.environ.get("CODEX_HOME")
    marker_root = Path(explicit_home).expanduser() if explicit_home else project / ".codex"
    for name in AUTH_MARKER_FILES:
        if (marker_root / name).is_file():
            marker_label = f"$CODEX_HOME/{name}" if explicit_home else f".codex/{name}"
            return Advisory(
                "delivery runner auth readiness",
                "pass",
                f"supported auth marker is present at {marker_label}",
                severity="info",
            )

    auth_destination = project / ".codex" / "auth.json"
    codex_parent = project / ".codex"
    if codex_parent.is_symlink() or auth_destination.is_symlink() or auth_destination.exists():
        return Advisory(
            "delivery runner auth readiness",
            "fail",
            "auth destination conflicts with project-owned or undeclared content; "
            "manual owner review is required before configuration",
            severity="non-blocking",
        )

    runbook = (
        changerail_root
        / "docs"
        / "consumer-adoption-runbook.md#codex-auth-for-delivery-runner"
    )
    configure = changerail_root / "bin" / "bootstrap-project"
    return Advisory(
        "delivery runner auth readiness",
        "fail",
        "missing supported auth marker or auth environment variable; see "
        f"{runbook}; configure with: {configure} {project} --configure-existing "
        "--link-codex-auth AUTH_JSON",
        severity="non-blocking",
    )


def maybe_downgrade_baseline_debt(check: Check, policy: VerificationPolicy) -> Check:
    if check.ok:
        return check
    commands = {debt.command for debt in policy.baseline_debt}
    if BASELINE_OPEN_SPEC_COMMAND in commands:
        return Check(
            check.name,
            False,
            check.message + " (tracked project-wide baseline debt policy records residual risk)",
            severity="non-blocking",
        )
    return check


def build_checks(project: Path, changerail_root: Path, aggregator_root: Path | None) -> list[Check]:
    skills = skill_names(changerail_root)
    policy, policy_errors = load_verification_policy(project)
    bootstrap_profile, bootstrap_profile_error = load_bootstrap_profile(project)
    wiring_manifest, wiring_manifest_check = load_wiring_manifest(project)
    consumer_lock, consumer_lock_check = load_consumer_lock(project, changerail_root)
    codex_state = policy.surfaces["codex"]
    claude_state = policy.surfaces["claude"]
    legacy_mcp_state = policy.surfaces["legacy_mcp"]
    legacy_artifacts_state = policy.surfaces["legacy_artifacts"]

    checks: list[Check] = [
        Check("project root", project.is_dir(), str(project)),
        check_wiring_path(
            project,
            "bin/openspec",
            changerail_root / "bin" / "openspec",
            changerail_root,
            aggregator_root,
            wiring_manifest,
        ),
        check_wiring_path(
            project,
            "bin/changerail-python",
            changerail_root / "bin" / "changerail-python",
            changerail_root,
            aggregator_root,
            wiring_manifest,
        ),
        check_wiring_path(
            project,
            "bin/verify-project",
            changerail_root / "bin" / "verify-project",
            changerail_root,
            aggregator_root,
            wiring_manifest,
        ),
    ]
    if wiring_manifest_check is not None:
        checks.append(wiring_manifest_check)
    checks.extend(check_generated_wiring_manifest(project, changerail_root, wiring_manifest))
    checks.extend(
        [
            consumer_lock_check,
            check_consumer_wiring(project, changerail_root, consumer_lock),
            check_consumer_source_revision(changerail_root, consumer_lock),
        ]
    )
    checks.extend(policy_errors)
    checks.append(
        bootstrap_profile_error
        or check_bootstrap_profile_consistency(project, policy, bootstrap_profile)
    )

    claude_checks = [
        check_wiring_path(project, ".claude/skills", changerail_root / "skills", changerail_root, aggregator_root, wiring_manifest),
        check_wiring_path(
            project,
            ".claude/commands/changerail",
            changerail_root / "claude" / "commands" / "changerail",
            changerail_root,
            aggregator_root,
            wiring_manifest,
        ),
        check_wiring_path(
            project,
            ".claude/commands/chrl",
            changerail_root / "claude" / "commands" / "chrl",
            changerail_root,
            aggregator_root,
            wiring_manifest,
        ),
    ]
    claude_present = set(claude_surface_present(project))
    for check in claude_checks:
        checks.append(apply_surface_policy(check, "claude", claude_state, check.name in claude_present))

    codex_config = check_codex(project)
    checks.append(
        apply_surface_policy(
            codex_config,
            "codex",
            codex_state,
            path_present(project, ".codex/config.toml"),
        )
    )
    checks.append(
        apply_surface_policy(
            check_instruction_budget(project),
            "codex",
            codex_state,
            path_present(project, ".codex/config.toml"),
        )
    )
    for skill in skills:
        check = check_wiring_path(
            project,
            f".codex/skills/{skill}",
            changerail_root / "skills" / skill,
            changerail_root,
            aggregator_root,
            wiring_manifest,
        )
        checks.append(
            apply_surface_policy(
                check,
                "codex",
                codex_state,
                path_present(project, f".codex/skills/{skill}"),
            )
        )

    mcp_exists = path_present(project, ".mcp.json")
    checks.append(
        apply_surface_policy(
            check_mcp(project),
            "legacy_mcp",
            legacy_mcp_state,
            mcp_exists,
        )
    )
    include_codex_pins = codex_state != "forbidden" and path_present(project, ".codex/config.toml")
    include_legacy_mcp_pins = legacy_mcp_state != "forbidden" and mcp_exists
    if include_codex_pins or include_legacy_mcp_pins:
        checks.append(
            check_mcp_npm_pins(
                project,
                changerail_root,
                include_codex=include_codex_pins,
                include_legacy_mcp=include_legacy_mcp_pins,
            )
        )
    checks.extend(check_schemas_and_helper_with_wiring(project, changerail_root, aggregator_root, wiring_manifest))
    checks.extend(check_maintenance_opt_in_wiring(project, changerail_root, aggregator_root, wiring_manifest))
    targeted_openspec_validate = check_targeted_openspec_validate(project)
    openspec_validate = maybe_downgrade_baseline_debt(check_openspec_validate(project), policy)
    stale_check = check_no_stale_opsx_wiring(project)
    checks.extend(
        [
            check_openspec_config(project),
            targeted_openspec_validate,
            openspec_validate,
            check_gitignore(project),
            check_tracked_runtime(project),
            apply_surface_policy(
                stale_check,
                "legacy_artifacts",
                legacy_artifacts_state,
                not stale_check.ok,
            ),
        ]
    )
    return checks


def build_advisories(project: Path, changerail_root: Path) -> list[Advisory]:
    return [delivery_auth_advisory(project, changerail_root)]


def summarize_results(checks: list[Check], advisories: list[Advisory]) -> dict[str, object]:
    blocking_failed = [
        check for check in checks if check.status == "fail" and check.severity == "blocking"
    ]
    nonblocking_failed_checks = [
        check for check in checks if check.status == "fail" and check.severity == "non-blocking"
    ]
    nonblocking_failed_advisories = [
        advisory for advisory in advisories if advisory.status == "fail" and advisory.severity == "non-blocking"
    ]
    diagnostics = len(nonblocking_failed_checks) + len(nonblocking_failed_advisories)
    status = "fail" if blocking_failed else "pass-with-diagnostics" if diagnostics else "pass"
    passed = sum(1 for check in checks if check.status == "pass")
    return {
        "status": status,
        "verification_scope": "static configuration and wiring",
        "total": len(checks),
        "passed": passed,
        "failed": len(blocking_failed),
        "diagnostics": diagnostics,
    }


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Verify a ChangeRail consumer project.")
    parser.add_argument("path", type=Path, help="Consumer project path.")
    parser.add_argument("--changerail-root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--aggregator-root", type=Path, default=None)
    parser.add_argument("--json", action="store_true", help="Emit JSON report.")
    parser.add_argument(
        "--runtime-diagnostics",
        action="store_true",
        help="Run opt-in supported Codex runtime probes and retain ignored raw evidence.",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    project = args.path.resolve()
    changerail_root = args.changerail_root.resolve()
    aggregator_root = args.aggregator_root.resolve() if args.aggregator_root else None
    checks = build_checks(project, changerail_root, aggregator_root)
    advisories = build_advisories(project, changerail_root)
    summary = summarize_results(checks, advisories)
    runtime_diagnostics = run_runtime_diagnostics(project) if args.runtime_diagnostics else None
    warnings = [
        advisory for advisory in advisories if advisory.status == "fail" and advisory.severity == "non-blocking"
    ]

    if args.json:
        print(
            json.dumps(
                {
                    "project": str(project),
                    "changerail_root": str(changerail_root),
                    "aggregator_root": str(aggregator_root) if aggregator_root else None,
                    "summary": summary,
                    "advisory_summary": {
                        "total": len(advisories),
                        "warnings": len(warnings),
                    },
                    "checks": [check.__dict__ for check in checks],
                    "advisories": [advisory.__dict__ for advisory in advisories],
                    "runtime_diagnostics": runtime_diagnostics,
                },
                ensure_ascii=False,
                indent=2,
                sort_keys=True,
            )
        )
    else:
        for check in checks:
            print_check(check)
        for advisory in advisories:
            print_advisory(advisory)
        if runtime_diagnostics is not None:
            print(
                "runtime diagnostics: "
                f"{runtime_diagnostics['status']} ({runtime_diagnostics['reason']}); "
                "raw output retained under ignored diagnostics state"
            )
        print(
            "summary: static configuration and wiring verification "
            f"{summary['status']} "
            f"({summary['passed']}/{summary['total']} passed, "
            f"{summary['failed']} failed, {summary['diagnostics']} diagnostics)"
        )
    runtime_failed = runtime_diagnostics is not None and runtime_diagnostics["status"] != "pass"
    return 1 if summary["status"] == "fail" or runtime_failed else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
