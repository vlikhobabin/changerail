[Unit]
Description=ChangeRail read-only maintenance audit

[Service]
Type=oneshot
WorkingDirectory=/opt/example-project
ExecStart=/opt/example-project/bin/changerail-maintenance-runner scan --timeout 900 --json
RuntimeDirectory=changerail-maintenance
TimeoutStartSec=1000

# The runner owns its repository-local non-overlap lock under
# .runtime/changerail/maintenance/. Use an isolated checkout when a scheduled
# scan must not observe an operator's active worktree.
