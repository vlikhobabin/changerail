{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-consumer-lock.schema.json",
  "title": "ChangeRail consumer source and wiring lock",
  "type": "object",
  "required": ["schema", "changerail", "wiring", "profiles", "enforcement"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.consumer-lock.v1"
    },
    "changerail": {
      "type": "object",
      "required": ["version", "revision", "source"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "source": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]+)?/[A-Za-z0-9._~/-]+$"
        }
      }
    },
    "wiring": {
      "type": "object",
      "required": ["platform", "backend", "path_mode", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": ["posix", "windows"]
        },
        "backend": {
          "enum": ["symlink", "generated-copy", "junction"]
        },
        "path_mode": {
          "enum": ["absolute", "relative", "not-applicable"]
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": ["project", "surfaces", "codex_policy"],
      "additionalProperties": false,
      "properties": {
        "project": {
          "enum": ["generic", "workspace-root", "service"]
        },
        "surfaces": {
          "enum": ["all-surfaces", "codex-only"]
        },
        "codex_policy": {
          "enum": ["safe-interactive", "trusted-automation"]
        }
      }
    },
    "enforcement": {
      "enum": ["advisory", "strict"]
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "artifact": {
      "type": "object",
      "required": ["path", "source", "kind", "surface"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "kind": {
          "enum": ["symlink", "generated-copy", "junction"]
        },
        "surface": {
          "enum": ["helper", "codex-skill", "claude-skills", "claude-commands"]
        }
      }
    }
  }
}
