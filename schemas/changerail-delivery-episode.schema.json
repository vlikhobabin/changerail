{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-delivery-episode.schema.json",
  "title": "ChangeRail delivery episode",
  "type": "object",
  "required": [
    "schema",
    "episode_id",
    "updated_at",
    "workspace",
    "card",
    "attempts",
    "final_outcome"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.delivery-episode.v1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attemptSummary"
      }
    },
    "final_outcome": {
      "enum": ["delivered", "blocked", "no-go", "abandoned", "preflight-only", "unknown", "invalid"]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/sampleSummary"
      }
    },
    "owner_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownerArtifact"
      }
    }
  },
  "$defs": {
    "attemptSummary": {
      "type": "object",
      "required": ["id", "kind", "owner_artifact"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["preflight", "delivery", "recovery", "review", "rescue", "publish"]
        },
        "parent_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "previous_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "terminal_state": {
          "enum": ["running", "delivered", "blocked", "no-go", "abandoned", "unknown"]
        },
        "blocker_class": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "performance": {
          "$ref": "#/$defs/performanceSummary"
        },
        "owner_artifact": {
          "$ref": "#/$defs/ownerArtifact"
        }
      }
    },
    "usage": {
      "type": "object",
      "required": ["available"],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "performanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "active_seconds": {
          "type": "number",
          "minimum": 0
        },
        "wait_seconds": {
          "type": "number",
          "minimum": 0
        },
        "operator_wait_seconds": {
          "type": "number",
          "minimum": 0
        },
        "command_execution_count": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "command_samples": {
          "$ref": "#/$defs/sampleSummary"
        },
        "timeline_samples": {
          "$ref": "#/$defs/sampleSummary"
        }
      }
    },
    "sampleSummary": {
      "type": "object",
      "required": ["observed_count", "retained_count", "limit", "truncated"],
      "additionalProperties": false,
      "properties": {
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "retained_count": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "ownerArtifact": {
      "type": "object",
      "required": ["kind", "path"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["delivery-run", "review-history", "delivery-manifest", "derived-episode"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
