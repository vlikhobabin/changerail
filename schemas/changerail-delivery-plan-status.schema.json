{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-delivery-plan-status.schema.json",
  "title": "ChangeRail delivery plan status",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "updated_at",
    "plan",
    "phase",
    "result",
    "timestamps",
    "mode",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.delivery-plan-status.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan": {
      "$ref": "#/$defs/planReference"
    },
    "phase": {
      "enum": ["preflight", "running", "resuming", "terminal"]
    },
    "result": {
      "enum": ["RUNNING", "DELIVERED", "NO-GO", "BLOCKED"]
    },
    "terminal_outcome": {
      "enum": ["DELIVERED", "NO-GO", "BLOCKED"]
    },
    "mode": {
      "enum": ["push", "no-push"]
    },
    "timestamps": {
      "type": "object",
      "required": ["started_at"],
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1
    },
    "per_workspace_parallelism": {
      "const": 1
    },
    "workspaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workspaceStatus"
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cardStatus"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "locks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lock"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_cards": {
          "type": "integer",
          "minimum": 0
        },
        "delivered": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "no_go": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "recovered": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*\\$\\{).+$"
    },
    "planReference": {
      "type": "object",
      "required": ["id", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "workspaceStatus": {
      "type": "object",
      "required": ["alias", "path", "state"],
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "state": {
          "enum": ["pending", "preflighted", "running", "delivered", "blocked"]
        },
        "head_commit": {
          "type": "string",
          "minLength": 1
        },
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "execution_target": {
          "$ref": "#/$defs/executionTargetIdentity"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "cardStatus": {
      "type": "object",
      "required": ["id", "workspace", "card", "state"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "workspace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "card": {
          "$ref": "#/$defs/relativePath"
        },
        "resolved_path": {
          "$ref": "#/$defs/relativePath"
        },
        "state": {
          "enum": ["pending", "ready", "running", "skipped", "delivered", "no-go", "blocked", "recovered"]
        },
        "wave": {
          "type": "integer",
          "minimum": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "recovery_for": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "run_status_path": {
          "$ref": "#/$defs/relativePath"
        },
        "result": {
          "enum": ["DELIVERED", "NO-GO", "BLOCKED"]
        },
        "terminal_reason": {
          "$ref": "#/$defs/terminalReason"
        },
        "retained_recovery": {
          "$ref": "#/$defs/retainedRecovery"
        },
        "failure_class": {
          "$ref": "#/$defs/remoteFailureClass"
        },
        "recovered_by": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "upstream_state": {
          "enum": ["equal", "ahead", "diverged", "unknown"]
        },
        "upstream_detail": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        },
        "progress": {
          "$ref": "#/$defs/deliveryProgress"
        },
        "progress_health": {
          "$ref": "#/$defs/progressHealth"
        },
        "progress_diagnostic": {
          "enum": ["invalid_child_identity", "invalid_child_status"]
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["name", "status", "message"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "fail", "skip"]
        },
        "message": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "card": {
          "type": "string"
        }
      }
    },
    "terminalReason": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "deliveryProgress": {
      "type": "object",
      "required": ["schema", "phase", "stage", "heartbeat_at", "event_counter"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "changerail.delivery-progress.v1"
        },
        "phase": {
          "enum": ["preflight", "ff", "do", "review", "publish", "terminal"]
        },
        "stage": {
          "enum": ["starting", "discovery", "planning", "implementation", "verification", "waiting", "finalizing", "complete"]
        },
        "heartbeat_at": {
          "type": "string",
          "format": "date-time"
        },
        "event_counter": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "progressHealth": {
      "type": "object",
      "required": ["state", "heartbeat_age_seconds", "process_alive"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": ["active", "stale", "terminated"]
        },
        "heartbeat_age_seconds": {
          "type": "number",
          "minimum": 0
        },
        "process_alive": {
          "type": "boolean"
        }
      }
    },
    "retainedRecovery": {
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "source_terminal_reason": {
                "const": "recoverable_external_blocker"
              }
            }
          },
          "then": {
            "required": ["external_blocker"]
          }
        }
      ],
      "required": [
        "kind",
        "source_run_id",
        "source_run_status_path",
        "source_terminal_reason",
        "card",
        "fingerprint",
        "review_target_kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "original-retained-payload"
        },
        "source_run_id": {
          "type": "string",
          "minLength": 1
        },
        "source_run_status_path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_terminal_reason": {
          "enum": ["investigation_required", "recoverable_external_blocker"]
        },
        "card": {
          "type": "object",
          "required": ["id", "path"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "fingerprint": {
          "type": "object",
          "required": ["head_commit", "tree_sha", "diff_fingerprint"],
          "additionalProperties": false,
          "properties": {
            "head_commit": {
              "type": "string",
              "minLength": 1
            },
            "tree_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "diff_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "review_target_kind": {
          "const": "working-tree"
        },
        "execution_target": {
          "$ref": "#/$defs/executionTargetIdentity"
        },
        "external_blocker": {
          "$ref": "#/$defs/externalBlocker"
        }
      }
    },
    "externalBlocker": {
      "type": "object",
      "required": [
        "schema",
        "blocker_id",
        "class",
        "observed_at",
        "retryable",
        "evidence_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "changerail.external-blocker.v1"
        },
        "blocker_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "class": {
          "enum": ["credential", "network", "license", "external_service", "platform_access", "required_software"]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "retryable": {
          "const": true
        },
        "evidence_policy": {
          "type": "object",
          "required": ["required_ids", "max_age_seconds"],
          "additionalProperties": false,
          "properties": {
            "required_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            },
            "max_age_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "executionTargetIdentity": {
      "type": "object",
      "required": ["schema", "id", "fingerprint", "target_substitution_policy"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "changerail.execution-target.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "target_substitution_policy": {
          "const": "forbid"
        }
      }
    },
    "remoteFailureClass": {
      "enum": ["ssh_config", "dns", "auth", "missing_branch", "timeout", "unknown_remote_failure"]
    },
    "lock": {
      "type": "object",
      "required": ["workspace", "path", "state"],
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "state": {
          "enum": ["created", "released", "blocked", "stale"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
