{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-evidence-index.schema.json",
  "title": "ChangeRail evidence index",
  "type": "object",
  "required": [
    "schema",
    "updated_at",
    "workspace",
    "scope",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.evidence-index.v1"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "card_path": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_payload_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputPath"
          }
        },
        "manifest_update": {
          "$ref": "#/$defs/outputPath"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "required": ["id", "path", "role", "storage", "phase", "classification"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "raw_output",
            "curated_summary",
            "verification_matrix",
            "delivery_manifest",
            "trace_payload_reference",
            "retrospective_input",
            "archive_result"
          ]
        },
        "storage": {
          "enum": ["committable", "runtime", "external"]
        },
        "phase": {
          "enum": ["ff", "do", "review", "pub", "manual"]
        },
        "classification": {
          "enum": ["mandatory", "diagnostic", "not_applicable"]
        },
        "change": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "command": {
          "$ref": "#/$defs/commandIdentity"
        },
        "status": {
          "enum": ["passed", "failed", "timeout", "blocked", "skipped", "not_applicable"]
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "raw_output_path": {
          "type": "string",
          "minLength": 1
        },
        "redacted": {
          "type": "boolean"
        },
        "timed_out": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commandIdentity": {
      "type": "object",
      "required": ["argv", "display"],
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "outputPath": {
      "type": "object",
      "required": ["path", "kind"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["trace_payload", "manifest_update", "evidence_index"]
        }
      }
    }
  }
}
