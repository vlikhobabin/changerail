{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-execution-target.schema.json",
  "title": "ChangeRail declared execution target",
  "type": "object",
  "required": [
    "schema",
    "id",
    "fingerprint",
    "target_substitution_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.execution-target.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "target_substitution_policy": {
      "const": "forbid"
    }
  }
}
