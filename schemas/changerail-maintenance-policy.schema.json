{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-maintenance-policy.schema.json",
  "title": "ChangeRail maintenance policy",
  "type": "object",
  "required": ["schema", "catalog_path", "generated_index_path"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.maintenance-policy.v1"
    },
    "catalog_path": {
      "type": "string",
      "minLength": 1
    },
    "generated_index_path": {
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "active_scope_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enabled_detectors": {
          "type": "array",
          "items": {
            "enum": [
              "catalog-coverage",
              "repository-orphans",
              "markdown-local-links",
              "generated-freshness",
              "forbidden-active-references",
              "adapters"
            ]
          }
        },
        "fail_on": {
          "enum": ["info", "minor", "major", "blocker"]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "detectors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "catalog_coverage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "repository_orphans": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "markdown_local_links": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extensions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^\\.[A-Za-z0-9._-]+$"
                  }
                }
              }
            },
            "generated_freshness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "check_render_index": {
                  "type": "boolean"
                }
              }
            },
            "forbidden_active_references": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "patterns": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/forbiddenPattern"
                  }
                }
              }
            }
          }
        },
        "adapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adapterConfig"
          }
        }
      }
    }
  },
  "$defs": {
    "adapterConfig": {
      "type": "object",
      "required": ["id", "argv"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "forbiddenPattern": {
      "type": "object",
      "required": ["id", "pattern"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "pattern": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["info", "minor", "major", "blocker"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
