{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-maintenance-quality-rollup.schema.json",
  "title": "ChangeRail maintenance quality rollup",
  "type": "object",
  "required": ["schema", "generated_at", "workspace", "inputs", "metrics", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.maintenance-quality-rollup.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["reports", "histories", "triage", "proposals"],
      "additionalProperties": false,
      "properties": {
        "reports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "histories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "triage": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["id", "value", "unit", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "value": {
          "type": ["string", "number", "integer", "boolean", "null"]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["known", "unknown", "error"]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "path", "message", "severity"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "enum": ["info", "minor", "major", "blocker"]
        }
      }
    }
  }
}
