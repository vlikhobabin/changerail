{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-maintenance-report.schema.json",
  "title": "ChangeRail maintenance lifecycle report",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "workspace",
    "source_scan",
    "state",
    "complete",
    "fail_on",
    "summary",
    "detectors",
    "findings",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.maintenance-report.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_scan": {
      "type": "object",
      "required": ["schema", "generated_at", "catalog_path", "policy_path", "complete"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "changerail.maintenance-scan-report.v1"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "catalog_path": {
          "type": "string",
          "minLength": 1
        },
        "policy_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "state": {
      "type": "object",
      "required": ["path", "restored", "written"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "restored": {
          "type": "boolean"
        },
        "written": {
          "type": "boolean"
        },
        "continuity": {
          "enum": ["restored", "not_restored"]
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "fail_on": {
      "enum": ["info", "minor", "major", "blocker"]
    },
    "summary": {
      "type": "object",
      "required": [
        "detectors",
        "findings",
        "open",
        "accepted",
        "waived",
        "diagnostics",
        "max_severity",
        "threshold_reached"
      ],
      "additionalProperties": false,
      "properties": {
        "detectors": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "waived": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "integer",
          "minimum": 0
        },
        "max_severity": {
          "enum": ["none", "info", "minor", "major", "blocker"]
        },
        "threshold_reached": {
          "type": "boolean"
        }
      }
    },
    "detectors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/detectorSummary"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lifecycleFinding"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "detectorSummary": {
      "type": "object",
      "required": ["id", "status", "findings", "errors"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["pass", "fail", "error", "skipped"]
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lifecycleFinding": {
      "type": "object",
      "required": [
        "fingerprint",
        "evidence_fingerprint",
        "detector",
        "rule",
        "severity",
        "confidence",
        "path",
        "evidence_refs",
        "remediation",
        "first_seen",
        "last_seen",
        "owner",
        "risk_class",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "detector": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["info", "minor", "major", "blocker"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "subject": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "remediation": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "owner": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "risk_class": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["open", "accepted", "waived"]
        },
        "status_reason": {
          "type": "string",
          "minLength": 1
        },
        "suppressed_until": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "key", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": ["string", "number", "integer", "boolean", "null"]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "path", "message", "severity"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "severity": {
          "enum": ["info", "minor", "major", "blocker"]
        }
      }
    }
  }
}
