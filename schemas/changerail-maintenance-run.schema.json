{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-maintenance-run.schema.json",
  "title": "ChangeRail maintenance run",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "updated_at",
    "workspace",
    "mode",
    "phase",
    "result",
    "timestamps",
    "command",
    "usage",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.maintenance-run.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workspace": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "head_commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mode": {
      "enum": ["scan", "triage"]
    },
    "phase": {
      "enum": ["starting", "scan", "triage", "terminal"]
    },
    "result": {
      "enum": ["RUNNING", "SUCCEEDED", "FAILED", "BLOCKED"]
    },
    "terminal_reason": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "timestamps": {
      "type": "object",
      "required": ["started_at"],
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "command": {
      "type": "object",
      "required": ["argv", "stdin", "json", "timeout_seconds"],
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdin": {
          "const": "closed"
        },
        "json": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "timed_out": {
          "type": "boolean"
        }
      }
    },
    "lock": {
      "type": "object",
      "required": ["path", "acquired", "released"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "acquired": {
          "type": "boolean"
        },
        "released": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scan_report": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_report": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "string",
          "minLength": 1
        },
        "card_preview": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "usage": {
      "type": "object",
      "required": ["available"],
      "additionalProperties": false,
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "enum": ["info", "minor", "major", "blocker"]
        }
      }
    }
  }
}
