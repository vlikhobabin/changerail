{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-maintenance-triage.schema.json",
  "title": "ChangeRail maintenance triage annotations",
  "type": "object",
  "required": ["schema", "generated_at", "annotations"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.maintenance-triage.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "annotation": {
      "type": "object",
      "required": ["fingerprint"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "owner": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "risk_class": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "remediation": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "status": {
          "enum": ["open", "accepted", "waived"]
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  }
}
