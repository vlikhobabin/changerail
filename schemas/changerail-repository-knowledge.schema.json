{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-repository-knowledge.schema.json",
  "title": "ChangeRail repository knowledge catalog",
  "type": "object",
  "required": ["schema", "records"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.repository-knowledge.v1"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogRecord"
      }
    }
  },
  "$defs": {
    "catalogRecord": {
      "type": "object",
      "required": [
        "path",
        "status",
        "type",
        "owner",
        "source_globs",
        "verify",
        "review_after",
        "supersedes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["active", "historical", "superseded", "generated"]
        },
        "type": {
          "enum": [
            "tutorial",
            "how-to",
            "reference",
            "explanation",
            "architecture",
            "adr",
            "runbook",
            "historical",
            "generated"
          ]
        },
        "owner": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verify": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_after": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
