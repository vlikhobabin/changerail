{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-review-cycle-history.schema.json",
  "title": "ChangeRail review cycle history",
  "type": "object",
  "required": ["schema", "updated_at", "card", "workspace", "cycles"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "changerail.review-cycle-history.v1"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "episode": {
      "$ref": "#/$defs/episodeLineage"
    },
    "card": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workspace": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "head_commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cycle"
      }
    },
    "rescue_budget": {
      "$ref": "#/$defs/rescueBudget"
    },
    "phase_counters": {
      "$ref": "#/$defs/phaseCounters"
    }
  },
  "$defs": {
    "phaseCounters": {
      "type": "object",
      "required": [
        "planning_cycles",
        "delivery_fix_cycles",
        "implementation_review_cycles",
        "live_admission_reviews"
      ],
      "additionalProperties": false,
      "properties": {
        "planning_cycles": {"type": "integer", "minimum": 0},
        "delivery_fix_cycles": {"type": "integer", "minimum": 0},
        "implementation_review_cycles": {"type": "integer", "minimum": 0},
        "live_admission_reviews": {"type": "integer", "minimum": 0}
      }
    },
    "episodeLineage": {
      "type": "object",
      "required": ["schema", "id"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "changerail.delivery-episode-lineage.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attemptLineage": {
      "type": "object",
      "required": ["schema", "id", "kind"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "changerail.delivery-attempt.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["review", "rescue"]
        },
        "parent_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "previous_attempt_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rescueBudget": {
      "type": "object",
      "required": ["limit", "used", "remaining", "exhausted"],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 0
        },
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        },
        "exhausted": {
          "type": "boolean"
        }
      }
    },
    "cycle": {
      "type": "object",
      "required": [
        "review_cycle",
        "result",
        "reviewed_at",
        "verdict_path",
        "findings",
        "acceptance"
      ],
      "anyOf": [
        {
          "required": ["finding_details"]
        },
        {
          "required": ["verdict_snapshot_path"]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "review_cycle": {
          "type": "integer",
          "minimum": 1
        },
        "same_card_rescue_attempt": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "$ref": "#/$defs/attemptLineage"
        },
        "result": {
          "enum": ["go", "no-go"]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "verdict_path": {
          "type": "string",
          "minLength": 1
        },
        "verdict_snapshot_path": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "object",
          "required": ["blocker", "major", "minor"],
          "additionalProperties": false,
          "properties": {
            "blocker": {
              "type": "integer",
              "minimum": 0
            },
            "major": {
              "type": "integer",
              "minimum": 0
            },
            "minor": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "finding_details": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "acceptance": {
          "type": "object",
          "required": ["pass", "fail", "unverifiable", "not_applicable"],
          "additionalProperties": false,
          "properties": {
            "pass": {
              "type": "integer",
              "minimum": 0
            },
            "fail": {
              "type": "integer",
              "minimum": 0
            },
            "unverifiable": {
              "type": "integer",
              "minimum": 0
            },
            "not_applicable": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["blocker", "major", "minor"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
