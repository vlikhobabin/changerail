{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-review-preflight-result.schema.json",
  "title": "ChangeRail review preflight result",
  "type": "object",
  "required": [
    "schema",
    "checked_at",
    "ok",
    "outcome",
    "workspace",
    "card",
    "manifest",
    "risk",
    "complexity_guard",
    "checks",
    "llm_review"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "changerail.review-preflight-result.v1"},
    "checked_at": {"type": "string", "format": "date-time"},
    "ok": {"type": "boolean"},
    "outcome": {
      "enum": [
        "blocked",
        "investigation-required",
        "machine-reviewed",
        "ready-for-llm-review",
        "already-reviewed"
      ]
    },
    "workspace": {
      "type": "object",
      "required": ["root", "head_commit", "tree_sha", "diff_fingerprint"],
      "additionalProperties": false,
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "head_commit": {"type": "string", "minLength": 1},
        "tree_sha": {"type": "string", "minLength": 1},
        "diff_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "path", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "manifest": {
      "type": "object",
      "required": ["path", "valid", "normalized", "scope_ok"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "valid": {"type": "boolean"},
        "normalized": {"type": "boolean"},
        "scope_ok": {"type": "boolean"}
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "tier",
        "source",
        "review_mode",
        "reasoning_effort",
        "milestone_audit",
        "critical_boundary",
        "live_admission",
        "final_certification"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": {"enum": ["deterministic", "ordinary", "critical"]},
        "source": {"enum": ["card", "cli", "legacy-default"]},
        "review_mode": {"enum": ["machine-only", "llm"]},
        "reasoning_effort": {"enum": ["none", "high", "xhigh"]},
        "milestone_audit": {"type": "boolean"},
        "critical_boundary": {"type": "boolean"},
        "live_admission": {"type": "boolean"},
        "final_certification": {"type": "boolean"}
      }
    },
    "complexity_guard": {
      "type": "object",
      "required": [
        "added_production_loc",
        "limit",
        "new_authority_or_wire_protocol",
        "repeated_defect_class",
        "published_investigation_authorization",
        "stop_required",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "added_production_loc": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 300, "maximum": 500},
        "new_authority_or_wire_protocol": {"type": "boolean"},
        "repeated_defect_class": {"type": "boolean"},
        "published_investigation_authorization": {
          "type": "object",
          "required": ["status", "detail"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["not-declared", "valid", "invalid"]},
            "detail": {"type": "string", "minLength": 1},
            "reference": {
              "type": "object",
              "required": ["authorization_card", "authorization_id"],
              "additionalProperties": false,
              "properties": {
                "authorization_card": {"type": "string", "minLength": 1},
                "authorization_id": {"type": "string", "minLength": 1}
              }
            },
            "authorization": {
              "type": "object",
              "required": [
                "investigation_card",
                "investigation_id",
                "successor_card",
                "successor_id",
                "production_loc_ceiling",
                "allow_new_authority_or_wire_protocol"
              ],
              "additionalProperties": false,
              "properties": {
                "investigation_card": {"type": "string", "minLength": 1},
                "investigation_id": {"type": "string", "minLength": 1},
                "successor_card": {"type": "string", "minLength": 1},
                "successor_id": {"type": "string", "minLength": 1},
                "production_loc_ceiling": {"type": "integer", "minimum": 301, "maximum": 500},
                "allow_new_authority_or_wire_protocol": {"type": "boolean"}
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {"status": {"const": "valid"}},
                "required": ["status"]
              },
              "then": {"required": ["reference", "authorization"]}
            }
          ]
        },
        "stop_required": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "detail"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "status": {"enum": ["pass", "fail", "skipped"]},
          "detail": {"type": "string", "minLength": 1},
          "command": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "llm_review": {
      "type": "object",
      "required": ["required", "reason"],
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["fingerprint", "preflight_timings"],
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "type": "object",
          "required": ["cache", "tree_builder", "timings"],
          "additionalProperties": false,
          "properties": {
            "cache": {
              "type": "object",
              "required": ["schema", "status", "path"],
              "additionalProperties": false,
              "properties": {
                "schema": {"const": "changerail.review-fingerprint-cache.v1"},
                "status": {"enum": ["disabled", "miss", "stale", "malformed", "hit", "write-failed"]},
                "path": {"type": "string", "minLength": 1}
              }
            },
            "tree_builder": {
              "type": "object",
              "required": ["mode", "changed_path_count", "full_index_refresh"],
              "additionalProperties": false,
              "properties": {
                "mode": {"enum": ["optimized", "reference", "fallback", "cache"]},
                "changed_path_count": {"type": ["integer", "null"], "minimum": 0},
                "full_index_refresh": {"type": "boolean"},
                "reason": {"type": "string"}
              }
            },
            "timings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["phase", "duration_ms"],
                "additionalProperties": false,
                "properties": {
                  "phase": {"type": "string", "minLength": 1},
                  "duration_ms": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        },
        "preflight_timings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase", "duration_ms"],
            "additionalProperties": false,
            "properties": {
              "phase": {"type": "string", "minLength": 1},
              "duration_ms": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
