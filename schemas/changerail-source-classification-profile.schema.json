{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-source-classification-profile.schema.json",
  "title": "ChangeRail source classification profile",
  "type": "object",
  "required": ["schema", "id", "version", "classification", "detection"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "changerail.source-classification-profile.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "description": {"type": "string", "minLength": 1},
    "classification": {
      "type": "object",
      "required": ["source_kinds"],
      "additionalProperties": false,
      "properties": {
        "source_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceKind"}
        },
        "non_production_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryRelativePath"}
        }
      }
    },
    "detection": {
      "type": "object",
      "required": ["signals"],
      "additionalProperties": false,
      "properties": {
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "path_glob", "weight"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
              "path_glob": {"$ref": "#/$defs/repositoryRelativeGlob"},
              "weight": {"type": "integer", "minimum": 1, "maximum": 100},
              "required": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceKind": {
      "type": "object",
      "required": ["id", "suffixes", "production_roots", "measure"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "suffixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9.+_-]*$"}
        },
        "production_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryRelativePath"}
        },
        "measure": {"enum": ["lines", "xml-structure"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "\\\\"},
          {"pattern": "(^|/)\\.\\.(?:/|$)"},
          {"pattern": "(^|/)\\.(?:/|$)"},
          {"const": "."}
        ]
      }
    },
    "repositoryRelativeGlob": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "\\\\"},
          {"pattern": "(^|/)\\.\\.(?:/|$)"},
          {"pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:"},
          {"pattern": "\\$\\("},
          {"pattern": "`"},
          {"const": "."}
        ]
      }
    }
  }
}
