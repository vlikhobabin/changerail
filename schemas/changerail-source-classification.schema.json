{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-source-classification.schema.json",
  "title": "ChangeRail source classification",
  "type": "object",
  "required": ["schema", "source_kinds"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "changerail.source-classification.v1"},
    "profile_provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version", "checksum", "source_kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
          "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "source_kind": {"enum": ["built-in", "local-integration"]},
          "declared_override_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/overridePath"}
          }
        }
      }
    },
    "source_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "suffixes", "production_roots", "measure"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "suffixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9][A-Za-z0-9.+_-]*$"}
          },
          "production_roots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/repositoryRelativePath"}
          },
          "measure": {"enum": ["lines", "xml-structure"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "non_production_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryRelativePath"}
    }
  },
  "$defs": {
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "\\\\"},
          {"pattern": "(^|/)\\.\\.(?:/|$)"},
          {"pattern": "(^|/)\\.(?:/|$)"},
          {"const": "."}
        ]
      }
    },
    "overridePath": {
      "type": "string",
      "pattern": "^(?:non_production_roots|source_kinds\\.[a-z0-9][a-z0-9-]*\\.(?:suffixes|production_roots|measure|description))$"
    }
  }
}
