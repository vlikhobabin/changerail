{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-verification-coverage-plan.schema.json",
  "title": "ChangeRail verification coverage plan reference",
  "type": "object",
  "required": ["schema", "generated_at", "map", "card", "change", "selected_coverage"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "changerail.verification-coverage-plan.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "map": {
      "type": "object",
      "required": ["path", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "path", "acceptance_hashes"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"$ref": "#/$defs/repositoryRelativePath"},
        "acceptance_hashes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "hash"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
              "hash": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "change": {
      "type": "object",
      "required": ["slug", "path"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "path": {"$ref": "#/$defs/repositoryRelativePath"}
      }
    },
    "selected_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "\\\\"},
          {"pattern": "(^|/)\\.\\.(?:/|$)"},
          {"pattern": "(^|/)\\.(?:/|$)"},
          {"const": "."}
        ]
      }
    }
  }
}
