{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changerail.local/schemas/changerail-verification-coverage.schema.json",
  "title": "ChangeRail verification coverage map",
  "type": "object",
  "required": ["schema", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "changerail.verification-coverage.v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coverageEntry"}
    }
  },
  "$defs": {
    "coverageEntry": {
      "type": "object",
      "required": ["id", "applies_to", "invariant", "oracle", "required_evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "applies_to": {"$ref": "#/$defs/applicability"},
        "invariant": {"type": "string", "minLength": 1, "maxLength": 1000},
        "oracle": {"$ref": "#/$defs/oracle"},
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/requiredEvidence"}
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["path_globs"]},
        {"required": ["operation_kinds"]},
        {"required": ["surface_kinds"]}
      ],
      "properties": {
        "path_globs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryRelativeGlob"}
        },
        "operation_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["add", "modify", "delete", "rename", "unknown"]}
        },
        "surface_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/namespacedSurfaceKind"}
        }
      }
    },
    "oracle": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["command", "test", "lint", "typecheck", "runtime", "manual", "schema", "smoke"]},
        "ref": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"}
      }
    },
    "requiredEvidence": {
      "type": "object",
      "required": ["kind", "oracle_ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["command", "test", "lint", "typecheck", "runtime", "manual", "schema", "smoke"]},
        "oracle_ref": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]*$"}
      }
    },
    "namespacedSurfaceKind": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "repositoryRelativeGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "not": {
        "anyOf": [
          {"pattern": "^/"},
          {"pattern": "\\\\"},
          {"pattern": "(^|/)\\.\\.(?:/|$)"},
          {"pattern": "(^|/)\\.(?:/|$)"},
          {"pattern": "^~"},
          {"const": "."}
        ]
      }
    }
  }
}
